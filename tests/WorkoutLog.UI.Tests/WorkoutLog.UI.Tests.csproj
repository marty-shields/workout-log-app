<Project Sdk="Microsoft.NET.Sdk.Razor">

  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WorkoutLog.UI\WorkoutLog.UI.csproj" />
    <ProjectReference Include="..\..\src\WorkoutLog.UI.Stories\WorkoutLog.UI.Stories.csproj" />
  </ItemGroup>

  <!-- The kit's design checks come from NuGet; -p:UseKitSource=true builds against the kit's source at KitPath instead. -->
  <ItemGroup Condition="'$(UseKitSource)' != 'true'">
    <PackageReference Include="Shields.UI.Testing" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseKitSource)' == 'true'">
    <ProjectReference Include="$(KitSourcePath)/src/Shields.UI.Testing/Shields.UI.Testing.csproj" />
  </ItemGroup>

  <!-- The App's start-up wiring with no Android types, compiled here because the App itself can't be referenced. -->
  <ItemGroup>
    <Compile Include="..\..\src\WorkoutLog.App\Lifecycle\AndroidAppLifecycle.cs" Link="Lifecycle\AndroidAppLifecycle.cs" />
    <Compile Include="..\..\src\WorkoutLog.App\Navigation\BackButtonLink.cs" Link="Navigation\BackButtonLink.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bunit" />
  </ItemGroup>

</Project>
