<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>$(NetVersion)-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>WorkoutLog.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <SupportedOSPlatformVersion>36.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</RuntimeIdentifiers>

    <ApplicationTitle>Workout Log</ApplicationTitle>
    <ApplicationId>uk.martinshields.workoutlog</ApplicationId>
    <AndroidManifestPlaceholders>allowBackup=true;dataExtractionRules=backup_rules</AndroidManifestPlaceholders>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <ApplicationTitle>Workout Log (Dev)</ApplicationTitle>
    <ApplicationId>uk.martinshields.workoutlog.debug</ApplicationId>
    <AndroidManifestPlaceholders>allowBackup=false;dataExtractionRules=no_backup</AndroidManifestPlaceholders>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#173535" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#f4f8f8" BaseSize="108,108" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkoutLog.Core\WorkoutLog.Core.csproj" />
    <ProjectReference Include="..\WorkoutLog.UI\WorkoutLog.UI.csproj" />
  </ItemGroup>

</Project>
