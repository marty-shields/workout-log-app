<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>WorkoutLog.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <SupportedOSPlatformVersion>36.0</SupportedOSPlatformVersion>
    <MauiVersion>10.0.120</MauiVersion>

    <ApplicationTitle>Workout Log</ApplicationTitle>
    <ApplicationId>uk.martinshields.workoutlog</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <ApplicationTitle>Workout Log (Dev)</ApplicationTitle>
    <ApplicationId>uk.martinshields.workoutlog.debug</ApplicationId>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#305252" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#305252" BaseSize="108,108" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkoutLog.Core\WorkoutLog.Core.csproj" />
    <ProjectReference Include="..\WorkoutLog.UI\WorkoutLog.UI.csproj" />
  </ItemGroup>

</Project>
