@page "/"
@using WorkoutLog.UI.Screens
@inject NavigationManager Navigation

@* Back has no handler here, so it leaves the app. *@
<ThisWeekPage OnNewWorkout="@(() => Navigation.GoTo("workout/new"))"
              OnNavigate="@(destination => Navigation.GoTo(destination))"
              OnSettings="@(() => Navigation.GoTo("settings"))"
              OnOpenWorkout="@(id => Navigation.GoTo($"workout/{id}?from=dashboard"))"
              OnOpenExercise="@(id => Navigation.GoTo($"exercises/{id}?from=dashboard"))" />
