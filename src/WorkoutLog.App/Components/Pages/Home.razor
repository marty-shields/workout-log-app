@page "/"
@using WorkoutLog.UI.Screens
@inject NavigationManager Navigation

@* Back has no handler here, so it leaves the app. *@
<DashboardPage OnNewWorkout="@(() => Navigation.GoTo("workout/new"))"
               OnWorkouts="@(() => Navigation.GoTo("workouts"))"
               OnExercises="@(() => Navigation.GoTo("exercises"))"
               OnSettings="@(() => Navigation.GoTo("settings"))"
               OnOpenWorkout="@(id => Navigation.GoTo($"dashboard/workout/{id}"))"
               OnOpenExercise="@(id => Navigation.GoTo($"exercises/{id}?from=dashboard"))" />
