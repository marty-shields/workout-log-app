@page "/"
@using WorkoutLog.UI.Navigation
@using WorkoutLog.UI.Screens
@inject NavigationManager Navigation

@* Back has no handler here, so it leaves the app. *@
<ThisWeekPage OnNew="@(() => Navigation.GoTo(Origin.Link("workout/new", Origin.ThisWeek)))"
              OnNavigate="@(tab => Navigation.GoTo(tab))"
              OnSettings="@(() => Navigation.GoTo("settings"))"
              OnOpenWorkout="@(id => Navigation.GoTo(Origin.Link($"workout/{id}", Origin.ThisWeek)))"
              OnOpenExercise="@(id => Navigation.GoTo(Origin.Link($"exercises/{id}", Origin.ThisWeek)))"
              OnOpenLastWeek="@(week => Navigation.GoTo(TrendsRoute.To(week)))" />
