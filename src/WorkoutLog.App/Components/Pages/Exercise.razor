@page "/exercises/{Id:int}"
@using WorkoutLog.UI.Navigation
@using WorkoutLog.UI.Screens
@inject NavigationManager Navigation

<ExercisePage ExerciseId="Id" OnBack="@(() => Navigation.GoTo(Origin.Route(From)))" />

@code {
    [Parameter] public int Id { get; set; }

    /// <summary>"this-week" or "trends:" and the period (month:2026-11-01) it was opened from: back returns there. This week when missing.</summary>
    [SupplyParameterFromQuery] public string? From { get; set; }
}
