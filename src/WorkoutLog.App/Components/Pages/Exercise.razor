@page "/exercises/{Id:int}"
@using WorkoutLog.UI.Navigation
@using WorkoutLog.UI.Screens
@inject NavigationManager Navigation

<ExercisePage ExerciseId="Id" OnBack="@(() => Navigation.GoTo(Origin.Route(From, "exercises")))" />

@code {
    [Parameter] public int Id { get; set; }

    /// <summary>"dashboard" when opened from This week, or "trends:" and a week's Monday (2026-11-09) from Trends: back returns there instead of to Exercises.</summary>
    [SupplyParameterFromQuery] public string? From { get; set; }
}
