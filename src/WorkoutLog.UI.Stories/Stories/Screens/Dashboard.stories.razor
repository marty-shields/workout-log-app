                </LastWorkout>
                <Consistency>
                    <ConsistencyCard ThisWeek="SampleDashboard.NoWeek" LastWeek="SampleDashboard.NoWeek" WeekCounts="SampleDashboard.EmptyWeeks" OnMuscles="() => { }" TestId="consistency" />
                </Consistency>
                <RecentRecords>
                    <RecentRecordsCard Records="[]" OnOpen="(int _) => { }" TestId="recent-records" />
                </RecentRecords>
