@attribute [Stories("Screens/Dashboard")]

<Stories TComponent="DashboardView" Layout="typeof(PhoneLayout)">

    <Story Name="With workouts">
        <Template>
            <DashboardView OnNewWorkout="() => { }" OnWorkouts="() => { }" OnExercises="() => { }" OnSettings="() => { }">
                <LastWorkout>
                    <LastWorkoutCard Workout="SampleDashboard.LastWorkout" OnOpen="() => { }" TestId="last-workout" />
                </LastWorkout>
                <Consistency>
                    <ConsistencyCard ThisWeek="SampleDashboard.ThisWeek" LastWeek="SampleDashboard.LastWeek" WeekCounts="SampleDashboard.WeekCounts" Streak="6" OnMuscles="() => { }" TestId="consistency" />
                </Consistency>
                <RecentRecords>
                    <RecentRecordsCard Records="SampleDashboard.Records" OnOpen="(int _) => { }" TestId="recent-records" />
                </RecentRecords>
            </DashboardView>
        </Template>
    </Story>

