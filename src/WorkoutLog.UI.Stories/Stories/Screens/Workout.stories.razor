@attribute [Stories("Screens/Workout")]

<Stories TComponent="WorkoutView" Layout="typeof(PhoneLayout)">

    <Story Name="New - empty">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="TimeSpan.FromSeconds(42)" Exercises="[]" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="New - strength sets">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="new TimeSpan(0, 34, 12)" Exercises="SampleData.StrengthWorkout()" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="New - cardio entries">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="new TimeSpan(1, 2, 5)" Exercises="SampleData.CardioWorkout()" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="New - save errors">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="new TimeSpan(0, 21, 40)" Exercises="SampleData.WorkoutWithErrors()" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="New - save with no exercises">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="TimeSpan.FromSeconds(42)" Exercises="[]" Error="Add at least one exercise" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="New - discard prompt">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="new TimeSpan(0, 34, 12)" Exercises="SampleData.StrengthWorkout()" OnBack="() => { }">
                <Overlay>
                    <ConfirmDialog Title="Discard this workout?" ConfirmText="Discard" Danger />
                </Overlay>
            </WorkoutView>
        </Template>
    </Story>

    <Story Name="Picker - no search text">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="new TimeSpan(0, 34, 12)" Exercises="SampleData.StrengthWorkout()" OnBack="() => { }">
                <Overlay>
                    <ExercisePicker Items="SampleData.Search(null)" />
                </Overlay>
            </WorkoutView>
        </Template>
    </Story>

    <Story Name="Picker - results">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="new TimeSpan(0, 34, 12)" Exercises="SampleData.StrengthWorkout()" OnBack="() => { }">
                <Overlay>
                    <ExercisePicker Query="dumbbell" Items="@SampleData.Search("dumbbell")" />
                </Overlay>
            </WorkoutView>
        </Template>
    </Story>

    <Story Name="Edit">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(1, 4, 37)" Exercises="SampleData.StrengthWorkout()" OnBack="() => { }" OnDelete="() => { }" />
        </Template>
    </Story>

    <Story Name="Edit - discard changes prompt">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(1, 4, 37)" Exercises="SampleData.StrengthWorkout()" OnBack="() => { }" OnDelete="() => { }">
                <Overlay>
                    <ConfirmDialog Title="Discard your changes?" ConfirmText="Discard changes" Danger />
                </Overlay>
            </WorkoutView>
        </Template>
    </Story>

    <Story Name="Edit - delete prompt">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(1, 4, 37)" Exercises="SampleData.StrengthWorkout()" OnBack="() => { }" OnDelete="() => { }">
                <Overlay>
                    <ConfirmDialog Title="Delete this workout?" ConfirmText="Delete" Danger />
                </Overlay>
            </WorkoutView>
        </Template>
    </Story>

</Stories>
