@attribute [Stories("Screens/New Workout")]
@inject IExerciseCatalog Catalog
@inject IWorkoutChecker Checker

<Stories TComponent="WorkoutView" Layout="typeof(PhoneLayout)">

    <Story Name="Empty">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="TimeSpan.FromSeconds(42)" Exercises="[]" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="Strength">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="new TimeSpan(0, 34, 12)" Exercises="SampleData.StrengthWorkoutWithWeights(Catalog)" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="Carry">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="new TimeSpan(0, 28, 3)" Exercises="SampleData.CarryWorkout(Catalog)" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="Cardio">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="new TimeSpan(1, 2, 5)" Exercises="SampleData.CardioWorkout(Catalog)" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="Records">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="new TimeSpan(0, 52, 18)" Exercises="SampleData.RecordsWorkout(Catalog)" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="Exercises full">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="new TimeSpan(1, 12, 30)" Exercises="SampleData.FullWorkout(Catalog)" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="Save errors">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="new TimeSpan(0, 21, 40)" Exercises="SampleData.WorkoutWithErrors(Catalog, Checker)" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="No exercises error">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="TimeSpan.FromSeconds(42)" Exercises="[]" Error="@Checker.Check([]).Error" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="Save failed">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="new TimeSpan(0, 34, 12)" Exercises="SampleData.StrengthWorkout(Catalog)" Error="@Checker.SaveFailed" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="Discard prompt">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="new TimeSpan(0, 34, 12)" Exercises="SampleData.StrengthWorkout(Catalog)" OnBack="() => { }">
                <Overlay>
                    <ConfirmDialog Title="Discard this workout?" ConfirmText="Discard" Danger />
                </Overlay>
            </WorkoutView>
        </Template>
    </Story>

</Stories>
