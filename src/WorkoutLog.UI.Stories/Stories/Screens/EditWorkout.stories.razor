@attribute [Stories("Screens/Edit Workout")]
@inject IExerciseCatalog Catalog
@inject IWorkoutChecker Checker

<Stories TComponent="WorkoutView" Layout="typeof(PhoneLayout)">

    <Story Name="Loaded">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(1, 4, 37)" Exercises="SampleData.Loaded(SampleData.StrengthWorkout(Catalog))" OnBack="() => { }" OnDelete="() => { }" />
        </Template>
    </Story>

    <Story Name="Strength">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(1, 4, 37)" Exercises="SampleData.Opened(SampleData.StrengthWorkout(Catalog))" OnBack="() => { }" OnDelete="() => { }" />
        </Template>
    </Story>

    <Story Name="Carry">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(0, 52, 10)" Exercises="SampleData.Opened(SampleData.CarryWorkout(Catalog))" OnBack="() => { }" OnDelete="() => { }" />
        </Template>
    </Story>

    <Story Name="Cardio">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(1, 2, 5)" Exercises="SampleData.Opened(SampleData.CardioWorkout(Catalog))" OnBack="() => { }" OnDelete="() => { }" />
        </Template>
    </Story>

    <Story Name="Last time">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(1, 4, 37)" Exercises="SampleData.MarkDone(SampleData.LastTimeWorkout(Catalog), 1, 2, 3, 4, 6)" OnBack="() => { }" OnDelete="() => { }" />
        </Template>
    </Story>

    <Story Name="Save errors">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(0, 52, 10)" Exercises="SampleData.EditWorkoutWithErrors(Catalog, Checker)" OnBack="() => { }" OnDelete="() => { }" />
        </Template>
    </Story>

    <Story Name="Save failed">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(1, 4, 37)" Exercises="SampleData.Opened(SampleData.StrengthWorkout(Catalog))" Error="@Checker.SaveFailed" OnBack="() => { }" OnDelete="() => { }" />
        </Template>
    </Story>

    <Story Name="Delete exercise prompt">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(1, 4, 37)" Exercises="SampleData.Loaded(SampleData.StrengthWorkout(Catalog))" OnBack="() => { }" OnDelete="() => { }">
                <Overlay>
                    <ConfirmDialog Title="Delete Farmer's Walk?" ConfirmText="Delete" Danger />
                </Overlay>
            </WorkoutView>
        </Template>
    </Story>

    <Story Name="Discard prompt">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(1, 4, 37)" Exercises="SampleData.Opened(SampleData.StrengthWorkout(Catalog))" OnBack="() => { }" OnDelete="() => { }">
                <Overlay>
                    <ConfirmDialog Title="Discard changes?" ConfirmText="Discard" Danger />
                </Overlay>
            </WorkoutView>
        </Template>
    </Story>

    <Story Name="Delete prompt">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(1, 4, 37)" Exercises="SampleData.Opened(SampleData.StrengthWorkout(Catalog))" OnBack="() => { }" OnDelete="() => { }">
                <Overlay>
                    <ConfirmDialog Title="Delete this workout?" ConfirmText="Delete" Danger />
                </Overlay>
            </WorkoutView>
        </Template>
    </Story>

    <Story Name="Delete failed">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(1, 4, 37)" Exercises="SampleData.Opened(SampleData.StrengthWorkout(Catalog))" Error="@Checker.DeleteFailed" OnBack="() => { }" OnDelete="() => { }" />
        </Template>
    </Story>

    <Story Name="Loading">
        <Template>
            <WorkoutLoadView OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="Load failed">
        <Template>
            <WorkoutLoadView Failed OnRetry="() => { }" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="Not found">
        <Template>
            <WorkoutLoadView NotFound OnBack="() => { }" />
        </Template>
    </Story>

</Stories>
