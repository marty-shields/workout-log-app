        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(1, 2, 5)" Exercises="SampleData.CardioWorkout(Catalog)" OnBack="() => { }" OnDelete="() => { }" />
        </Template>
    </Story>

