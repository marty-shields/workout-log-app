@attribute [Stories("Screens/Edit Workout")]

<Stories TComponent="WorkoutView" Layout="typeof(PhoneLayout)">

    <Story Name="Saved">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(1, 4, 37)" Exercises="SampleData.StrengthWorkout()" OnBack="() => { }" OnDelete="() => { }" />
        </Template>
    </Story>

    <Story Name="Carry sets closed">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(0, 52, 10)" Exercises="SampleData.CarryWorkout()" OnBack="() => { }" OnDelete="() => { }" />
        </Template>
    </Story>

    <Story Name="Save errors">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(0, 52, 10)" Exercises="SampleData.EditWorkoutWithErrors()" OnBack="() => { }" OnDelete="() => { }" />
        </Template>
    </Story>

    <Story Name="Discard prompt">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(1, 4, 37)" Exercises="SampleData.StrengthWorkout()" OnBack="() => { }" OnDelete="() => { }">
                <Overlay>
                    <ConfirmDialog Title="Discard changes?" ConfirmText="Discard" Danger />
                </Overlay>
            </WorkoutView>
        </Template>
    </Story>

    <Story Name="Delete prompt">
        <Template>
            <WorkoutView Mode="WorkoutMode.Edit" StartedAt="SampleData.Started" Time="new TimeSpan(1, 4, 37)" Exercises="SampleData.StrengthWorkout()" OnBack="() => { }" OnDelete="() => { }">
                <Overlay>
                    <ConfirmDialog Title="Delete this workout?" ConfirmText="Delete" Danger />
                </Overlay>
            </WorkoutView>
        </Template>
    </Story>

</Stories>
