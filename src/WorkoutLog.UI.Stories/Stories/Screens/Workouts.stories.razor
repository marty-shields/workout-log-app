@using WorkoutLog.UI.Models.Workouts
@attribute [Stories("Screens/Workouts")]

<Stories TComponent="WorkoutsView" Layout="typeof(PhoneLayout)">

    <Story Name="Empty">
        <Template>
            <WorkoutsView Rows="[]" OnOpen="(WorkoutsRow _) => { }" />
        </Template>
    </Story>

    <Story Name="With workouts">
        <Template>
            <WorkoutsView Rows="SampleData.WorkoutsRows" OnOpen="(WorkoutsRow _) => { }" />
        </Template>
    </Story>

    <Story Name="Loading">
        <Template>
            <WorkoutsView Rows="[]" Loading OnOpen="(WorkoutsRow _) => { }" />
        </Template>
    </Story>

    <Story Name="Load failed">
        <Template>
            <WorkoutsView Rows="[]" Failed OnRetry="() => { }" OnOpen="(WorkoutsRow _) => { }" />
        </Template>
    </Story>

</Stories>
