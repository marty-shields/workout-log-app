@using WorkoutLog.UI.Models.History
@attribute [Stories("Screens/History")]

<Stories TComponent="HistoryView" Layout="typeof(PhoneLayout)">

    <Story Name="Empty">
        <Template>
            <HistoryView Rows="[]" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="With workouts">
        <Template>
            <HistoryView Rows="SampleData.HistoryRows" OnBack="() => { }" OnOpen="(HistoryRow _) => { }" />
        </Template>
    </Story>

    <Story Name="Rows not tappable">
        <Template>
            <HistoryView Rows="SampleData.HistoryRows" OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="Loading">
        <Template>
            <HistoryView Rows="[]" Loading OnBack="() => { }" />
        </Template>
    </Story>

    <Story Name="Load failed">
        <Template>
            <HistoryView Rows="[]" Failed OnRetry="() => { }" OnBack="() => { }" />
        </Template>
    </Story>

</Stories>
