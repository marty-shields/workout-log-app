@attribute [Stories("Screens/Exercise Picker")]
@inject IExerciseCatalog Catalog

<Stories TComponent="ExercisePicker" Layout="typeof(PhoneLayout)">

    <Story Name="No search text">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="new TimeSpan(0, 34, 12)" Exercises="SampleData.StrengthWorkout(Catalog)" OnBack="() => { }">
                <Overlay>
                    <ExercisePicker Items="SampleData.PickerItems(Catalog, null)" />
                </Overlay>
            </WorkoutView>
        </Template>
    </Story>

    <Story Name="Results">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="new TimeSpan(0, 34, 12)" Exercises="SampleData.StrengthWorkout(Catalog)" OnBack="() => { }">
                <Overlay>
                    <ExercisePicker Query="dumbbell" Items="@SampleData.PickerItems(Catalog, "dumbbell")" />
                </Overlay>
            </WorkoutView>
        </Template>
    </Story>

    <Story Name="No match">
        <Template>
            <WorkoutView Mode="WorkoutMode.New" StartedAt="SampleData.Started" Time="new TimeSpan(0, 34, 12)" Exercises="SampleData.StrengthWorkout(Catalog)" OnBack="() => { }">
                <Overlay>
                    <ExercisePicker Query="zumba" Items="@SampleData.PickerItems(Catalog, "zumba")" />
                </Overlay>
            </WorkoutView>
        </Template>
    </Story>

</Stories>
