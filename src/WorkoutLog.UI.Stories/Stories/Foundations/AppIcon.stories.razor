@attribute [Stories("Foundations/App Icon")]

<Stories TComponent="AppIconSheet">

    <Story Name="Icon and splash">
        <Template>
            <AppIconSheet Background="@Art("appicon.svg")"
                          Foreground="@Art("appiconfg.svg")"
                          Monochrome="@Art("appicon_monochrome.svg")"
                          SplashLight="@Art("splash.svg")"
                          SplashDark="@Art("appiconfg.svg")" />
        </Template>
    </Story>

</Stories>

@code {
    // The App's SVG, embedded by this project, as a data URI. The dark splash shows the icon's foreground, whose shadow suits a dark background.
    private static string Art(string file)
    {
        using var stream = typeof(App).Assembly.GetManifestResourceStream($"brand.{file}")!;
        using var memory = new MemoryStream();
        stream.CopyTo(memory);
        return $"data:image/svg+xml;base64,{Convert.ToBase64String(memory.ToArray())}";
    }
}
