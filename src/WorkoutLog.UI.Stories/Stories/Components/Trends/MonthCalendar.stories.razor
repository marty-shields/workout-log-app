@attribute [Stories("Components/Trends/MonthCalendar")]

<Stories TComponent="MonthCalendar" Layout="typeof(ThemeLayout)">

    <Story Name="Part-way through">
        <Template>
            <MonthCalendar Month="new DateOnly(2026, 11, 1)" Today="SampleTrends.Today" Trained="SampleTrends.MonthTrainedDays" TestId="calendar" />
        </Template>
    </Story>

    <Story Name="Finished month">
        <Template>
            <MonthCalendar Month="new DateOnly(2026, 10, 1)" Today="SampleTrends.Today" Trained="SampleTrends.PastMonthTrainedDays" TestId="calendar" />
        </Template>
    </Story>

    <Story Name="Nothing trained">
        <Template>
            <MonthCalendar Month="new DateOnly(2026, 8, 1)" Today="SampleTrends.Today" Trained="[]" TestId="calendar" />
        </Template>
    </Story>

</Stories>
