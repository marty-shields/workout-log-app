@attribute [Stories(StoryTitles.Prefix + "/Components/Trends/TrendBars")]

<Stories TComponent="TrendBars" Layout="typeof(ThemeLayout)">

    <Story Name="Paired days">
        <Template>
            <TrendBars Bars="SampleTrends.WeekDays" NowLabel="This week" EarlierLabel="Last week"
                       Max="90" AriaLabel="Time trained each day this week beside the same day last week" EmptyText="No workouts this week" TestId="bars" />
        </Template>
    </Story>

    <Story Name="Months">
        <Template>
            <TrendBars Bars="SampleTrends.YearMonths"
                       AriaLabel="Workouts in each month of 2026" EmptyText="No workouts this year" TestId="bars" />
        </Template>
    </Story>

    <Story Name="Past year">
        <Template>
            <TrendBars Bars="SampleTrends.PastYearMonths"
                       AriaLabel="Workouts in each month of 2025" EmptyText="No workouts this year" TestId="bars" />
        </Template>
    </Story>

    <Story Name="Nothing to show">
        <Template>
            <TrendBars Bars="SampleTrends.EmptyYearMonths"
                       AriaLabel="Workouts in each month of 2024" EmptyText="No workouts this year" TestId="bars" />
        </Template>
    </Story>

</Stories>
