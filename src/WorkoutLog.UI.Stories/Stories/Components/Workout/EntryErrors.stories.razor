@attribute [Stories("Components/Workout/EntryErrors")]
@inject IExerciseCatalog Catalog
@inject IWorkoutChecker Checker

<Stories TComponent="EntryErrors" Layout="typeof(ThemeLayout)">

    <Story Name="One error">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 132, ["0", "12"]); Checker.Check([exercise]); }
            <EntryErrors Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

    <Story Name="Several errors">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 187, [null, "32", "0:00:75"]); Checker.Check([exercise]); }
            <EntryErrors Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

</Stories>
