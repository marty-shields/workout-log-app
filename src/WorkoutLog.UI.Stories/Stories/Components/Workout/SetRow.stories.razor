@attribute [Stories("Components/Workout/SetRow")]
@inject IExerciseCatalog Catalog
@inject IWorkoutChecker Checker

<Stories TComponent="SetRow" Layout="typeof(ThemeLayout)">

    <Story Name="Lift">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 132, ["12", "10"]); }
            <SetRow Number="1" Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

    <Story Name="Hold">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 258, ["0:01:00", null]); }
            <SetRow Number="1" Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

    <Story Name="Record">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 132, ["10", "14"]); }
            <SetRow Number="2" Fields="exercise.Fields" Entry="exercise.Entries[0]" IsRecord TestId="set-2" />
        </Template>
    </Story>

    <Story Name="Errors">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 132, [null, "10"]); Checker.Check([exercise]); }
            <SetRow Number="2" Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

    <Story Name="Format errors">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 132, ["8.5", "12.255"]); Checker.Check([exercise]); }
            <SetRow Number="2" Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

    <Story Name="Not a number">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 132, ["8.", "22,75"]); Checker.Check([exercise]); }
            <SetRow Number="2" Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

</Stories>
