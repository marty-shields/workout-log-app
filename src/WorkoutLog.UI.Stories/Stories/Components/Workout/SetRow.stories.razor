@attribute [Stories("Components/Workout/SetRow")]
@inject IExerciseCatalog Catalog
@inject IWorkoutChecker Checker

<Stories TComponent="SetRow" Layout="typeof(ThemeLayout)">

    <Story Name="Lift">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 132, ["10", "12"]); }
            <SetRow Number="1" Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

    <Story Name="Hold">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 258, ["0:01:00", null]); }
            <SetRow Number="1" Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

    <Story Name="Errors">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 132, ["10", null]); Checker.Check([exercise]); }
            <SetRow Number="2" Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

    <Story Name="Format errors">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 132, ["12.255", "8.5"]); Checker.Check([exercise]); }
            <SetRow Number="2" Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

    <Story Name="Not a number">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 132, ["22,75", "8."]); Checker.Check([exercise]); }
            <SetRow Number="2" Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

</Stories>
