@attribute [Stories("Components/Workout/SetSummary")]
@inject IExerciseCatalog Catalog
@inject IWorkoutChecker Checker

<Stories TComponent="SetSummary" Layout="typeof(ThemeLayout)">

    <Story Name="Filled">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 187, ["40", "32", "0:00:45"]); }
            <SetSummary Number="1" Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

    <Story Name="Empty">
        <Template>
            @{ var exercise = SampleData.NewExercise(Catalog, 187); }
            <SetSummary Number="2" Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

    <Story Name="Errors">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 187, [null, "32", "0:00:75"]); Checker.Check([exercise]); }
            <SetSummary Number="1" Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

</Stories>
