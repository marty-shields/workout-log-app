@attribute [Stories("Components/Workout/SetPanel")]
@inject IExerciseCatalog Catalog
@inject ISetChecker Checker

<Stories TComponent="SetPanel" Layout="typeof(ThemeLayout)">

    <Story Name="Carry">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 187, ["40", "32", null]); }
            <SetPanel Number="3" Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

    <Story Name="Errors">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 187, [null, "32", "0:00:75"]); SampleData.Validate(Checker, [exercise], out _); }
            <SetPanel Number="1" Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

    <Story Name="Format errors">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 187, ["40.125", "32", "0:1.:00"]); SampleData.Validate(Checker, [exercise], out _); }
            <SetPanel Number="1" Fields="exercise.Fields" Entry="exercise.Entries[0]" />
        </Template>
    </Story>

</Stories>
