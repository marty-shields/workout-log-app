@attribute [Stories("Components/Workout/ExerciseCard")]
@inject IExerciseCatalog Catalog
@inject IWorkoutChecker Checker

<Stories TComponent="ExerciseCard" Layout="typeof(ThemeLayout)">

    <Story Name="Strength">
        <Template>
            <ExerciseCard Exercise="@SampleData.Exercise(Catalog, 6, ["8", "60"], ["8", "60"], ["6", "62.5"])" />
        </Template>
    </Story>

    <Story Name="Assisted">
        <Template>
            <ExerciseCard Exercise="@SampleData.Exercise(Catalog, 218, ["10", "25"])" />
        </Template>
    </Story>

    <Story Name="Hold">
        <Template>
            <ExerciseCard Exercise="@SampleData.Exercise(Catalog, 258, ["0:01:00", null])" />
        </Template>
    </Story>

    <Story Name="Carry - several sets">
        <Template>
            <ExerciseCard Exercise="@SampleData.Exercise(Catalog, 187, ["40", "32", "0:00:45"], ["40", "36", "0:00:50"], ["30", "40", null])" />
        </Template>
    </Story>

    <Story Name="Carry - errors">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 187, [null, "32", "0:00:75"], ["40", "36", "0:00:50"], ["30", null, "0:00:00"]); Checker.Check([exercise]); }
            <ExerciseCard Exercise="exercise" />
        </Template>
    </Story>

    <Story Name="New strength">
        <Template>
            <ExerciseCard Exercise="@SampleData.NewExercise(Catalog, 132)" />
        </Template>
    </Story>

    <Story Name="Cardio">
        <Template>
            <ExerciseCard Exercise="@SampleData.Exercise(Catalog, 300, ["0:20:00", "3.2", "1.5", "210", "9.6"])" />
        </Template>
    </Story>

    <Story Name="Cardio with pace">
        <Template>
            <ExerciseCard Exercise="@SampleData.Exercise(Catalog, 311, ["0:25:30", "5", null, "5:06"])" />
        </Template>
    </Story>

    <Story Name="Cardio with errors">
        <Template>
            @{ var exercise = SampleData.Exercise(Catalog, 305, [null, "2000", "5.5", "abc", "201"]); Checker.Check([exercise]); }
            <ExerciseCard Exercise="exercise" />
        </Template>
    </Story>

    <Story Name="Errors">
        <Template>
            <ExerciseCard Exercise="@SampleData.WorkoutWithErrors(Catalog, Checker)[0]" />
        </Template>
    </Story>

</Stories>
