@attribute [Stories("Components/Inputs/DurationField")]

<Stories TComponent="DurationField" Layout="typeof(ThemeLayout)">

    <Story Name="Duration">
        <Template>
            <DurationField Label="Duration" Required Value="0:20:00" />
        </Template>
    </Story>

    <Story Name="Empty">
        <Template>
            <DurationField Label="Duration" Required />
        </Template>
    </Story>

    <Story Name="Pace">
        <Template>
            <DurationField Label="Pace (min/km)" ShowHours="false" Value="5:30" />
        </Template>
    </Story>

    <Story Name="Invalid">
        <Template>
            <DurationField Label="Duration" Required Value="0:00:75" Invalid />
        </Template>
    </Story>

</Stories>
