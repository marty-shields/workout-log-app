@attribute [Stories("Components/Inputs/DurationField")]

<Stories TComponent="DurationField" Layout="typeof(ThemeLayout)">

    <Story Name="Duration">
        <Arguments>
            <Arg For="_ => _.Label" Value='"Duration"' />
            <Arg For="_ => _.Required" Value="true" />
            <Arg For="_ => _.Value" Value='"0:20:00"' />
        </Arguments>
        <Template>
            <DurationField @attributes="context.Args" />
        </Template>
    </Story>

    <Story Name="Empty">
        <Arguments>
            <Arg For="_ => _.Label" Value='"Duration"' />
            <Arg For="_ => _.Required" Value="true" />
        </Arguments>
        <Template>
            <DurationField @attributes="context.Args" />
        </Template>
    </Story>

    <Story Name="Pace">
        <Arguments>
            <Arg For="_ => _.Label" Value='"Pace (min/km)"' />
            <Arg For="_ => _.ShowHours" Value="false" />
            <Arg For="_ => _.Value" Value='"5:30"' />
        </Arguments>
        <Template>
            <DurationField @attributes="context.Args" />
        </Template>
    </Story>

    <Story Name="Invalid">
        <Arguments>
            <Arg For="_ => _.Label" Value='"Duration"' />
            <Arg For="_ => _.Required" Value="true" />
            <Arg For="_ => _.Value" Value='"0:00:75"' />
            <Arg For="_ => _.Invalid" Value="true" />
        </Arguments>
        <Template>
            <DurationField @attributes="context.Args" />
        </Template>
    </Story>

</Stories>
