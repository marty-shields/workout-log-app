@attribute [Stories("Components/Inputs/FilterChips")]

<Stories TComponent="FilterChips<AddExerciseFilter>" Layout="typeof(ThemeLayout)">

    <Story Name="All chosen">
        <Template>
            <FilterChips TValue="AddExerciseFilter" Label="Type" Options="Options" Value="AddExerciseFilter.All" ValueChanged="(AddExerciseFilter _) => { }" TestId="add-exercise-filter" />
        </Template>
    </Story>

    <Story Name="Strength chosen">
        <Template>
            <FilterChips TValue="AddExerciseFilter" Label="Type" Options="Options" Value="AddExerciseFilter.Strength" ValueChanged="(AddExerciseFilter _) => { }" TestId="add-exercise-filter" />
        </Template>
    </Story>

    <Story Name="Cardio chosen">
        <Template>
            <FilterChips TValue="AddExerciseFilter" Label="Type" Options="Options" Value="AddExerciseFilter.Cardio" ValueChanged="(AddExerciseFilter _) => { }" TestId="add-exercise-filter" />
        </Template>
    </Story>

</Stories>

@code {
    private static readonly IReadOnlyList<RadioOption<AddExerciseFilter>> Options =
    [
        new(AddExerciseFilter.All, "All", "add-exercise-filter-all"),
        new(AddExerciseFilter.Strength, "Strength", "add-exercise-filter-strength"),
        new(AddExerciseFilter.Cardio, "Cardio", "add-exercise-filter-cardio"),
    ];
}
