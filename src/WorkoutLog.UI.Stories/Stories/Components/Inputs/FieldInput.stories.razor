@using WorkoutLog.UI.Models.Fields
@attribute [Stories("Components/Inputs/FieldInput")]

<Stories TComponent="FieldInput">

    <Story Name="Whole">
        <Template>
            <FieldInput Field="@(new FieldSpec("reps", "Reps", FieldKind.Whole, Required: true))" Entry="new EntryState()" />
        </Template>
    </Story>

    <Story Name="Decimal">
        <Template>
            <FieldInput Field="@(new FieldSpec("weight", "Weight", FieldKind.Decimal, Unit: "kg"))" Entry="new EntryState()" />
        </Template>
    </Story>

    <Story Name="Duration">
        <Template>
            <FieldInput Field="@(new FieldSpec("duration", "Duration", FieldKind.Duration, Required: true))" Entry="new EntryState()" />
        </Template>
    </Story>

    <Story Name="Pace">
        <Template>
            <FieldInput Field="@(new FieldSpec("rate", "Pace", FieldKind.Pace, Unit: "min/km"))" Entry="new EntryState()" />
        </Template>
    </Story>

</Stories>
