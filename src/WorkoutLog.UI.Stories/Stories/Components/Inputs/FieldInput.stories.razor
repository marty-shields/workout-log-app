@using WorkoutLog.UI.Models.Fields
@attribute [Stories("Components/Inputs/FieldInput")]

<Stories TComponent="FieldInput" Layout="typeof(ThemeLayout)">

    <Story Name="Whole">
        <Template>
            <FieldInput Field="@(new FieldSpec("reps", Metric.Reps, "Reps", FieldKind.Whole, Required: true))" Entry="new EntryState()" />
        </Template>
    </Story>

    <Story Name="Decimal">
        <Template>
            <FieldInput Field="@(new FieldSpec("weight", Metric.WeightKg, "Weight", FieldKind.Decimal, Required: true, Unit: "kg"))" Entry="new EntryState()" />
        </Template>
    </Story>

    <Story Name="Duration">
        <Template>
            <FieldInput Field="@(new FieldSpec("duration", Metric.Duration, "Duration", FieldKind.Duration, Required: true))" Entry="new EntryState()" />
        </Template>
    </Story>

</Stories>
