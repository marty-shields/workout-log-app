@attribute [Stories("Components/Inputs/NumberField")]

<Stories TComponent="NumberField" Layout="typeof(ThemeLayout)">

    <Story Name="Whole number">
        <Arguments>
            <Arg For="_ => _.Label" Value='"Reps"' />
            <Arg For="_ => _.Required" Value="true" />
        </Arguments>
        <Template>
            <NumberField @attributes="context.Args" />
        </Template>
    </Story>

    <Story Name="Decimal">
        <Arguments>
            <Arg For="_ => _.Label" Value='"Weight (kg)"' />
            <Arg For="_ => _.AllowDecimal" Value="true" />
            <Arg For="_ => _.Value" Value='"22.75"' />
        </Arguments>
        <Template>
            <NumberField @attributes="context.Args" />
        </Template>
    </Story>

    <Story Name="Invalid">
        <Arguments>
            <Arg For="_ => _.Label" Value='"Reps"' />
            <Arg For="_ => _.Required" Value="true" />
            <Arg For="_ => _.Value" Value='"0"' />
            <Arg For="_ => _.Invalid" Value="true" />
        </Arguments>
        <Template>
            <NumberField @attributes="context.Args" />
        </Template>
    </Story>

</Stories>
