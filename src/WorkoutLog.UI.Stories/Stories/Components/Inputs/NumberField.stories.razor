@attribute [Stories("Components/Inputs/NumberField")]

<Stories TComponent="NumberField" Layout="typeof(ThemeLayout)">

    <Story Name="Whole">
        <Template>
            <NumberField Label="Reps" Required />
        </Template>
    </Story>

    <Story Name="Decimal">
        <Template>
            <NumberField Label="Weight (kg)" AllowDecimal Value="22.75" />
        </Template>
    </Story>

    <Story Name="Invalid">
        <Template>
            <NumberField Label="Reps" Required Value="0" Invalid />
        </Template>
    </Story>

</Stories>
