@using Shields.UI.Components.Feedback
@using WorkoutLog.UI.Components.Layout
@attribute [Stories("Components/Layout/AppScreen")]

<Stories TComponent="AppScreen" Layout="typeof(PhoneLayout)">

    <Story Name="Back and bottom bar">
        <Template>
            <AppScreen Title="Screen title" Subtitle="Subtitle" OnBack="() => { }">
                <ChildContent>
                    <p>Scrolling content.</p>
                </ChildContent>
                <BottomBar>
                    <AppButton FullWidth>Main action</AppButton>
                </BottomBar>
            </AppScreen>
        </Template>
    </Story>

    <Story Name="Top-level with bottom bar">
        <Template>
            <AppScreen Title="Screen title" Tab="MainTab.ThisWeek" OnNavigate="(MainTab _) => { }" OnNew="() => { }">
                <ChildContent>
                    <p>Scrolling content.</p>
                </ChildContent>
                <BottomBar>
                    <AppButton FullWidth>Main action</AppButton>
                </BottomBar>
            </AppScreen>
        </Template>
    </Story>

    <Story Name="Top-level">
        <Template>
            <AppScreen Title="Screen title" Tab="MainTab.Trends" OnNavigate="(MainTab _) => { }" OnNew="() => { }">
                <p>Scrolling content.</p>
            </AppScreen>
        </Template>
    </Story>

    <Story Name="Pulling">
        <Template>
            <AppScreen Title="Screen title" Tab="MainTab.Trends" OnNavigate="(MainTab _) => { }" OnNew="() => { }" OnRefresh="() => { }">
                <p>Scrolling content.</p>
                <HoldPull />
            </AppScreen>
        </Template>
    </Story>

    <Story Name="Snackbar">
        <Template>
            <AppScreen Title="Screen title" OnBack="() => { }">
                <ChildContent>
                    <p>Scrolling content.</p>
                </ChildContent>
                <BottomBar>
                    <AppButton FullWidth>Main action</AppButton>
                </BottomBar>
                <Status>
                    <Snackbar Message="Barbell Back Squat set 2 deleted" ActionLabel="Undo" OnAction="() => { }" />
                </Status>
            </AppScreen>
        </Template>
    </Story>

    <Story Name="Snackbar over the tab bar">
        <Template>
            <AppScreen Title="Screen title" Tab="MainTab.Trends" OnNavigate="(MainTab _) => { }" OnNew="() => { }">
                <ChildContent>
                    <p>Scrolling content.</p>
                </ChildContent>
                <Status>
                    <Snackbar Message="Barbell Back Squat set 2 deleted" ActionLabel="Undo" OnAction="() => { }" />
                </Status>
            </AppScreen>
        </Template>
    </Story>

    <Story Name="Title only">
        <Template>
            <AppScreen Title="Screen title">
                <p>Scrolling content.</p>
            </AppScreen>
        </Template>
    </Story>

</Stories>
