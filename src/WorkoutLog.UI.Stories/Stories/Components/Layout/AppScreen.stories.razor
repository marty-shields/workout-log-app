@using WorkoutLog.UI.Components.Feedback
@using WorkoutLog.UI.Components.Layout
@attribute [Stories("Components/Layout/AppScreen")]

<Stories TComponent="AppScreen" Layout="typeof(PhoneLayout)">

    <Story Name="Back and bottom bar">
        <Template>
            <AppScreen Title="Screen title" Subtitle="Subtitle" OnBack="() => { }">
                <ChildContent>
                    <p>Scrolling content.</p>
                </ChildContent>
                <BottomBar>
                    <AppButton FullWidth>Main action</AppButton>
                </BottomBar>
            </AppScreen>
        </Template>
    </Story>

    <Story Name="Top-level with bottom bar">
        <Template>
            <AppScreen Title="Screen title" Destination="NavDestination.Dashboard" OnNavigate="(NavDestination _) => { }">
                <ChildContent>
                    <p>Scrolling content.</p>
                </ChildContent>
                <BottomBar>
                    <AppButton FullWidth>Main action</AppButton>
                </BottomBar>
            </AppScreen>
        </Template>
    </Story>

    <Story Name="Top-level">
        <Template>
            <AppScreen Title="Screen title" Destination="NavDestination.Workouts" OnNavigate="(NavDestination _) => { }">
                <p>Scrolling content.</p>
            </AppScreen>
        </Template>
    </Story>

    <Story Name="Refreshing">
        <Template>
            <AppScreen @ref="refreshing" Title="Screen title" Destination="NavDestination.Workouts" OnNavigate="(NavDestination _) => { }"
                       OnRefresh="() => new TaskCompletionSource().Task">
                <p>Scrolling content.</p>
                <StartRefresh Screen="() => refreshing" />
            </AppScreen>
        </Template>
    </Story>

    <Story Name="Snackbar">
        <Template>
            <AppScreen Title="Screen title" OnBack="() => { }">
                <ChildContent>
                    <p>Scrolling content.</p>
                </ChildContent>
                <BottomBar>
                    <AppButton FullWidth>Main action</AppButton>
                </BottomBar>
                <Status>
                    <Snackbar Message="Barbell Back Squat set 2 deleted" />
                </Status>
            </AppScreen>
        </Template>
    </Story>

    <Story Name="Title only">
        <Template>
            <AppScreen Title="Screen title">
                <p>Scrolling content.</p>
            </AppScreen>
        </Template>
    </Story>

</Stories>

@code {
    private AppScreen? refreshing;
}
