@attribute [Stories(StoryTitles.Prefix + "/Components/ThisWeek/NewWorkoutChoice")]

<Stories TComponent="NewWorkoutChoice" Layout="typeof(ThemeLayout)">

    <Story Name="With workout in progress">
        <Description>+ while a workout is unfinished offers Resume or Discard and start new, on every screen with a + button.</Description>
        <Template>
            <NewWorkoutChoice @ref="choice" OnNew="() => { }" OnResume="() => { }" />
        </Template>
    </Story>

</Stories>

@using WorkoutLog.Core.Domain.Workouts
@using WorkoutLog.Core.Services
@inject IUnfinishedWorkoutService Service
@inject IExerciseCatalog Catalog

@code {
    private NewWorkoutChoice? choice;

    protected override void OnInitialized()
    {
        if (Service is SampleUnfinishedWorkoutService sample)
        {
            sample.Stored = new UnfinishedWorkout(DateTimeOffset.UtcNow.AddDays(-1), null,
            [
                new UnfinishedExercise(Catalog.All.First(e => e.Type == ExerciseType.Strength).Id, null, false,
                    [new UnfinishedEntry(new Dictionary<string, string?>()), new UnfinishedEntry(new Dictionary<string, string?>())]),
            ]);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && choice is not null)
        {
            await choice.AskAsync();
            StateHasChanged();
        }
    }
}
