@attribute [Stories("Components/ThisWeek/DayStrip")]

<Stories TComponent="DayStrip" Layout="typeof(ThemeLayout)">

    <Story Name="Wednesday">
        <Template>
            <DayStrip Monday="SampleThisWeek.Monday" Today="SampleThisWeek.Wednesday" Trained="SampleThisWeek.TrainedDays" TestId="day-strip" />
        </Template>
    </Story>

    <Story Name="Monday, nothing logged">
        <Template>
            <DayStrip Monday="SampleThisWeek.Monday" Today="SampleThisWeek.Monday" Trained="[]" TestId="day-strip" />
        </Template>
    </Story>

    <Story Name="Rest day today">
        <Template>
            <DayStrip Monday="SampleThisWeek.Monday" Today="SampleThisWeek.Wednesday" Trained="@(new[] { SampleThisWeek.Monday })" TestId="day-strip" />
        </Template>
    </Story>

    <Story Name="Sunday">
        <Template>
            <DayStrip Monday="SampleThisWeek.Monday" Today="SampleThisWeek.Monday.AddDays(6)" Trained="SampleThisWeek.TrainedDays" TestId="day-strip" />
        </Template>
    </Story>

</Stories>
