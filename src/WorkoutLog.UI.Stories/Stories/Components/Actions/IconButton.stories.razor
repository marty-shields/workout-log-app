@attribute [Stories("Components/Actions/IconButton")]

<Stories TComponent="IconButton" Layout="typeof(ThemeLayout)">

    <Story Name="Settings">
        <Template>
            <IconButton Icon="IconName.Settings" AriaLabel="Settings" />
        </Template>
    </Story>

    <Story Name="Back">
        <Template>
            <IconButton Icon="IconName.Back" AriaLabel="Back" />
        </Template>
    </Story>

    <Story Name="Close">
        <Template>
            <IconButton Icon="IconName.Close" AriaLabel="Close" />
        </Template>
    </Story>

    <Story Name="Delete">
        <Template>
            <IconButton Icon="IconName.Delete" AriaLabel="Delete" />
        </Template>
    </Story>

    <Story Name="Check">
        <Template>
            <IconButton Icon="IconName.Check" AriaLabel="Mark done" />
        </Template>
    </Story>

    <Story Name="Edit">
        <Template>
            <IconButton Icon="IconName.Edit" AriaLabel="Edit" Muted />
        </Template>
    </Story>

    <Story Name="Note">
        <Template>
            <IconButton Icon="IconName.Note" AriaLabel="Add note" Muted />
        </Template>
    </Story>

    <Story Name="Active">
        <Template>
            <IconButton Icon="IconName.Note" AriaLabel="Edit note" Active />
        </Template>
    </Story>

    <Story Name="Muted">
        <Template>
            <IconButton Icon="IconName.Close" AriaLabel="Remove set" Muted />
        </Template>
    </Story>

    <Story Name="Small">
        <Template>
            <IconButton Icon="IconName.Close" AriaLabel="Remove set" Muted Size="IconSize.Small" />
        </Template>
    </Story>

</Stories>
