@attribute [Stories("Components/Actions/AppButton")]

<Stories TComponent="AppButton" Layout="typeof(ThemeLayout)">

    <Story Name="Primary">
        <Template>
            <AppButton Variant="ButtonVariant.Primary">New Workout</AppButton>
        </Template>
    </Story>

    <Story Name="Secondary">
        <Template>
            <AppButton Variant="ButtonVariant.Secondary">Add exercise</AppButton>
        </Template>
    </Story>

    <Story Name="Danger">
        <Template>
            <AppButton Variant="ButtonVariant.Danger">Delete</AppButton>
        </Template>
    </Story>

    <Story Name="Disabled">
        <Template>
            <AppButton Disabled>Save</AppButton>
        </Template>
    </Story>

    <Story Name="Busy">
        <Template>
            <AppButton Variant="ButtonVariant.Secondary" FullWidth Busy>Exporting…</AppButton>
        </Template>
    </Story>

</Stories>
