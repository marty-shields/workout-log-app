@attribute [Stories("Components/Actions/AppButton")]

<Stories TComponent="AppButton">

    <Story Name="Primary">
        <Arguments>
            <Arg For="_ => _.Variant" Value="ButtonVariant.Primary" />
        </Arguments>
        <Template>
            <AppButton @attributes="context.Args">New Workout</AppButton>
        </Template>
    </Story>

    <Story Name="Secondary">
        <Arguments>
            <Arg For="_ => _.Variant" Value="ButtonVariant.Secondary" />
        </Arguments>
        <Template>
            <AppButton @attributes="context.Args">Add exercise</AppButton>
        </Template>
    </Story>

    <Story Name="Danger">
        <Arguments>
            <Arg For="_ => _.Variant" Value="ButtonVariant.Danger" />
        </Arguments>
        <Template>
            <AppButton @attributes="context.Args">Delete</AppButton>
        </Template>
    </Story>

    <Story Name="Text">
        <Arguments>
            <Arg For="_ => _.Variant" Value="ButtonVariant.Text" />
        </Arguments>
        <Template>
            <AppButton @attributes="context.Args">Remove</AppButton>
        </Template>
    </Story>

    <Story Name="Disabled">
        <Arguments>
            <Arg For="_ => _.Disabled" Value="true" />
        </Arguments>
        <Template>
            <AppButton @attributes="context.Args">Save</AppButton>
        </Template>
    </Story>

</Stories>
