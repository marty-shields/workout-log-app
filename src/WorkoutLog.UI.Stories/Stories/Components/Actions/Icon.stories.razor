@attribute [Stories("Components/Actions/Icon")]

<Stories TComponent="Icon" Layout="typeof(ThemeLayout)">

    <Story Name="Chevron">
        <Template>
            <Icon Name="IconName.Chevron" />
        </Template>
    </Story>

    <Story Name="Muted">
        <Template>
            <Icon Name="IconName.Chevron" Muted />
        </Template>
    </Story>

    <Story Name="Search">
        <Template>
            <Icon Name="IconName.Search" Muted />
        </Template>
    </Story>

    <Story Name="Small">
        <Template>
            <Icon Name="IconName.Chevron" Muted Size="IconSize.Small" />
        </Template>
    </Story>

</Stories>
