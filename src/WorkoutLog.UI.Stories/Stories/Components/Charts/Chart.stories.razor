@attribute [Stories("Components/Charts/Chart")]

<Stories TComponent="Chart" Layout="typeof(ThemeLayout)">

    <Story Name="Rising">
        <Template>
            <Chart Points="SampleExercises.LiftE1rm.Points" Format="SampleExercises.Kg" Name="e1RM, last 3 months" TestId="exercise-chart" />
        </Template>
    </Story>

    <Story Name="Point labels">
        <Template>
            <Chart Points="SampleExercises.LiftTopSet.Points" Format="SampleExercises.Kg" Name="Top set, last 3 months" TestId="exercise-chart" />
        </Template>
    </Story>

    <Story Name="Flipped">
        <Template>
            <Chart Points="SampleExercises.CardioPace.Points" Format="SampleExercises.Clock" Flipped TimeScale Name="Pace, last 3 months" TestId="exercise-chart" />
        </Template>
    </Story>

    <Story Name="Best beside latest">
        <Template>
            <Chart Points="BestBesideLatest" Format="SampleExercises.Kg" Name="e1RM, last 3 months" TestId="exercise-chart" />
        </Template>
    </Story>

    <Story Name="Best beside latest at the bottom">
        <Template>
            <Chart Points="BestBesideLatestAtTheBottom" Format="SampleExercises.Kg" Name="e1RM, last 3 months" TestId="exercise-chart" />
        </Template>
    </Story>

    <Story Name="Gaps">
        <Template>
            <Chart Points="Gaps" Format="SampleExercises.Kg" Name="Top set, last 3 months" TestId="exercise-chart" />
        </Template>
    </Story>

    <Story Name="All zero">
        <Template>
            <Chart Points="AllZero" Format="SampleExercises.Kg" Flipped Name="Least assist per session, last 3 months" TestId="exercise-chart" />
        </Template>
    </Story>

    <Story Name="One point">
        <Template>
            <Chart Points="SampleExercises.OneSession.Points" Format="SampleExercises.Kg" Name="Top set, last 3 months" TestId="exercise-chart" />
        </Template>
    </Story>

    <Story Name="Many points">
        <Template>
            <Chart Points="SampleExercises.ManyPoints" Format="SampleExercises.Kg" Name="Top set, last 6 months" TestId="exercise-chart" />
        </Template>
    </Story>

</Stories>

@code {
    private static readonly IReadOnlyList<ChartPoint> AllZero = [new("13 Oct", 0, "×4"), new("20 Oct", 0, "×5")];

    private static readonly IReadOnlyList<ChartPoint> BestBesideLatest =
    [
        new("18 Aug", 70), new("25 Aug", 71.5m), new("1 Sep", 72), new("8 Sep", 73), new("15 Sep", 72.5m),
        new("22 Sep", 74), new("29 Sep", 73.5m), new("6 Oct", 74.5m), new("13 Oct", 75), new("20 Oct", 74.8m),
    ];

    private static readonly IReadOnlyList<ChartPoint> BestBesideLatestAtTheBottom =
    [
        new("7 Jul", 80), new("14 Jul", 80), new("21 Jul", 80), new("28 Jul", 80), new("4 Aug", 80), new("11 Aug", 80),
        new("18 Aug", 80), new("25 Aug", 80), new("1 Sep", 80), new("8 Sep", 80), new("15 Sep", 80), new("22 Sep", 80),
        new("29 Sep", 80), new("6 Oct", 80), new("13 Oct", 80.02m), new("20 Oct", 80),
    ];

    private static readonly IReadOnlyList<ChartPoint> Gaps =
    [
        new("1 Sep", 10, "×10"),
        new("15 Sep", null),
        new("22 Sep", 12, "×12"),
        new("29 Sep", null),
        new("6 Oct", 14, "×10"),
        new("13 Oct", 16, "×8"),
    ];
}
