@attribute [Stories("Components/Lists/EmptyState")]

<Stories TComponent="EmptyState" Layout="typeof(ThemeLayout)">

    <Story Name="Default">
        <Template>
            <EmptyState Message="No workouts yet" />
        </Template>
    </Story>

    <Story Name="With hint">
        <Template>
            <EmptyState Message="No workouts yet" Hint="Tap New Workout on the Dashboard to log one" />
        </Template>
    </Story>

</Stories>
