@using WorkoutLog.Core.Services
@attribute [Stories("Components/Lists/WorkoutTotalsCard")]

<Stories TComponent="WorkoutTotalsCard" Layout="typeof(ThemeLayout)">

    <Story Name="Default">
        <Template>
            <WorkoutTotalsCard Totals="new WorkoutTotals(32, 384, new TimeSpan(27, 50, 0), 2.5)" TestId="workout-totals" />
        </Template>
    </Story>

    <Story Name="Short span">
        <Template>
            <WorkoutTotalsCard Totals="new WorkoutTotals(1, 11, new TimeSpan(0, 45, 0), 1.0)" TestId="workout-totals" />
        </Template>
    </Story>

    <Story Name="Long numbers">
        <Template>
            <WorkoutTotalsCard Totals="new WorkoutTotals(1234, 15678, new TimeSpan(1105, 5, 0), 12.3)" TestId="workout-totals" />
        </Template>
    </Story>

</Stories>
