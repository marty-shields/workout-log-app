@using WorkoutLog.Core.Services
@attribute [Stories("Components/Lists/WorkoutTotalsCard")]

<Stories TComponent="WorkoutTotalsCard" Layout="typeof(ThemeLayout)">

    <Story Name="Default">
        <Template>
            <WorkoutTotalsCard Totals="SampleWorkoutHistory.Totals" TestId="workout-totals" />
        </Template>
    </Story>

    <Story Name="Under an hour">
        <Template>
            <WorkoutTotalsCard Totals="new WorkoutTotals(1, 8, TimeSpan.FromMinutes(45), 1)" TestId="workout-totals" />
        </Template>
    </Story>

</Stories>
