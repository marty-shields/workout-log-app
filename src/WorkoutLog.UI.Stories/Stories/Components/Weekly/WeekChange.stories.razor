@attribute [Stories("Components/Weekly/WeekChange")]

<Stories TComponent="WeekChange" Layout="typeof(ThemeLayout)">

    <Story Name="Up">
        <Template>
            <WeekChange Difference="25" Format="@(n => $"{n}m")" />
        </Template>
    </Story>

    <Story Name="Down">
        <Template>
            <WeekChange Difference="-1" Format="@(n => n.ToString())" />
        </Template>
    </Story>

    <Story Name="No change">
        <Template>
            <WeekChange Difference="0" Format="@(n => n.ToString())" />
        </Template>
    </Story>

</Stories>
