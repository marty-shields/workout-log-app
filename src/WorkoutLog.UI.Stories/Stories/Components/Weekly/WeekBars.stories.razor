@attribute [Stories(StoryTitles.Prefix + "/Components/Weekly/WeekBars")]

<Stories TComponent="WeekBars" Layout="typeof(ThemeLayout)">

    <Story Name="Full">
        <Template>
            <WeekBars Counts="SampleWeekly.FullWeeks" TestId="bars" />
        </Template>
    </Story>

    <Story Name="Gaps">
        <Template>
            <WeekBars Counts="SampleWeekly.WeekCounts" TestId="bars" />
        </Template>
    </Story>

    <Story Name="All empty">
        <Template>
            <WeekBars Counts="SampleWeekly.EmptyWeeks" TestId="bars" />
        </Template>
    </Story>

    <Story Name="One week">
        <Template>
            <WeekBars Counts="SampleWeekly.FirstWeekCounts" TestId="bars" />
        </Template>
    </Story>

</Stories>
