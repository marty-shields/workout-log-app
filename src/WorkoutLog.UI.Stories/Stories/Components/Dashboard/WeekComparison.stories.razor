@attribute [Stories("Components/Dashboard/WeekComparison")]

<Stories TComponent="WeekComparison" Layout="typeof(ThemeLayout)">

    <Story Name="Up">
        <Template>
            <WeekComparison ThisWeek="SampleDashboard.ThisWeek" LastWeekToDate="SampleDashboard.FirstWeek" TestId="comparison" />
        </Template>
    </Story>

    <Story Name="Down">
        <Template>
            <WeekComparison ThisWeek="SampleDashboard.FirstWeek" LastWeekToDate="SampleDashboard.ThisWeek" TestId="comparison" />
        </Template>
    </Story>

    <Story Name="Mixed">
        <Template>
            <WeekComparison ThisWeek="SampleDashboard.ThisWeek" LastWeekToDate="SampleDashboard.LastWeekToDate" TestId="comparison" />
        </Template>
    </Story>

    <Story Name="No change">
        <Template>
            <WeekComparison ThisWeek="SampleDashboard.ThisWeek" LastWeekToDate="SampleDashboard.ThisWeek" TestId="comparison" />
        </Template>
    </Story>

    <Story Name="Nothing last week">
        <Template>
            <WeekComparison ThisWeek="SampleDashboard.ThisWeek" LastWeekToDate="SampleDashboard.NoWeek" TestId="comparison" />
        </Template>
    </Story>

    <Story Name="Nothing this week">
        <Template>
            <WeekComparison ThisWeek="SampleDashboard.NoWeek" LastWeekToDate="SampleDashboard.LastWeekToDate" TestId="comparison" />
        </Template>
    </Story>

</Stories>
