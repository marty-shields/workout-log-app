@using Microsoft.JSInterop
@* Plays a scenario on the prototype: outlines each step's target, then taps it or types into it. Stories only. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="player">
    <div @ref="phone">
        <PrototypeApp @key="generation" Empty="Scenario.Empty" StartupDelay="Scenario.StartupDelay" StartupFails="Scenario.StartupFails" />
    </div>
    <aside class="panel">
        <h2 class="name">@Scenario.Name</h2>
        <p class="summary">@Scenario.Summary</p>
        <div class="controls">
            <AppButton TestId="scenario-play" Disabled="Finished" OnClick="PlayOrPause">@(playing ? "Pause" : "Play")</AppButton>
            <AppButton Variant="ButtonVariant.Secondary" TestId="scenario-restart" OnClick="Restart">Restart</AppButton>
        </div>
        <ol class="steps">
            @for (var i = 0; i < Scenario.Steps.Count; i++)
            {
                <li class="@StepClass(i)">@Scenario.Steps[i].Caption</li>
            }
        </ol>
        @if (failure is not null)
        {
            <p class="failure" role="alert" data-testid="scenario-failure">@failure</p>
        }
        else if (Finished)
        {
            <p class="complete" data-testid="scenario-done">Scenario complete. Restart to play it again.</p>
        }
    </aside>
</div>

@code {
    private static readonly TimeSpan StepPause = TimeSpan.FromMilliseconds(900);

    private ElementReference phone;
    private IJSObjectReference? module;
    private int generation;
    private int next;
    private bool playing;
    private bool looping;
    private string? failure;

    /// <summary>Scenario to play.</summary>
    [Parameter, EditorRequired]
    public Scenario Scenario { get; set; } = null!;

    private bool Finished => next == Scenario.Steps.Count;

    public async ValueTask DisposeAsync()
    {
        generation++;
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private async Task PlayOrPause()
    {
        playing = !playing;
        if (playing && !looping)
        {
            if (next == 0)
            {
                generation++;
            }

            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Stories/Prototype/ScenarioPlayer.razor.js");
            await PlayAsync(generation);
        }
    }

    private async Task PlayAsync(int run)
    {
        looping = true;
        while (playing && !Finished)
        {
            var step = Scenario.Steps[next];
            StateHasChanged();
            var found = await module!.InvokeAsync<bool>("run", phone, step.Action.ToString(), step.TestId, step.Text);
            if (run != generation)
            {
                return;
            }

            if (!found)
            {
                failure = $"Step {next + 1}: nothing with data-testid \"{step.TestId}\" on screen.";
                playing = false;
                break;
            }

            next++;
            StateHasChanged();
            await Task.Delay(StepPause);
            if (run != generation)
            {
                return;
            }
        }

        playing = false;
        looping = false;
    }

    private void Restart()
    {
        generation++;
        next = 0;
        playing = false;
        looping = false;
        failure = null;
    }

    private string? StepClass(int index) =>
        index < next ? "done" : index == next && (playing || failure is not null) ? "current" : null;
}
