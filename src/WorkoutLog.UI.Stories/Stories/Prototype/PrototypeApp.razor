@using WorkoutLog.UI.Components.Layout
@using WorkoutLog.UI.Models.History
@* Clickable prototype of the whole app on sample data. Navigation follows docs/05. Stories only. *@
@implements IDisposable
@inject IExerciseCatalog Catalog
@inject ISetChecker Checker
@inject WorkoutEditor Editor

<PhoneFrame OnSystemBack="Back" OnSimulateError="() => broken = true">
    <StartupGate Initialize="Start">
        <AppErrorBoundary OnRestart="Restart">
            @if (broken)
            {
                <ThrowOnRender />
            }
            @switch (screen)
            {
                case Screen.Dashboard:
                    <DashboardView Summary="SampleData.Summary(saved, DateTime.Now)" OnNewWorkout="StartWorkout" OnHistory="() => Go(Screen.History)" />
                    break;

                case Screen.History:
                    <HistoryView Rows="HistoryRows" OnOpen="Open" OnBack="Back" />
                    break;

                case Screen.Workout:
                    <WorkoutView Mode="mode"
                                 StartedAt="startedAt"
                                 Time="WorkoutTime"
                                 Exercises="Editor.Exercises"
                                 Error="@Editor.Error"
                                 ValidateSet="Checker.Check"
                                 OnChanged="Editor.MarkChanged"
                                 OnAddExercise="Editor.OpenPicker"
                                 OnRemoveExercise="Editor.Remove"
                                 Focus="Editor.Focus"
                                 ErrorFocus="Editor.ErrorFocus"
                                 OnSave="SaveAsync"
                                 OnBack="Back"
                                 OnDelete="() => dialog = Dialog.Delete">
                        <Overlay>
                            @if (Editor.PickerOpen)
                            {
                                <ExercisePicker Query="@Editor.Query" QueryChanged="Editor.Search" Items="Editor.PickerItems" OnPick="Editor.Pick" OnClose="Editor.ClosePicker" />
                            }
                            @switch (dialog)
                            {
                                case Dialog.Discard:
                                    <ConfirmDialog Title="Discard this workout?" ConfirmText="Discard" Danger OnConfirm="() => Go(Screen.Dashboard)" OnCancel="CloseDialog" />
                                    break;
                                case Dialog.DiscardChanges:
                                    <ConfirmDialog Title="Discard changes?" ConfirmText="Discard" Danger OnConfirm="() => Go(Screen.History)" OnCancel="CloseDialog" />
                                    break;
                                case Dialog.Delete:
                                    <ConfirmDialog Title="Delete this workout?" ConfirmText="Delete" Danger OnConfirm="Delete" OnCancel="CloseDialog" />
                                    break;
                            }
                        </Overlay>
                    </WorkoutView>
                    break;

                case Screen.Closed:
                    <div class="closed">
                        <p>Back on the Dashboard leaves the app.</p>
                        <AppButton TestId="reopen" OnClick="() => Go(Screen.Dashboard)">Reopen the app</AppButton>
                    </div>
                    break;
            }
        </AppErrorBoundary>
    </StartupGate>
</PhoneFrame>

@code {
    private enum Screen { Dashboard, History, Workout, Closed }

    private enum Dialog { None, Discard, DiscardChanges, Delete }

    private List<SavedWorkout> saved = [];
    private readonly PeriodicTimer timer = new(TimeSpan.FromSeconds(1));
    private Screen screen;
    private WorkoutMode mode;
    private SavedWorkout? editing;
    private DateTime startedAt;
    private Dialog dialog;
    private bool broken;

    /// <summary>Starts with no saved workouts.</summary>
    [Parameter]
    public bool Empty { get; set; }

    /// <summary>How long the Startup screen shows before the app opens. None by default.</summary>
    [Parameter]
    public TimeSpan StartupDelay { get; set; }

    /// <summary>Shows the startup error after <see cref="StartupDelay"/> instead of opening the app.</summary>
    [Parameter]
    public bool StartupFails { get; set; }

    private IReadOnlyList<HistoryRow> HistoryRows =>
        saved.OrderByDescending(w => w.StartedAt).Select(w => new HistoryRow(w.Id, w.StartedAt)).ToList();

    private TimeSpan WorkoutTime => editing is null ? DateTime.Now - startedAt : editing.FinishedAt - editing.StartedAt;

    protected override void OnInitialized()
    {
        saved = Empty ? [] : SampleData.SavedWorkouts(Catalog, DateTime.Now);
        _ = TickAsync();
    }

    public void Dispose() => timer.Dispose();

    private async Task TickAsync()
    {
        while (await timer.WaitForNextTickAsync())
        {
            if (screen == Screen.Workout && mode == WorkoutMode.New)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void StartWorkout()
    {
        mode = WorkoutMode.New;
        editing = null;
        startedAt = DateTime.Now;
        Editor.Start([]);
        Go(Screen.Workout);
    }

    private void Open(HistoryRow row)
    {
        editing = saved.Single(w => w.Id == row.Id);
        mode = WorkoutMode.Edit;
        startedAt = editing.StartedAt;
        Editor.Start(SampleData.Clone(editing.Exercises));
        Go(Screen.Workout);
    }

    private async Task SaveAsync()
    {
        if (await Editor.SaveAsync(_ => Task.FromResult(Store())))
        {
            Go(Screen.Dashboard);
        }
    }

    /// <summary>Keeps the edited exercises, oldest first, as the new or edited sample workout.</summary>
    private bool Store()
    {
        var exercises = Editor.Exercises.Reverse().ToList();
        if (editing is null)
        {
            saved.Add(new SavedWorkout(saved.Select(w => w.Id).DefaultIfEmpty().Max() + 1, startedAt, DateTime.Now, exercises));
        }
        else
        {
            saved[saved.IndexOf(editing)] = editing with { Exercises = exercises };
        }

        return true;
    }

    private void Delete()
    {
        saved.Remove(editing!);
        Go(Screen.History);
    }

    private async Task Start()
    {
        if (StartupDelay > TimeSpan.Zero)
        {
            await Task.Delay(StartupDelay);
        }

        if (StartupFails)
        {
            throw new InvalidOperationException("Simulated startup failure");
        }
    }

    private void Restart()
    {
        broken = false;
        Go(Screen.Dashboard);
    }

    private void CloseDialog() => dialog = Dialog.None;

    private void Back()
    {
        switch (screen)
        {
            case Screen.Workout when dialog != Dialog.None:
                CloseDialog();
                break;
            case Screen.Workout when Editor.PickerOpen:
                Editor.ClosePicker();
                break;
            case Screen.Workout when mode == WorkoutMode.New:
                dialog = Dialog.Discard;
                break;
            case Screen.Workout when Editor.Changed:
                dialog = Dialog.DiscardChanges;
                break;
            case Screen.Workout:
                Go(Screen.History);
                break;
            case Screen.History:
                Go(Screen.Dashboard);
                break;
            case Screen.Dashboard:
                Go(Screen.Closed);
                break;
        }
    }

    private void Go(Screen next)
    {
        screen = next;
        dialog = Dialog.None;
    }
}
