    <Story Name="Click through">
        <Template>
            <PrototypeApp />
        </Template>
    </Story>

    <Story Name="First use">
        <Template>
            <ScenarioPlayer Scenario="Scenarios.FirstUse" />
        </Template>
    </Story>

    <Story Name="Log a strength workout">
        <Template>
            <ScenarioPlayer Scenario="Scenarios.LogStrength" />
