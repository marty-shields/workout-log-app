<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <MD2RazorDefaultBaseClass>global::BlazingStory.Internals.Pages.MarkdownPageBase</MD2RazorDefaultBaseClass>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlazingStory" />
    <PackageReference Include="MD2RazorGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkoutLog.UI\WorkoutLog.UI.csproj" />
  </ItemGroup>

  <!-- The App's icon and splash, embedded as brand.<file>.svg for the App Icon stories. -->
  <ItemGroup>
    <EmbeddedResource Include="..\WorkoutLog.App\Resources\AppIcon\*.svg;..\WorkoutLog.App\Resources\Splash\*.svg" LogicalName="brand.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
