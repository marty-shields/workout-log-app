<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <MD2RazorDefaultBaseClass>global::BlazingStory.Internals.Pages.MarkdownPageBase</MD2RazorDefaultBaseClass>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlazingStory" />
    <PackageReference Include="MD2RazorGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkoutLog.UI\WorkoutLog.UI.csproj" />
  </ItemGroup>

  <!-- The Shields.UI.Stories shell (phone frame, layouts, token and app icon sheets) comes from NuGet; -p:UseKitSource=true builds against the kit's source at KitPath instead. -->
  <ItemGroup Condition="'$(UseKitSource)' != 'true'">
    <PackageReference Include="Shields.UI.Stories" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseKitSource)' == 'true'">
    <ProjectReference Include="$(KitSourcePath)/src/Shields.UI.Stories/Shields.UI.Stories.csproj" />
  </ItemGroup>

  <!-- The App's icon and splash, embedded as brand.<file>.svg for the App Icon stories. -->
  <ItemGroup>
    <EmbeddedResource Include="..\WorkoutLog.App\Resources\AppIcon\*.svg;..\WorkoutLog.App\Resources\Splash\*.svg" LogicalName="brand.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
