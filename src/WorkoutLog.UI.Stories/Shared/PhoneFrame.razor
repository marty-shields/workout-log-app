@* Phone-sized frame (412 × 915) with simulated status and navigation bars, and a theme switch. *@
<div class="frame">
    <ThemeSwitch @bind-Theme="Theme" />
    <div class="phone" data-theme="@Theme" data-testid="phone">
        <div class="viewport">
            @ChildContent
        </div>
        <div class="status-bar" aria-hidden="true">
            <span>9:41</span>
        </div>
        <div class="nav-bar" aria-hidden="true">
            <span class="handle"></span>
        </div>
    </div>
</div>

@code {
    /// <summary>Screen shown inside the frame.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string? Theme { get; set; }
}
