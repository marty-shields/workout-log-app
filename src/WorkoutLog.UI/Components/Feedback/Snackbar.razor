@implements IDisposable
@inject TimeProvider Clock

<div class="snackbar" data-testid="@TestId">
    <p class="message" data-testid="@($"{TestId}-message")">@Message</p>
    <button type="button" class="action" data-testid="@($"{TestId}-undo")" @onclick="OnUndo">Undo</button>
</div>

@code {
    /// <summary>
    /// How long the snackbar shows before <see cref="OnTimeout"/>. Material asks for 4 to 10 seconds; 6 leaves time to read the
    /// message and reach Undo between sets.
    /// </summary>
    public static readonly TimeSpan Duration = TimeSpan.FromSeconds(6);

    private readonly CancellationTokenSource shown = new();

    /// <summary>What just happened, e.g. Set 2 deleted.</summary>
    [Parameter, EditorRequired]
    public string Message { get; set; } = "";

    /// <summary>Raised by Undo.</summary>
    [Parameter]
    public EventCallback OnUndo { get; set; }

    /// <summary>Raised once, <see cref="Duration"/> after the snackbar first shows, unless it is removed first.</summary>
    [Parameter]
    public EventCallback OnTimeout { get; set; }

    /// <summary>Value of the data-testid attribute; also the prefix for <c>{TestId}-message</c> and <c>{TestId}-undo</c>.</summary>
    [Parameter]
    public string TestId { get; set; } = "snackbar";

    protected override void OnInitialized() => _ = TimeOutAsync();

    public void Dispose()
    {
        shown.Cancel();
        shown.Dispose();
    }

    private async Task TimeOutAsync()
    {
        try
        {
            await Task.Delay(Duration, Clock, shown.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await InvokeAsync(() => OnTimeout.InvokeAsync());
    }
}
