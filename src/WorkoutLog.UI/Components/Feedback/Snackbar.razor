@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@implements IDisposable
@inject TimeProvider Clock
@inject ILogger<Snackbar> Logger
@inject IJSRuntime JS

<div class="snackbar" data-testid="@TestId">
    <p class="message" data-testid="@($"{TestId}-message")" data-wrap-ok>@Message</p>
    <button @ref="undo" type="button" class="action" data-testid="@($"{TestId}-undo")" @onclick="OnUndo" @onfocus="OnFocusAsync" @onblur="OnBlur">Undo</button>
</div>

@code {
    /// <summary>
    /// How long the snackbar shows before <see cref="OnTimeout"/>. Material asks for 4 to 10 seconds; 10, its upper bound, gives a
    /// TalkBack user, who reaches Undo by swiping and doesn't stop the timer, time to read the message and get there.
    /// </summary>
    public static readonly TimeSpan Duration = TimeSpan.FromSeconds(10);

    private ElementReference undo;
    private CancellationTokenSource? timer;
    private bool timedOut;
    private bool focused;

    /// <summary>What just happened, e.g. Barbell Back Squat set 2 deleted.</summary>
    [Parameter, EditorRequired]
    public string Message { get; set; } = "";

    /// <summary>Raised by Undo.</summary>
    [Parameter]
    public EventCallback OnUndo { get; set; }

    /// <summary>
    /// Raised once, <see cref="Duration"/> after the snackbar first shows, unless it is removed first. Undo holding keyboard focus
    /// (<c>:focus-visible</c>) stops the timer, and focus leaving it starts a full <see cref="Duration"/> again. Focus moved there
    /// by <see cref="TakeFocus"/> after a tap doesn't stop it.
    /// </summary>
    [Parameter]
    public EventCallback OnTimeout { get; set; }

    /// <summary>Moves focus to Undo when the snackbar first shows, for when what had focus, such as a trash, has just gone.</summary>
    [Parameter]
    public bool TakeFocus { get; set; }

    /// <summary>Value of the data-testid attribute; also the prefix for <c>{TestId}-message</c> and <c>{TestId}-undo</c>.</summary>
    [Parameter]
    public string TestId { get; set; } = "snackbar";

    protected override void OnInitialized() => StartTimer();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !TakeFocus)
        {
            return;
        }

        try
        {
            await undo.FocusAsync();
        }
        catch (Exception exception)
        {
            Log.UndoFocusFailed(Logger, exception);
        }
    }

    public void Dispose() => StopTimer();

    private async Task OnFocusAsync()
    {
        focused = true;
        if (await KeyboardFocusedAsync() && focused)
        {
            StopTimer();
        }
    }

    private void OnBlur()
    {
        focused = false;
        StartTimer();
    }

    /// <summary>Whether Undo shows the keyboard focus ring. False when that can't be read, so the snackbar still times out.</summary>
    private async Task<bool> KeyboardFocusedAsync()
    {
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/WorkoutLog.UI/Components/Feedback/Snackbar.razor.js");
            return await module.InvokeAsync<bool>("isFocusVisible", undo);
        }
        catch (Exception exception)
        {
            Log.FocusCheckFailed(Logger, exception);
            return false;
        }
    }

    private void StartTimer()
    {
        if (timer is null && !timedOut)
        {
            timer = new CancellationTokenSource();
            _ = TimeOutAsync(timer.Token);
        }
    }

    private void StopTimer()
    {
        timer?.Cancel();
        timer?.Dispose();
        timer = null;
    }

    // Not awaited by anyone, so a failure goes to the nearest error boundary, as an exception from a button click would.
    private async Task TimeOutAsync(CancellationToken stopped)
    {
        try
        {
            await Task.Delay(Duration, Clock, stopped);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            if (stopped.IsCancellationRequested)
            {
                return;
            }

            timedOut = true;
            try
            {
                await OnTimeout.InvokeAsync();
            }
            catch (Exception exception)
            {
                await DispatchExceptionAsync(exception);
            }
        });
    }
}
