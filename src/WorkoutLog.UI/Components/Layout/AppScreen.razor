<div class="screen">
    <BackHandler OnBack="Back" />
    <header class="top-bar">
        @if (OnBack.HasDelegate)
        {
            <IconButton Icon="IconName.Back" AriaLabel="Back" TestId="back" OnClick="OnBack" />
        }
        <div class="titles">
            <h1 class="title" data-testid="screen-title">@Title</h1>
            @if (Subtitle is not null)
            {
                <p class="subtitle" data-testid="screen-subtitle">@Subtitle</p>
            }
        </div>
        @Actions
    </header>
    <main class="content">
        @ChildContent
    </main>
    @if (BottomBar is not null || Destination is not null)
    {
        <footer class="bottom">
            @if (Status is not null)
            {
                <div class="snackbar-slot" role="status" aria-live="polite">
                    @Status
                </div>
            }
            @if (BottomBar is not null)
            {
                <div class="bottom-bar" data-testid="bottom-bar">
                    @BottomBar
                </div>
            }
            @if (Destination is { } current)
            {
                <BottomNav Current="current" OnNavigate="OnNavigate" />
            }
        </footer>
    }
</div>

@code {
    /// <summary>Screen title.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>Line under the title.</summary>
    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>Raised by the back arrow and the Android back button. No arrow shows when unset, and Android back leaves the app. Unset on a top-level screen.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    /// <summary>Makes this a top-level screen: shows the bottom navigation bar with this item current. Android back then goes to <see cref="NavDestinations.Start"/>, or leaves the app from there.</summary>
    [Parameter]
    public NavDestination? Destination { get; set; }

    /// <summary>Raised with the destination tapped in the bottom navigation bar, or with <see cref="NavDestinations.Start"/> on Android back.</summary>
    [Parameter]
    public EventCallback<NavDestination> OnNavigate { get; set; }

    /// <summary>Actions at the right of the top bar.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>Scrolling screen content.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Actions fixed at the bottom, in thumb reach.</summary>
    [Parameter]
    public RenderFragment? BottomBar { get; set; }

    /// <summary>
    /// A snackbar just above the bottom bar, over the content. Its slot is a polite live region, there whenever this is set,
    /// so a snackbar shown later is read out. Needs <see cref="BottomBar"/> or <see cref="Destination"/>.
    /// </summary>
    [Parameter]
    public RenderFragment? Status { get; set; }

    private EventCallback Back =>
        Destination is { } current && current != NavDestinations.Start
            ? EventCallback.Factory.Create(this, () => OnNavigate.InvokeAsync(NavDestinations.Start))
            : OnBack;
}
