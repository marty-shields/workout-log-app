@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<AppScreen> Logger

<div class="screen">
    <BackHandler OnBack="Back" />
    <header class="top-bar">
        @if (OnBack.HasDelegate)
        {
            <IconButton Icon="IconName.Back" AriaLabel="Back" TestId="back" OnClick="OnBack" />
        }
        <div class="titles">
            <h1 class="title" data-testid="screen-title">@Title</h1>
            @if (Subtitle is not null)
            {
                <p class="subtitle" data-testid="screen-subtitle">@Subtitle</p>
            }
        </div>
        @Actions
    </header>
    @if (Toolbar is not null)
    {
        <div class="toolbar">
            @Toolbar
        </div>
    }
    @if (OnRefresh.HasDelegate)
    {
        <div @ref="indicator" class="pull-refresh" data-testid="pull-refresh" aria-hidden="true">
            <span class="ring"></span>
        </div>
    }
    <main @ref="content" class="content">
        @ChildContent
    </main>
    @if (BottomBar is not null || Destination is not null)
    {
        <footer class="bottom">
            @if (Status is not null)
            {
                <div class="snackbar-slot" role="status" aria-live="polite">
                    @Status
                </div>
            }
            @if (BottomBar is not null)
            {
                <div class="bottom-bar" data-testid="bottom-bar">
                    @BottomBar
                </div>
            }
            @if (Destination is { } current)
            {
                <BottomNav Current="current" OnNavigate="OnNavigate" />
            }
        </footer>
    }
</div>

@code {
    private ElementReference content;
    private ElementReference indicator;
    private IJSObjectReference? module;
    private DotNetObjectReference<AppScreen>? self;
    private bool refreshing;

    /// <summary>Screen title.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>Line under the title.</summary>
    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>Raised by the back arrow and the Android back button. No arrow shows when unset, and Android back leaves the app. Unset on a top-level screen.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    /// <summary>Makes this a top-level screen: shows the bottom navigation bar with this item current. Android back then goes to <see cref="NavDestinations.Start"/>, or leaves the app from there.</summary>
    [Parameter]
    public NavDestination? Destination { get; set; }

    /// <summary>Raised with the destination tapped in the bottom navigation bar, or with <see cref="NavDestinations.Start"/> on Android back.</summary>
    [Parameter]
    public EventCallback<NavDestination> OnNavigate { get; set; }

    /// <summary>Actions at the right of the top bar.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>
    /// Controls fixed between the top bar and the content, such as filters. They scroll on their own only when taller than the screen.
    /// No toolbar shows when unset.
    /// </summary>
    [Parameter]
    public RenderFragment? Toolbar { get; set; }

    /// <summary>Scrolling screen content.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Actions fixed at the bottom, in thumb reach.</summary>
    [Parameter]
    public RenderFragment? BottomBar { get; set; }

    /// <summary>
    /// A snackbar just above the bottom bar, over the content. Its slot is a polite live region, there whenever this is set,
    /// so a snackbar shown later is read out. Needs <see cref="BottomBar"/> or <see cref="Destination"/>.
    /// </summary>
    [Parameter]
    public RenderFragment? Status { get; set; }

    /// <summary>
    /// Makes the content pull-to-refresh: pulling it down from the top far enough runs this once the finger lifts. The indicator
    /// shows only while pulling, so the handler shows its own loading state. A pull during a refresh is ignored. Read once, when
    /// the screen first shows. No gesture when unset.
    /// </summary>
    [Parameter]
    public EventCallback OnRefresh { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !OnRefresh.HasDelegate)
        {
            return;
        }

        try
        {
            self = DotNetObjectReference.Create(this);
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/WorkoutLog.UI/Components/Layout/AppScreen.razor.js");
            await module.InvokeVoidAsync("attach", content, indicator, self);
        }
        catch (Exception exception)
        {
            Log.PullRefreshFailed(Logger, exception);
        }
    }

    [JSInvokable]
    public async Task RefreshAsync()
    {
        if (refreshing)
        {
            return;
        }

        refreshing = true;
        try
        {
            await OnRefresh.InvokeAsync();
        }
        finally
        {
            refreshing = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("detach", content);
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        self?.Dispose();
    }

    private EventCallback Back =>
        Destination is { } current && current != NavDestinations.Start
            ? EventCallback.Factory.Create(this, () => OnNavigate.InvokeAsync(NavDestinations.Start))
            : OnBack;
}
