@using WorkoutLog.UI.Navigation

<div class="screen">
    <BackHandler OnBack="OnBack" />
    <header class="top-bar">
        @if (OnBack.HasDelegate)
        {
            <IconButton Icon="IconName.Back" AriaLabel="Back" TestId="back" OnClick="OnBack" />
        }
        <div class="titles">
            <h1 class="title" data-testid="screen-title">@Title</h1>
            @if (Subtitle is not null)
            {
                <p class="subtitle" data-testid="screen-subtitle">@Subtitle</p>
            }
        </div>
        @Actions
    </header>
    <main class="content">
        @ChildContent
    </main>
    @if (BottomBar is not null)
    {
        <footer class="bottom-bar" data-testid="bottom-bar">
            @BottomBar
        </footer>
    }
</div>

@code {
    /// <summary>Screen title.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>Line under the title.</summary>
    [Parameter]
    public string? Subtitle { get; set; }

    /// <summary>Raised by the back arrow and the Android back button. No arrow shows when unset, and Android back leaves the app.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    /// <summary>Actions at the right of the top bar.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>Scrolling screen content.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Actions fixed at the bottom, in thumb reach.</summary>
    [Parameter]
    public RenderFragment? BottomBar { get; set; }
}
