@using System.Diagnostics
@using Microsoft.Extensions.Logging
@using WorkoutLog.UI.Screens
@inject ILogger<StartupGate> Logger
@if (_state == State.Ready)
{
    @ChildContent
}
else
{
    <StartupView Failed="_state == State.Failed" />
}

@code {
    private enum State { Loading, Ready, Failed }

    private State _state;

    /// <summary>Startup work run once before the content shows.</summary>
    [Parameter, EditorRequired]
    public Func<Task> Initialize { get; set; } = () => Task.CompletedTask;

    /// <summary>Content shown once <see cref="Initialize"/> completes.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var started = Stopwatch.GetTimestamp();
        try
        {
            await Initialize();
            _state = State.Ready;
            Log.Started(Logger, (long)Stopwatch.GetElapsedTime(started).TotalMilliseconds);
        }
        catch (Exception exception)
        {
            _state = State.Failed;
            Log.Failed(Logger, exception);
        }
    }
}
