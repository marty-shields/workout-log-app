@using Microsoft.Extensions.Logging
@using WorkoutLog.Core.Domain.Workouts
@using WorkoutLog.Core.Domain.Workouts.Validation
@using WorkoutLog.UI.Components.Inputs
@implements IDisposable
@inject ILogger<ExerciseCard> Logger
<section class="card @(Exercise.IsDone ? "done" : null) @(Exercise.Error is not null ? "has-error" : null)" data-testid="@TestId">
    <header class="card-header">
        <h2 class="name">@Exercise.Name</h2>
        <div class="actions">
            @if (Exercise.IsDone)
            {
                <IconButton Icon="IconName.Edit" AriaLabel="@($"Edit {Exercise.Name}")" TestId="@($"{TestId}-edit")" Muted OnClick="Reopen" />
            }
            else
            {
                <IconButton Icon="IconName.Check" AriaLabel="@($"Mark {Exercise.Name} done")" TestId="@($"{TestId}-done")" OnClick="Done" />
            }
            <IconButton @ref="remove" Icon="IconName.Delete" AriaLabel="@($"Delete {Exercise.Name}")" TestId="@($"{TestId}-remove")" Muted OnClick="OnRemove" />
        </div>
    </header>
    @if (!Exercise.IsDone && Exercise.BestKg is { } best)
    {
        <p class="weights" data-testid="@($"{TestId}-weights")"><span>Last @DisplayFormat.Weight(Exercise.LastKg)</span> <span aria-hidden="true">·</span> <span>PB @DisplayFormat.Weight(best)</span></p>
    }
    @if (Exercise.Error is not null)
    {
        <p class="error" role="alert" data-testid="@($"{TestId}-error")">@Exercise.Error</p>
    }
    @if (!Exercise.IsDone)
    {
        @if (Exercise.Kind == ExerciseKind.Strength)
        {
            <div class="sets">
                @if (SetGrid.Collapses(Exercise.Fields))
                {
                    @for (var i = 0; i < Exercise.Entries.Count; i++)
                    {
                        var entry = Exercise.Entries[i];
                        var number = i + 1;
                        if (entry == open)
                        {
                            <SetPanel @key="entry"
                                      @ref="openPanel"
                                      Number="number"
                                      ExerciseName="@Exercise.Name"
                                      Fields="Exercise.Fields"
                                      Entry="entry"
                                      Last="@(Exercise.LastTime?.EntryOrNull(number))"
                                      IsRecord="entry == Exercise.RecordEntry"
                                      OnChanged="() => EntryChanged(entry)"
                                      OnRemove="() => RemoveSet(entry)"
                                      TestId="@($"{TestId}-set-{number}")" />
                        }
                        else
                        {
                            <SetSummary @key="entry"
                                        @ref="summaries[entry]"
                                        Number="number"
                                        Fields="Exercise.Fields"
                                        Entry="entry"
                                        Last="@(Exercise.LastTime?.EntryOrNull(number))"
                                        IsRecord="entry == Exercise.RecordEntry"
                                        OnOpen="() => OpenSet(entry)"
                                        TestId="@($"{TestId}-set-{number}")" />
                        }
                    }
                }
                else
                {
                    @if (Exercise.Entries.Count > 0)
                    {
                        <div class="set-header" style="grid-template-columns: @SetGrid.Columns(Exercise.Fields, Exercise.LastTime is not null)" aria-hidden="true">
                            <span>Set</span>
                            @if (SetGrid.LastColumn(Exercise.Fields, Exercise.LastTime is not null))
                            {
                                <span>Last</span>
                            }
                            @foreach (var field in Exercise.Fields)
                            {
                                <span>@field.DisplayLabel@(field.Required ? " *" : null)</span>
                            }
                            <span></span>
                        </div>
                    }
                    @for (var i = 0; i < Exercise.Entries.Count; i++)
                    {
                        var entry = Exercise.Entries[i];
                        var number = i + 1;
                        <SetRow @key="entry"
                                @ref="rows[entry]"
                                Number="number"
                                ExerciseName="@Exercise.Name"
                                Fields="Exercise.Fields"
                                Entry="entry"
                                Last="@LastText(number)"
                                IsRecord="entry == Exercise.RecordEntry"
                                OnChanged="() => EntryChanged(entry)"
                                OnRemove="() => RemoveSet(entry)"
                                TestId="@($"{TestId}-set-{number}")" />
                    }
                }
            </div>
            <AppButton @ref="addSet" Variant="ButtonVariant.Secondary" FullWidth Disabled="Exercise.SetsFull" TestId="@($"{TestId}-add-set")" OnClick="AddSet">Add set</AppButton>
            @if (Exercise.SetsFull)
            {
                <p class="note" data-testid="@($"{TestId}-sets-full")">At most @WorkoutLimits.MaxSets sets</p>
            }
        }
        else if (Exercise.Entries.Count > 0)
        {
            var entry = Exercise.Entries[0];
            if (Exercise.LastTime?.EntryOrNull(1) is { } last)
            {
                <p class="last-time" data-testid="@($"{TestId}-last")">Last time @last</p>
            }
            <div class="cardio">
                @foreach (var field in Exercise.Fields)
                {
                    <FieldInput @ref="cardioFields[field.Key]" Field="field" Entry="entry" OnChanged="() => EntryChanged(entry)" TestId="@($"{TestId}-{field.Key}")" />
                }
            </div>
            @if (entry == Exercise.RecordEntry)
            {
                <RecordBadge TestId="@($"{TestId}-record")" />
            }
            @if (ExerciseFields.WorkedOutText(Exercise, entry) is { } workedOut)
            {
                <p class="note" data-testid="@($"{TestId}-worked-out")">@workedOut</p>
            }
            <EntryErrors Fields="Exercise.Fields" Entry="entry" TestId="@($"{TestId}-entry-error")" />
        }
    }
</section>

@code {
    /// <summary>The exercise and its sets or entry. Adding and removing sets changes it directly.</summary>
    [Parameter, EditorRequired]
    public ExerciseState Exercise { get; set; } = null!;

    /// <summary>Raised after a value, set or entry changes.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>Raised by the trash button, open or done.</summary>
    [Parameter]
    public EventCallback OnRemove { get; set; }

    /// <summary>Value of the card's data-testid; also the prefix for its controls.</summary>
    [Parameter]
    public string? TestId { get; set; }

    /// <summary>For sets that collapse: opens the last set when the card is given an exercise. An empty last set opens either way.</summary>
    [Parameter]
    public bool OpenLastSet { get; set; } = true;

    /// <summary>Checks the open set, or the last row, before Add set or opening another set, after filling its blanks (<see cref="ExerciseFields.FillBlanks"/>). Sets the set's errors and returns false to block. Also re-checks a set or entry on each change while it has errors or <see cref="EntryState.CheckOnChange"/> is set. Unset: nothing is blocked or re-checked.</summary>
    [Parameter]
    public Func<ExerciseState, EntryState, bool>? ValidateSet { get; set; }

    /// <summary>Checks the whole exercise before Done, as Save does. Sets its errors and returns false to block. Unset: nothing is blocked.</summary>
    [Parameter]
    public Func<ExerciseState, bool>? ValidateDone { get; set; }

    private ExerciseState? shown;
    private EntryState? open;
    private readonly Dictionary<EntryState, SetRow> rows = new();
    private readonly Dictionary<EntryState, SetSummary> summaries = new();
    private readonly Dictionary<string, FieldInput> cardioFields = new();
    private SetPanel? openPanel;
    private IconButton? remove;
    private AppButton? addSet;

    /// <summary>What the next render moves focus to: the set at fault when Add set or opening another set was blocked, the first error when Done was blocked, or the set just added.</summary>
    private enum FocusTarget
    {
        BlockedSet,
        FirstError,
        AddedSet,
    }

    /// <summary>The latest focus request. <c>Completion</c> is completed once focus has moved.</summary>
    private sealed record FocusRequest(FocusTarget Target, TaskCompletionSource? Completion = null);

    private FocusRequest? pending;

    /// <summary>Moves focus to the open set or the last set row (its first field with an error, or its first field), or the cardio entry.</summary>
    public ValueTask FocusAsync()
    {
        if (Exercise.Kind == ExerciseKind.Cardio)
        {
            return Exercise.Fields.Count > 0 && cardioFields.TryGetValue(Exercise.Fields[0].Key, out var first) ? first.FocusAsync() : ValueTask.CompletedTask;
        }

        if (SetGrid.Collapses(Exercise.Fields))
        {
            return open is not null && openPanel is not null ? openPanel.FocusAsync() : ValueTask.CompletedTask;
        }

        return Exercise.Entries.LastOrDefault() is { } last && rows.TryGetValue(last, out var row) ? row.FocusAsync() : ValueTask.CompletedTask;
    }

    /// <summary>
    /// Moves focus to the card's first error. An exercise error: Add set for <see cref="ExerciseError.NoSets"/>, otherwise Remove.
    /// Otherwise the first set or entry with errors: its first field at fault, or the summary line of a closed set.
    /// </summary>
    public ValueTask FocusFirstErrorAsync()
    {
        if (Exercise.Error is not null)
        {
            if (Exercise.ErrorCode == ExerciseError.NoSets)
            {
                return addSet?.FocusAsync() ?? ValueTask.CompletedTask;
            }

            return remove?.FocusAsync() ?? ValueTask.CompletedTask;
        }

        if (Exercise.Entries.FirstOrDefault(e => e.Errors.Count > 0) is not { } entry)
        {
            return ValueTask.CompletedTask;
        }

        if (Exercise.Kind == ExerciseKind.Cardio)
        {
            return Exercise.Fields.FirstOrDefault(f => entry.Errors.ContainsKey(f.Key)) is { } field && cardioFields.TryGetValue(field.Key, out var input)
                ? input.FocusAsync()
                : ValueTask.CompletedTask;
        }

        if (SetGrid.Collapses(Exercise.Fields))
        {
            if (entry == open)
            {
                return openPanel?.FocusAsync() ?? ValueTask.CompletedTask;
            }

            return summaries.TryGetValue(entry, out var summary) ? summary.FocusAsync() : ValueTask.CompletedTask;
        }

        return rows.TryGetValue(entry, out var row) ? row.FocusAsync() : ValueTask.CompletedTask;
    }

    /// <summary>
    /// Strength: adds a set as Add set does, then focuses the new set, or the first field at fault in the set that blocked it. Cardio: focuses the entry.
    /// Completes once focus has moved; fails if focusing fails; cancelled if called again or the card is removed first.
    /// </summary>
    public async Task AddSetAndFocusAsync()
    {
        if (Exercise.Kind == ExerciseKind.Strength && TryAddSet())
        {
            await OnChanged.InvokeAsync();
        }

        var focus = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        Request(new FocusRequest(FocusTarget.AddedSet, focus));
        StateHasChanged();
        await focus.Task;
    }

    public void Dispose() => pending?.Completion?.TrySetCanceled();

    private void Request(FocusRequest request)
    {
        if (request.Completion is null)
        {
            request = request with { Completion = pending?.Completion };
        }
        else
        {
            pending?.Completion?.TrySetCanceled();
        }

        pending = request;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pending is not { } request || (request.Target == FocusTarget.AddedSet && !FocusTargetRendered()))
        {
            return;
        }

        pending = null;
        try
        {
            await (request.Target == FocusTarget.FirstError ? FocusFirstErrorAsync() : FocusAsync());
            request.Completion?.TrySetResult();
        }
        catch (Exception exception)
        {
            if (request.Completion is { } completion)
            {
                completion.TrySetException(exception);
            }
            else
            {
                Log.FocusFailed(Logger, exception);
            }
        }
    }

    /// <summary>Whether the set or entry <see cref="FocusAsync"/> moves to has been rendered.</summary>
    private bool FocusTargetRendered()
    {
        if (Exercise.Kind == ExerciseKind.Cardio)
        {
            return Exercise.Fields.Count == 0 || cardioFields.ContainsKey(Exercise.Fields[0].Key);
        }

        if (SetGrid.Collapses(Exercise.Fields))
        {
            return open is null || openPanel?.Entry == open;
        }

        return Exercise.Entries.LastOrDefault() is not { } last || rows.ContainsKey(last);
    }

    protected override void OnParametersSet()
    {
        if (Exercise == shown)
        {
            return;
        }

        shown = Exercise;
        var last = Exercise.Entries.LastOrDefault();
        open = last is not null && (OpenLastSet || last.Values.Values.All(string.IsNullOrEmpty)) ? last : null;
    }

    private string? LastText(int number) =>
        SetGrid.LastBelow(Exercise.Fields) ? Exercise.LastTime?.EntryOrNull(number) : Exercise.LastTime?.Entry(number);

    private bool CanLeave(EntryState? entry)
    {
        if (entry is null || ValidateSet is null)
        {
            return true;
        }

        ExerciseFields.FillBlanks(Exercise, entry);
        var valid = ValidateSet(Exercise, entry);
        entry.CheckOnChange = !valid;
        return valid;
    }

    private void Done()
    {
        if (ValidateDone is null || ValidateDone(Exercise))
        {
            Exercise.IsDone = true;
            rows.Clear();
            summaries.Clear();
            cardioFields.Clear();
            openPanel = null;
            addSet = null;
            return;
        }

        Request(new FocusRequest(FocusTarget.FirstError));
    }

    private void Reopen() => Exercise.IsDone = false;

    private void OpenSet(EntryState entry)
    {
        if (CanLeave(open))
        {
            open = entry;
            return;
        }

        Request(new FocusRequest(FocusTarget.BlockedSet));
    }

    private Task AddSet()
    {
        if (TryAddSet())
        {
            return OnChanged.InvokeAsync();
        }

        if (!Exercise.SetsFull)
        {
            Request(new FocusRequest(FocusTarget.BlockedSet));
        }

        return Task.CompletedTask;
    }

    /// <summary>Adds an empty set and opens it, unless the sets are full or the open set or the last row fails the check.</summary>
    private bool TryAddSet()
    {
        if (Exercise.SetsFull)
        {
            return false;
        }

        var current = SetGrid.Collapses(Exercise.Fields) ? open : Exercise.Entries.LastOrDefault();
        if (!CanLeave(current))
        {
            return false;
        }

        var entry = new EntryState();
        Exercise.Entries.Add(entry);
        Exercise.Error = null;
        Exercise.ErrorCode = null;
        open = entry;
        return true;
    }

    private Task EntryChanged(EntryState entry)
    {
        if ((entry.Errors.Count > 0 || entry.CheckOnChange) && ValidateSet is not null && !ValidateSet(Exercise, entry))
        {
            entry.CheckOnChange = true;
        }

        return OnChanged.InvokeAsync();
    }

    private Task RemoveSet(EntryState entry)
    {
        Exercise.Entries.Remove(entry);
        rows.Remove(entry);
        summaries.Remove(entry);
        if (entry == open)
        {
            open = null;
        }

        return OnChanged.InvokeAsync();
    }
}
