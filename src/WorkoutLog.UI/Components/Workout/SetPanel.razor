@using WorkoutLog.UI.Models.Fields
<Card Title="@($"Set {Number}")" HeadingLevel="3" Selected TestId="@TestId" ChildContent="Body">
    <HeaderActions>
        @if (IsRecord)
        {
            <SuccessBadge Text="Record" TestId="@($"{TestId}-record")" />
        }
        <IconButton Icon="IconName.Close" AriaLabel="@RemoveLabel" TestId="@($"{TestId}-remove")" Muted Size="IconSize.Small" OnClick="OnRemove" />
    </HeaderActions>
</Card>

@code {
    private RenderFragment Body =>
        @<div class="body">
            @if (Last is not null)
            {
                <Typography Variant="TextVariant.MutedSmall" As="TextElement.P" TestId="@($"{TestId}-last")">Last time @Last</Typography>
            }
            <div class="fields">
                @foreach (var spec in Fields)
                {
                    <div class="@(spec.Kind == FieldKind.Duration ? "wide" : null)">
                        <ValueField @ref="fields[spec.Key]"
                                    Kind="spec.ValueKind"
                                    Label="@spec.DisplayLabel"
                                    Required="spec.Required"
                                    Invalid="Entry.Errors.ContainsKey(spec.Key)"
                                    Value="@Entry.Values.GetValueOrDefault(spec.Key)"
                                    ValueChanged="value => Change(spec, value)"
                                    OnEnter="@(spec == Fields[^1] ? OnEnterLast : default)"
                                    TestId="@($"{TestId}-{spec.Key}")" />
                    </div>
                }
            </div>
            <InlineAlert Messages="Entry.ErrorMessages(Fields)" TestId="@($"{TestId}-error")" />
        </div>;

    /// <summary>Set number, from 1.</summary>
    [Parameter, EditorRequired]
    public int Number { get; set; }

    /// <summary>Name of the exercise, read out by the remove button, e.g. Remove Squat set 2.</summary>
    [Parameter]
    public string? ExerciseName { get; set; }

    /// <summary>Fields of the set, in display order. Duration takes the full width.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<FieldSpec> Fields { get; set; } = [];

    /// <summary>Values of the set.</summary>
    [Parameter, EditorRequired]
    public EntryState Entry { get; set; } = null!;

    /// <summary>Last time's text for this set (<see cref="LastTime.Entry"/>), in a small line under the title. Null leaves it out.</summary>
    [Parameter]
    public string? Last { get; set; }

    /// <summary>Shows the Record badge next to the title.</summary>
    [Parameter]
    public bool IsRecord { get; set; }

    /// <summary>Raised after a value changes.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>Raised when Enter is pressed in the last field.</summary>
    [Parameter]
    public EventCallback OnEnterLast { get; set; }

    /// <summary>Raised by the remove button.</summary>
    [Parameter]
    public EventCallback OnRemove { get; set; }

    /// <summary>Value of the data-testid attribute.</summary>
    [Parameter]
    public string? TestId { get; set; }

    private readonly Dictionary<string, ValueField> fields = new();

    /// <summary>Moves focus to the first field with an error, or the first field.</summary>
    public ValueTask FocusAsync() =>
        (Fields.FirstOrDefault(f => Entry.Errors.ContainsKey(f.Key)) ?? Fields.FirstOrDefault()) is { } field && fields.TryGetValue(field.Key, out var input)
            ? input.FocusAsync()
            : ValueTask.CompletedTask;

    private Task Change(FieldSpec field, string? value)
    {
        Entry.Values[field.Key] = value;
        return OnChanged.InvokeAsync();
    }

    private string RemoveLabel => ExerciseName is null ? $"Remove set {Number}" : $"Remove {ExerciseName} set {Number}";
}
