@using WorkoutLog.UI.Components.Inputs
@using System.Globalization
@using WorkoutLog.UI.Models.Fields
@if (Field.Kind == FieldKind.Duration)
{
    <DurationField @ref="duration"
                   Label="@Field.DisplayLabel"
                   ShowLabel="ShowLabel"
                   Required="Field.Required"
                   Invalid="Invalid"
                   Value="@CurrentValue"
                   ValueChanged="OnValueChanged"
                   TestId="@TestId" />
}
else
{
    <NumberField @ref="number"
                 Label="@Field.DisplayLabel"
                 ShowLabel="ShowLabel"
                 Required="Field.Required"
                 AllowDecimal="@(Field.Kind == FieldKind.Decimal)"
                 Invalid="Invalid"
                 Value="@NumberValue"
                 TextChanged="OnTextChanged"
                 OnEnter="OnEnter"
                 TestId="@TestId" />
}

@code {
    /// <summary>Field to show.</summary>
    [Parameter, EditorRequired]
    public FieldSpec Field { get; set; } = null!;

    /// <summary>Set or entry the value is read from and written to.</summary>
    [Parameter, EditorRequired]
    public EntryState Entry { get; set; } = null!;

    /// <summary>Shows the label. When false it is kept for screen readers only.</summary>
    [Parameter]
    public bool ShowLabel { get; set; } = true;

    /// <summary>Raised after the value changes.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>Raised when Enter is pressed in a number input. A duration ignores it.</summary>
    [Parameter]
    public EventCallback OnEnter { get; set; }

    /// <summary>data-testid of the input, or the prefix for duration boxes.</summary>
    [Parameter]
    public string? TestId { get; set; }

    private DurationField? duration;
    private NumberField? number;
    private string? typedText;

    /// <summary>Moves focus to the input, or the first box of a duration.</summary>
    public ValueTask FocusAsync() => duration?.FocusAsync() ?? number?.FocusAsync() ?? ValueTask.CompletedTask;

    private string? CurrentValue => Entry.Values.GetValueOrDefault(Field.Key);

    private bool Invalid => Entry.Errors.ContainsKey(Field.Key);

    // The entry keeps the typed text, which the checker reads, so the kit's number is only for display.
    // Text typed in this box is parsed as the kit parses it: if they differed, the kit would replace what the user typed.
    // Text from an earlier box (a set opened again) shows only when it is a valid number, so the box never shows a
    // number that differs from the entry. Rejected text shows empty: the kit's number cannot show raw text.
    private decimal? NumberValue =>
        CurrentValue is null ? null
        : CurrentValue == typedText ? KitParse(CurrentValue)
        : FieldReader.Read(Field, CurrentValue) is ({ } value, null) ? value : null;

    private static decimal? KitParse(string text) =>
        decimal.TryParse(text.Trim().Replace(',', '.'), NumberStyles.AllowDecimalPoint | NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out var number) ? number : null;

    private Task OnTextChanged(string text)
    {
        typedText = string.IsNullOrEmpty(text) ? null : text;
        return OnValueChanged(typedText);
    }

    private Task OnValueChanged(string? value)
    {
        Entry.Values[Field.Key] = value;
        return OnChanged.InvokeAsync();
    }
}
