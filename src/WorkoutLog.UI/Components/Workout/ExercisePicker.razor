@using WorkoutLog.Core.Domain.Exercises
@using WorkoutLog.UI.Navigation

<div class="overlay" role="dialog" aria-modal="true" aria-label="Add exercise" data-testid="exercise-picker">
    <BackHandler OnBack="OnClose" />
    <header class="picker-bar">
        <IconButton Icon="IconName.Back" AriaLabel="Back" TestId="picker-back" OnClick="OnClose" />
        <input @ref="search"
               type="search"
               class="search"
               placeholder="Search exercises"
               aria-label="Search exercises"
               autocomplete="off"
               maxlength="@ExerciseCatalog.MaxQueryLength"
               value="@Query"
               data-testid="picker-search"
               @oninput="OnInput" />
    </header>
    <div class="results">
        @if (Items.Count == 0)
        {
            <p class="none" data-testid="picker-none">No exercises match</p>
        }
        else if (string.IsNullOrWhiteSpace(Query))
        {
            @foreach (var kind in Enum.GetValues<ExerciseKind>())
            {
                <h2 class="group" data-testid="@($"picker-group-{kind}")">@kind</h2>
                <ul class="list">
                    @foreach (var item in Items.Where(item => item.Kind == kind))
                    {
                        @RenderItem(item)
                    }
                </ul>
            }
        }
        else
        {
            <ul class="list">
                @foreach (var item in Items)
                {
                    @RenderItem(item)
                }
            </ul>
        }
    </div>
</div>

@code {
    /// <summary>Search text.</summary>
    [Parameter]
    public string? Query { get; set; }

    /// <summary>Raised on each keystroke with the new search text, at most <see cref="ExerciseCatalog.MaxQueryLength"/> characters.</summary>
    [Parameter]
    public EventCallback<string> QueryChanged { get; set; }

    /// <summary>Exercises to list, already filtered and ordered for <see cref="Query"/>. With no search text they are grouped Strength / Cardio.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<PickerItem> Items { get; set; } = [];

    /// <summary>Raised when an exercise is tapped.</summary>
    [Parameter]
    public EventCallback<PickerItem> OnPick { get; set; }

    /// <summary>Raised by the back arrow and the Android back button.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private ElementReference search;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await search.FocusAsync();
        }
    }

    private Task OnInput(ChangeEventArgs e)
    {
        var text = e.Value as string ?? "";
        return QueryChanged.InvokeAsync(text.Length > ExerciseCatalog.MaxQueryLength ? text[..ExerciseCatalog.MaxQueryLength] : text);
    }

    private RenderFragment RenderItem(PickerItem item) =>
        @<li>
            <button type="button" class="item" data-testid="@($"picker-item-{item.Id}")" @onclick="() => OnPick.InvokeAsync(item)">
                <span>@item.Name</span>
                @if (!string.IsNullOrWhiteSpace(Query))
                {
                    <span class="kind">@item.Kind</span>
                }
            </button>
        </li>;
}
