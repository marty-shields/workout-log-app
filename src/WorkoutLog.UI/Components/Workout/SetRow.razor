@using WorkoutLog.UI.Components.Inputs
@using WorkoutLog.UI.Models.Fields
<div class="set-row" style="grid-template-columns: @SetGrid.Columns(Fields, Last is not null)" data-testid="@TestId">
    <span class="number">@Number</span>
    @if (Last is not null && !SetGrid.LastBelow(Fields))
    {
        <span class="last" data-testid="@($"{TestId}-last")"><span class="visually-hidden">Last time </span>@Last</span>
    }
    @foreach (var field in Fields)
    {
        <FieldInput @ref="fields[field.Key]" Field="field" Entry="Entry" ShowLabel="false" OnChanged="OnChanged" OnEnter="@(field == Fields[^1] ? OnEnterLast : default)" TestId="@($"{TestId}-{field.Key}")" />
    }
    <IconButton Icon="IconName.Close" AriaLabel="@RemoveLabel" TestId="@($"{TestId}-remove")" Muted Size="IconSize.Small" OnClick="OnRemove" />
</div>
@if (Last is not null && SetGrid.LastBelow(Fields))
{
    <p class="last-line" data-testid="@($"{TestId}-last")">Last time @Last</p>
}
@if (IsRecord)
{
    <div class="indent">
        <RecordBadge TestId="@($"{TestId}-record")" />
    </div>
}
@if (Entry.Errors.Count > 0)
{
    <div class="indent">
        <EntryErrors Fields="Fields" Entry="Entry" TestId="@($"{TestId}-error")" />
    </div>
}

@code {
    /// <summary>Set number, from 1.</summary>
    [Parameter, EditorRequired]
    public int Number { get; set; }

    /// <summary>Name of the exercise, read out by the remove button, e.g. Remove Squat set 2.</summary>
    [Parameter]
    public string? ExerciseName { get; set; }

    /// <summary>Fields of the set, one column each.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<FieldSpec> Fields { get; set; } = [];

    /// <summary>Values of the set.</summary>
    [Parameter, EditorRequired]
    public EntryState Entry { get; set; } = null!;

    /// <summary>Last time's text for this set (<see cref="LastTime.Entry"/>), in a muted Last column after the number, or for a duration row on a line under it. Null leaves it out.</summary>
    [Parameter]
    public string? Last { get; set; }

    /// <summary>Shows the Record badge under the row.</summary>
    [Parameter]
    public bool IsRecord { get; set; }

    /// <summary>Raised after a value changes.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>Raised when Enter is pressed in the last field.</summary>
    [Parameter]
    public EventCallback OnEnterLast { get; set; }

    /// <summary>Raised by the remove button.</summary>
    [Parameter]
    public EventCallback OnRemove { get; set; }

    /// <summary>Value of the data-testid attribute.</summary>
    [Parameter]
    public string? TestId { get; set; }

    private readonly Dictionary<string, FieldInput> fields = new();

    /// <summary>Moves focus to the first field with an error, or the first field.</summary>
    public ValueTask FocusAsync() =>
        (Fields.FirstOrDefault(f => Entry.Errors.ContainsKey(f.Key)) ?? Fields.FirstOrDefault()) is { } field && fields.TryGetValue(field.Key, out var input)
            ? input.FocusAsync()
            : ValueTask.CompletedTask;

    private string RemoveLabel => ExerciseName is null ? $"Remove set {Number}" : $"Remove {ExerciseName} set {Number}";
}
