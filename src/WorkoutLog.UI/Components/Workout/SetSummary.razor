@using WorkoutLog.UI.Models.Fields
<div class="summary" data-testid="@TestId">
    <button @ref="button" type="button" class="open @(Entry.Errors.Count > 0 ? "invalid" : null)" data-testid="@($"{TestId}-open")" @onclick="OnOpen">
        <span class="visually-hidden">Set </span>
        <span class="number">@Number</span>
        <span class="text">@Text</span>
        <span class="chevron"><Icon Name="IconName.Chevron" Tone="IconTone.Muted" Size="IconSize.Small" /></span>
    </button>
    @if (IsRecord)
    {
        <div class="indent">
            <RecordBadge TestId="@($"{TestId}-record")" />
        </div>
    }
    @if (Entry.Errors.Count > 0)
    {
        <div class="indent">
            <EntryErrors Fields="Fields" Entry="Entry" TestId="@($"{TestId}-error")" />
        </div>
    }
</div>

@code {
    /// <summary>Set number, from 1.</summary>
    [Parameter, EditorRequired]
    public int Number { get; set; }

    /// <summary>Fields of the set, in display order.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<FieldSpec> Fields { get; set; } = [];

    /// <summary>Values of the set.</summary>
    [Parameter, EditorRequired]
    public EntryState Entry { get; set; } = null!;

    /// <summary>Shows the Record badge under the line.</summary>
    [Parameter]
    public bool IsRecord { get; set; }

    /// <summary>Raised when the summary is tapped.</summary>
    [Parameter]
    public EventCallback OnOpen { get; set; }

    /// <summary>Value of the data-testid attribute.</summary>
    [Parameter]
    public string? TestId { get; set; }

    private ElementReference button;

    /// <summary>Moves focus to the summary line.</summary>
    public ValueTask FocusAsync() => button.FocusAsync();

    private string Text
    {
        get
        {
            var parts = Fields.Select(f => Part(f, Entry.Values.GetValueOrDefault(f.Key))).OfType<string>().ToList();
            return parts.Count == 0 ? "Empty" : string.Join(" · ", parts);
        }
    }

    private static string? Part(FieldSpec field, string? value)
    {
        if (value is null || !value.Any(char.IsDigit) || (field.HideZero && FieldReader.Read(field, value) is (0m, null)))
        {
            return null;
        }

        if (field.Kind == FieldKind.Duration)
        {
            return value;
        }

        return field.Unit is not null ? $"{value}{field.Unit}" : $"{value} {field.Label.ToLowerInvariant()}";
    }
}
