@using WorkoutLog.UI.Components.Inputs
@using WorkoutLog.UI.Models.Fields
<div class="summary" data-testid="@TestId">
    <div class="line">
        <h3 class="heading" data-wrap-ok>
            <span class="number">@Number</span> <span class="text">@Text</span>
        </h3>
        <div class="actions">
            <IconButton @ref="edit" Icon="IconName.Edit" AriaLabel="@(Label("Edit"))" TestId="@($"{TestId}-edit")" Muted Compact OnClick="OnOpen" />
            <IconButton Icon="IconName.Delete" AriaLabel="@(Label("Delete"))" TestId="@($"{TestId}-remove")" Muted Compact OnClick="OnRemove" />
        </div>
    </div>
    @if (IsRecord)
    {
        <RecordBadge TestId="@($"{TestId}-record")" />
    }
</div>

@code {
    /// <summary>Set number, from 1.</summary>
    [Parameter, EditorRequired]
    public int Number { get; set; }

    /// <summary>Fields of the set, in display order.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<FieldSpec> Fields { get; set; } = [];

    /// <summary>Values of the set.</summary>
    [Parameter, EditorRequired]
    public EntryState Entry { get; set; } = null!;

    /// <summary>Name of the exercise, read out by the buttons, e.g. Edit Squat set 2.</summary>
    [Parameter]
    public string? ExerciseName { get; set; }

    /// <summary>Shows the Record badge under the line.</summary>
    [Parameter]
    public bool IsRecord { get; set; }

    /// <summary>Raised by the pencil.</summary>
    [Parameter]
    public EventCallback OnOpen { get; set; }

    /// <summary>Raised by the trash.</summary>
    [Parameter]
    public EventCallback OnRemove { get; set; }

    /// <summary>Value of the data-testid attribute.</summary>
    [Parameter]
    public string? TestId { get; set; }

    private IconButton? edit;

    /// <summary>Moves focus to the pencil.</summary>
    public ValueTask FocusEditAsync() => edit?.FocusAsync() ?? ValueTask.CompletedTask;

    private string Label(string verb) => ExerciseName is null ? $"{verb} set {Number}" : $"{verb} {ExerciseName} set {Number}";

    private string Text
    {
        get
        {
            var parts = Fields.Select(f => Part(f, Entry.Values.GetValueOrDefault(f.Key))).OfType<string>().ToList();
            return parts.Count == 0 ? "Empty" : string.Join(" · ", parts);
        }
    }

    private static string? Part(FieldSpec field, string? value)
    {
        if (value is null || !value.Any(char.IsDigit) || (field.HideZero && FieldReader.Read(field, value) is (0m, null)))
        {
            return null;
        }

        if (field.Kind == FieldKind.Duration)
        {
            return value;
        }

        return field.Unit is not null ? $"{value}{field.Unit}" : $"{value} {field.Label.ToLowerInvariant()}";
    }
}
