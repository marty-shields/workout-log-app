<Card Title="Records this week" Compact="@(Records.Count > 0)" TestId="@TestId">
    @if (Records.Count == 0)
    {
        <Typography Variant="TextVariant.Muted" As="TextElement.P" TestId="@($"{TestId}-none")">No new records this week</Typography>
    }
    else
    {
        <ul class="rows">
            @foreach (var (record, index) in Records.Take(MaxRows).Select((record, index) => (record, index)))
            {
                <li>
                    <ListRow Text="@($"{record.Exercise} · {record.Best}")"
                             Detail="@record.Day.ToString()"
                             Divider="@(index < Math.Min(Records.Count, MaxRows) - 1 || Records.Count > MaxRows)"
                             OnClick="@(OnOpen.HasDelegate ? EventCallback.Factory.Create(this, () => OnOpen.InvokeAsync(record.ExerciseId)) : default)"
                             TestId="@($"{TestId}-row-{record.ExerciseId}")" />
                </li>
            }
        </ul>
        @if (Records.Count > MaxRows)
        {
            <div class="more">
                <Typography Variant="TextVariant.MutedSmall" As="TextElement.P" TestId="@($"{TestId}-more")">@(Records.Count - MaxRows) more</Typography>
            </div>
        }
    }
</Card>

@code {
    private const int MaxRows = 5;

    /// <summary>Records set this week, newest first. Up to five show, then "n more".</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<WeekRecord> Records { get; set; } = [];

    /// <summary>Raised with the exercise id when a row is tapped. Rows are not tappable when unset.</summary>
    [Parameter]
    public EventCallback<int> OnOpen { get; set; }

    /// <summary>Value of the data-testid attribute, and the prefix of its parts': <c>{TestId}-row-{exercise id}</c>, <c>{TestId}-more</c>, <c>{TestId}-none</c>.</summary>
    [Parameter]
    public string? TestId { get; set; }
}
