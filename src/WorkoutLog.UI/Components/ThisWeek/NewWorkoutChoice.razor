@using Shields.UI.Components.Overlays
@using WorkoutLog.Core.Services
@using WorkoutLog.UI.Models.ThisWeek
@inject IUnfinishedWorkoutService UnfinishedWorkout
@inject TimeProvider Clock

<Sheet Open="item is not null" Title="Workout in progress" OnClose="Close" TestId="new-unfinished">
    @if (item is not null)
    {
        <div class="choice">
            <Typography Variant="TextVariant.Body" As="TextElement.P" TestId="new-unfinished-message">
                You haven't finished the workout you started. Resume it, or discard it to start a new one: @item.Lost.
            </Typography>
            <AppButton FullWidth TestId="new-unfinished-resume" OnClick="ResumeAsync">Resume</AppButton>
            <AppButton Variant="ButtonVariant.Danger" FullWidth TestId="new-unfinished-discard" OnClick="DiscardAndStartAsync">Discard and start new</AppButton>
        </div>
    }
</Sheet>

@code {
    private UnfinishedItem? item;
    private bool busy;

    /// <summary>Raised when there is no unfinished workout, or after Discard and start new has discarded it.</summary>
    [Parameter]
    public EventCallback OnNew { get; set; }

    /// <summary>Raised by Resume.</summary>
    [Parameter]
    public EventCallback OnResume { get; set; }

    /// <summary>
    /// What every + button calls. Reads the unfinished workout afresh: with none it raises <see cref="OnNew"/>, with one it opens the sheet that offers
    /// Resume or Discard and start new, so a new workout never replaces it. If the read fails nothing happens, so a stored workout is never started over; Core logs it.
    /// </summary>
    public async Task AskAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            switch (await UnfinishedWorkout.GetSummaryAsync())
            {
                case NoUnfinishedWorkout:
                    await OnNew.InvokeAsync();
                    break;
                case UnfinishedSummary summary:
                    item = UnfinishedItem.From(summary, Clock.LocalTimeZone, Clock.GetUtcNow());
                    StateHasChanged();
                    break;
                case ReadFailed:
                    break;
            }
        }
        finally
        {
            busy = false;
        }
    }

    private void Close() => item = null;

    private async Task ResumeAsync()
    {
        item = null;
        await OnResume.InvokeAsync();
    }

    /// <summary>Discards the unfinished workout, then raises <see cref="OnNew"/>. A failed write keeps it and starts nothing; Core logs it.</summary>
    private async Task DiscardAndStartAsync()
    {
        item = null;
        if (await UnfinishedWorkout.DiscardAsync() == UnfinishedWrite.Done)
        {
            await OnNew.InvokeAsync();
        }
    }
}
