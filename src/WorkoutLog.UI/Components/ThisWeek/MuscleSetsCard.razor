@using WorkoutLog.UI.Models.Muscles
<Card Title="Sets per muscle group" Aside="@Period" TestId="@TestId">
    <BarList Items="Items" Inline Label="Sets per muscle group" EmptyText="No sets yet" TestIdBy="BarListTestIdBy.Slug"
             TestId="@(TestId is null ? null : $"{TestId}-rows")" />
</Card>

@code {
    /// <summary>The muscle groups with their sets for the week. Shown most sets first, so the groups at zero come last.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<MuscleGroupSets> Groups { get; set; } = [];

    /// <summary>Names the period at the right of the title, e.g. this month.</summary>
    [Parameter]
    public string Period { get; set; } = "this week";

    /// <summary>Value of the data-testid attribute, and the prefix of the bar list's, <c>{TestId}-rows</c>, whose rows are <c>{TestId}-rows-row-{group, lower case}</c>.</summary>
    [Parameter]
    public string? TestId { get; set; }

    private IReadOnlyList<BarListItem> Items =>
        [.. Groups.OrderByDescending(g => g.Sets).Select(g => new BarListItem(g.Group, g.Sets, g.Sets == 0 ? "Not trained" : DisplayFormat.Sets(g.Sets)))];
}
