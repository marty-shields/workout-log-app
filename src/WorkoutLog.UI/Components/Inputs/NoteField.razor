@using WorkoutLog.Core.Domain.Workouts
@using WorkoutLog.UI.Components.Actions
@{ textBoxShown = Editing; }
@if (Visible)
{
    <div class="note-field" data-testid="@TestId">
        @if (Editing)
        {
            <label class="field">
                <span class="heading">
                    <span class="label">@Label</span>
                    <span class="count @(Value?.Length > WorkoutLimits.MaxNoteLength ? "over" : null)" data-testid="@($"{TestId}-count")">@(Value?.Length ?? 0)/@WorkoutLimits.MaxNoteLength</span>
                </span>
                <textarea @ref="input"
                          rows="3"
                          class="input @(Error is not null ? "invalid" : null)"
                          aria-invalid="@(Error is not null ? "true" : null)"
                          aria-describedby="@(Error is not null ? ErrorId : null)"
                          data-testid="@($"{TestId}-input")"
                          value="@Value"
                          @oninput="OnInput"
                          @onblur="OnBlur"></textarea>
            </label>
        }
        else if (HasValue)
        {
            <button type="button" class="summary @(Error is not null ? "invalid" : null)" aria-describedby="@(Error is not null ? ErrorId : null)" data-testid="@($"{TestId}-open")" @onclick="FocusAsync">
                <span class="visually-hidden">Edit @Label: </span>
                <span class="text">@Value</span>
            </button>
        }
        else if (ShowAddButton)
        {
            <div class="add">
                <AppButton Variant="ButtonVariant.Link" TestId="@($"{TestId}-add")" OnClick="FocusAsync">Add note</AppButton>
            </div>
        }
        @if (Error is not null && (Editing || HasValue))
        {
            <p class="error" id="@ErrorId" role="alert" data-testid="@($"{TestId}-error")">@Error</p>
        }
    </div>
}
@code {
    /// <summary>Name of the note, shown above the text box and read out for the collapsed line.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>The note, or null when there is none.</summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>Raised on each keystroke with the text, or null when blank, and when the field collapses with the text trimmed.</summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Shows the text box. Set by the field when Add note or the collapsed line is tapped and when focus leaves; a parent may set it too.</summary>
    [Parameter]
    public bool Editing { get; set; }

    /// <summary>Raised when the field opens or collapses.</summary>
    [Parameter]
    public EventCallback<bool> EditingChanged { get; set; }

    /// <summary>Validation message. Shows under the text box or the collapsed line, and the text box turns invalid.</summary>
    [Parameter]
    public string? Error { get; set; }

    /// <summary>Shows Add note while there is no note and the text box is closed. A parent that has its own Add note turns it off.</summary>
    [Parameter]
    public bool ShowAddButton { get; set; } = true;

    /// <summary>data-testid of the field; also the prefix for its controls.</summary>
    [Parameter]
    public string? TestId { get; set; }

    private ElementReference input;
    private bool textBoxShown;
    private bool wasShown;
    private bool focusRequested;

    private string ErrorId => $"{TestId}-error";

    private bool Visible => Editing || HasValue || ShowAddButton;

    private bool HasValue => !string.IsNullOrWhiteSpace(Value);

    /// <summary>Opens the text box and moves focus into it.</summary>
    public async Task FocusAsync()
    {
        focusRequested = true;
        if (!Editing)
        {
            await SetEditingAsync(true);
        }

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var opened = textBoxShown && !wasShown && !firstRender;
        wasShown = textBoxShown;
        if (textBoxShown && (opened || focusRequested))
        {
            focusRequested = false;
            await input.FocusAsync();
        }
    }

    private async Task SetEditingAsync(bool editing)
    {
        Editing = editing;
        await EditingChanged.InvokeAsync(editing);
    }

    private Task OnInput(ChangeEventArgs e)
    {
        var text = e.Value as string;
        Value = string.IsNullOrWhiteSpace(text) ? null : text;
        return ValueChanged.InvokeAsync(Value);
    }

    private async Task OnBlur()
    {
        var trimmed = Value?.Trim();
        if (trimmed != Value)
        {
            Value = trimmed;
            await ValueChanged.InvokeAsync(trimmed);
        }

        await SetEditingAsync(false);
    }
}
