@typeparam TValue
<fieldset class="group" disabled="@Disabled" data-testid="@TestId">
    <legend class="legend">@Label</legend>
    @foreach (var option in Options)
    {
        var selected = EqualityComparer<TValue>.Default.Equals(option.Value, Value);
        <label class="option">
            <input type="radio"
                   class="radio"
                   name="@name"
                   checked="@selected"
                   data-testid="@option.TestId"
                   @onchange="() => ValueChanged.InvokeAsync(option.Value)" />
            <span class="dot" aria-hidden="true"></span>
            <span class="texts">
                <span class="text">@option.Label</span>
                @if (option.Hint is not null)
                {
                    <span class="hint">@option.Hint</span>
                }
            </span>
        </label>
    }
</fieldset>

@code {
    private readonly string name = $"radio-{Guid.NewGuid():N}";

    /// <summary>Question the choices answer, e.g. How to import.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>Choices, in order.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<RadioOption<TValue>> Options { get; set; } = [];

    /// <summary>Chosen value.</summary>
    [Parameter]
    public TValue? Value { get; set; }

    /// <summary>Raised with the value of the choice tapped.</summary>
    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    /// <summary>Disables every choice.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Value of the group's data-testid attribute.</summary>
    [Parameter]
    public string? TestId { get; set; }
}
