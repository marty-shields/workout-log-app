@typeparam TValue
<fieldset class="segments" data-testid="@TestId" @key="generation">
    <legend class="visually-hidden">@Label</legend>
    @foreach (var option in Options)
    {
        var selected = EqualityComparer<TValue>.Default.Equals(option.Value, Value);
        <label class="segment">
            <input type="radio"
                   class="radio"
                   name="@name"
                   checked="@selected"
                   aria-label="@option.AriaLabel"
                   data-testid="@option.TestId"
                   @onchange="() => Pick(option.Value)" />
            <span class="text">@option.Label</span>
        </label>
    }
</fieldset>

@code {
    private readonly string name = $"segment-{Guid.NewGuid():N}";
    private int generation;
    private bool picked;
    private TValue? pickedValue;

    private async Task Pick(TValue value)
    {
        pickedValue = value;
        picked = true;
        await ValueChanged.InvokeAsync(value);
    }

    /// <summary>Redraws the radios when the parent didn't take the tapped value, so the browser shows the chosen one.</summary>
    protected override void OnAfterRender(bool firstRender)
    {
        if (!picked)
        {
            return;
        }

        picked = false;
        if (!EqualityComparer<TValue>.Default.Equals(pickedValue, Value))
        {
            generation++;
            StateHasChanged();
        }
    }

    /// <summary>What the choices pick, e.g. Range. Read by screen readers only.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>Choices, in order. Hints are not shown.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<RadioOption<TValue>> Options { get; set; } = [];

    /// <summary>Chosen value. When it matches no option, no segment shows as chosen.</summary>
    [Parameter]
    public TValue? Value { get; set; }

    /// <summary>Raised with the value of the segment tapped.</summary>
    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    /// <summary>Value of the control's data-testid attribute.</summary>
    [Parameter]
    public string? TestId { get; set; }
}
