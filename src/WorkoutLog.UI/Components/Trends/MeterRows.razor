@if (Rows.Count == 0 || Rows.All(row => row.Value == 0))
{
    <p class="none" data-testid="@(TestId is null ? null : $"{TestId}-none")">@EmptyText</p>
}
else
{
    var most = Rows.Max(row => row.Value);
    <ul class="rows @(Wide ? "wide" : null)" aria-label="@AriaLabel" data-testid="@TestId">
        @foreach (var row in Rows)
        {
            <li class="row" data-testid="@(TestId is null ? null : $"{TestId}-{Slug(row.Label)}")">
                <span class="name">@row.Label</span>
                <span class="track" aria-hidden="true"><span class="fill" style="--share: @Share(row.Value, most)"></span></span>
                <span class="count">@row.Value<span class="visually-hidden">@($" {Unit}")</span></span>
            </li>
        }
    </ul>
}

@code {
    /// <summary>The rows in the order to show them. The longest bar is the biggest value.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<MeterRow> Rows { get; set; } = [];

    /// <summary>What the numbers count, for screen readers, e.g. sessions.</summary>
    [Parameter, EditorRequired]
    public string Unit { get; set; } = "";

    /// <summary>The accessible name of the list, e.g. Records set in each month of 2026.</summary>
    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = "";

    /// <summary>Shown in place of the rows when there are none or all are 0.</summary>
    [Parameter, EditorRequired]
    public string EmptyText { get; set; } = "";

    /// <summary>Makes the name column wide enough for exercise names; otherwise it fits three letters, e.g. Jan.</summary>
    [Parameter]
    public bool Wide { get; set; }

    /// <summary>Value of the data-testid attribute, the prefix of each row's (<c>{TestId}-{label, lower case, dashes for spaces}</c>) and <c>{TestId}-none</c>.</summary>
    [Parameter]
    public string? TestId { get; set; }

    private static string Slug(string label) => label.ToLowerInvariant().Replace(' ', '-');

    private static string Share(int value, int most) =>
        (most == 0 ? 0 : (double)value / most).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}
