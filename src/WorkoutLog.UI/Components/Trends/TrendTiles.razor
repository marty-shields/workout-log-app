@using WorkoutLog.Core.Domain.Workouts.Periods
@using WorkoutLog.UI.Components.Weekly
<section class="tiles" data-testid="@TestId">
    <div class="grid">
        <StatTile Label="Workouts" Value="@WeekMetric.Count(Totals.Workouts)" Change="WeekMetric.Change(Totals.Workouts - Earlier.Workouts, WeekMetric.Count)" TestId="@Id("workouts")" />
        <StatTile Label="Time" Value="@DisplayFormat.Minutes(Minutes(Totals))" Change="WeekMetric.Change(Minutes(Totals) - Minutes(Earlier), DisplayFormat.Minutes)" TestId="@Id("time")" />
        <StatTile Label="Sets" Value="@WeekMetric.Count(Totals.Sets)" Change="WeekMetric.Change(Totals.Sets - Earlier.Sets, WeekMetric.Count)" TestId="@Id("sets")" />
        <StatTile Label="Volume" Value="@DisplayFormat.Volume(Totals.VolumeKg, Kind)" Change="WeekMetric.Change(VolumeDirection, VolumeChange)" Caption="strength" TestId="@Id("volume")" />
    </div>
    <p class="against" data-testid="@(TestId is null ? null : $"{TestId}-against")">@Against</p>
</section>

@code {
    /// <summary>Picks the unit of the volume: kilograms for a week or month, tonnes for a year.</summary>
    [Parameter, EditorRequired]
    public PeriodKind Kind { get; set; }

    /// <summary>The period's totals, so far when it holds today.</summary>
    [Parameter, EditorRequired]
    public TrendTotals Totals { get; set; } = null!;

    /// <summary>The period before, up to the same point in it when this one holds today.</summary>
    [Parameter, EditorRequired]
    public TrendTotals Earlier { get; set; } = null!;

    /// <summary>What the changes are measured against, e.g. Against Monday to Wednesday last week.</summary>
    [Parameter, EditorRequired]
    public string Against { get; set; } = "";

    /// <summary>Value of the data-testid attribute, and the prefix of its parts': <c>{TestId}-workouts</c>, <c>-time</c>, <c>-sets</c>, <c>-volume</c> (each with <c>-change</c>), <c>{TestId}-against</c>.</summary>
    [Parameter]
    public string? TestId { get; set; }

    private static int Minutes(TrendTotals totals) => (int)totals.Time.TotalMinutes;

    private string? Id(string part) => TestId is null ? null : $"{TestId}-{part}";

    /// <summary>Which way the volume moved as the tile shows it: 0 when the figure shown rounds to nothing, so no arrow sits beside "0 t" or "0%".</summary>
    private int VolumeDirection
    {
        get
        {
            var difference = Totals.VolumeKg - Earlier.VolumeKg;
            var shown = Earlier.VolumeKg == 0
                ? Math.Round(Math.Abs(difference) / (Kind == PeriodKind.Year ? 1000m : 1m), MidpointRounding.AwayFromZero)
                : Math.Round(Math.Abs(difference) / Earlier.VolumeKg * 100m, MidpointRounding.AwayFromZero);
            return shown == 0 ? 0 : decimal.ToInt32(decimal.Sign(difference));
        }
    }

    /// <summary>The volume's change as a percentage of the earlier volume; with none earlier, as the volume gained, since a percentage of nothing is undefined.</summary>
    private string VolumeChange(int _)
    {
        var current = Totals.VolumeKg;
        var earlier = Earlier.VolumeKg;
        return earlier == 0
            ? DisplayFormat.Volume(Math.Abs(current - earlier), Kind)
            : DisplayFormat.PercentChange(current, earlier).TrimStart('+', '-');
    }
}
