@using WorkoutLog.UI.Components.ThisWeek
@if (Records.Count == 0)
{
    <p class="none" data-testid="@(TestId is null ? null : $"{TestId}-none")">@EmptyText</p>
}
else
{
    <ul class="rows">
        @foreach (var record in Records.Take(MaxRows))
        {
            <li>
                <ListRow Text="@($"{record.Exercise} · {record.Best}")"
                         Detail="@(record.When ?? record.Day.ToString())"
                         OnClick="@(OnOpen.HasDelegate ? EventCallback.Factory.Create(this, () => OnOpen.InvokeAsync(record.ExerciseId)) : default)"
                         TestId="@(TestId is null ? null : $"{TestId}-row-{record.ExerciseId}")" />
            </li>
        }
    </ul>
    @if (Records.Count > MaxRows)
    {
        <p class="more" data-testid="@(TestId is null ? null : $"{TestId}-more")">@(Records.Count - MaxRows) more</p>
    }
}

@code {
    private const int MaxRows = 5;

    /// <summary>Records set in the period, newest first. Up to five show, then "n more".</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<WeekRecord> Records { get; set; } = [];

    /// <summary>Shown when there are no records, e.g. No new records this month.</summary>
    [Parameter, EditorRequired]
    public string EmptyText { get; set; } = "";

    /// <summary>Raised with the exercise id when a row is tapped. Rows are not tappable when unset.</summary>
    [Parameter]
    public EventCallback<int> OnOpen { get; set; }

    /// <summary>Prefix of the parts' data-testid attributes: <c>{TestId}-row-{exercise id}</c>, <c>{TestId}-more</c>, <c>{TestId}-none</c>.</summary>
    [Parameter]
    public string? TestId { get; set; }
}
