@using System.Globalization
<div class="calendar" data-testid="@TestId">
    <div class="heads" aria-hidden="true">
        @foreach (var initial in "MTWTFSS")
        {
            <span>@initial</span>
        }
    </div>
    <ul class="days" aria-label="@($"Days in {Month.ToString("MMMM yyyy", CultureInfo.InvariantCulture)}")">
        @for (var day = 1; day <= DateTime.DaysInMonth(Month.Year, Month.Month); day++)
        {
            var date = new DateOnly(Month.Year, Month.Month, day);
            var trained = Trained.Contains(date);
            var today = date == Today;
            var future = date > Today;
            <li class="day @(trained ? "done" : null) @(today ? "today" : null) @(future ? "future" : null)"
                style="@(day == 1 ? $"grid-column-start: {Column(date)}" : null)"
                aria-current="@(today ? "date" : null)"
                data-testid="@(TestId is null ? null : $"{TestId}-{day}")">
                @if (trained && OnOpenDay.HasDelegate)
                {
                    <button type="button" class="tap" data-testid="@(TestId is null ? null : $"{TestId}-{day}-open")" @onclick="() => OnOpenDay.InvokeAsync(date)">
                        <span class="dot" aria-hidden="true">@day</span>
                        <span class="visually-hidden">@Describe(date, trained, today, future), open workouts</span>
                    </button>
                }
                else
                {
                    <span class="dot" aria-hidden="true">@day</span>
                    <span class="visually-hidden">@Describe(date, trained, today, future)</span>
                }
            </li>
        }
    </ul>
    <ChartLegend Items="Legend" TestId="@(TestId is null ? null : $"{TestId}-legend")" />
</div>

@code {
    /// <summary>Any day of the month to show.</summary>
    [Parameter, EditorRequired]
    public DateOnly Month { get; set; }

    /// <summary>Today: it gets a ring, and the days after it are dimmed. A date after the month dims none and rings none; one before it dims every day.</summary>
    [Parameter, EditorRequired]
    public DateOnly Today { get; set; }

    /// <summary>Days with a workout; each is a solid circle. Other days are a dashed circle.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyCollection<DateOnly> Trained { get; set; } = [];

    /// <summary>Raised with the day when a day with a workout is tapped. Days are not tappable when unset.</summary>
    [Parameter]
    public EventCallback<DateOnly> OnOpenDay { get; set; }

    /// <summary>Value of the data-testid attribute, and the prefix of each day's: <c>{TestId}-1</c> to <c>{TestId}-31</c>, <c>{TestId}-1-open</c> on the button of a tappable day, and <c>{TestId}-legend</c>.</summary>
    [Parameter]
    public string? TestId { get; set; }

    private static readonly IReadOnlyList<LegendItem> Legend =
    [
        new(LegendSwatch.Accent, "Trained"),
        new(LegendSwatch.Outline, "No workout"),
        new(LegendSwatch.Outline, "Today", "◯"),
    ];

    /// <summary>The grid column of the 1st: Monday is 1.</summary>
    private static int Column(DateOnly date) => ((int)date.DayOfWeek + 6) % 7 + 1;

    private static string Describe(DateOnly date, bool trained, bool today, bool future)
    {
        var state = trained ? "trained" : future ? "coming up" : "no workout";
        return $"{date.ToString("dddd d MMMM", CultureInfo.InvariantCulture)}, {state}{(today ? ", today" : "")}";
    }
}
