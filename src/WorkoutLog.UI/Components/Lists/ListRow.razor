@if (OnClick.HasDelegate)
{
    <button type="button" class="row clickable @(Detail is not null ? "two-line" : null)" data-testid="@TestId" @onclick="OnClick">
        @Texts
        @if (Aside is not null)
        {
            <span class="aside">@Aside</span>
        }
        <span class="chevron"><Icon Name="IconName.Chevron" Tone="IconTone.Muted" /></span>
    </button>
}
else
{
    <div class="row @(Detail is not null ? "two-line" : null)" data-testid="@TestId">
        @Texts
        @if (Aside is not null)
        {
            <span class="aside">@Aside</span>
        }
    </div>
}

@code {
    /// <summary>Row text.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = "";

    /// <summary>Muted second line under the text.</summary>
    [Parameter]
    public string? Detail { get; set; }

    /// <summary>Muted text at the right, before the chevron.</summary>
    [Parameter]
    public string? Aside { get; set; }

    /// <summary>Raised when the row is tapped. The row is not tappable when unset.</summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>Value of the data-testid attribute.</summary>
    [Parameter]
    public string? TestId { get; set; }

    private RenderFragment Texts =>
        @<span class="texts">
            <span class="text">@Text</span>
            @if (Detail is not null)
            {
                <span class="detail">@Detail</span>
            }
        </span>;
}
