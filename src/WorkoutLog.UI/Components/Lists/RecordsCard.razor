<Card Title="Records" Aside="@Range" Compact TestId="@TestId">
    @foreach (var (row, index) in Rows.Select((row, index) => (row, index)))
    {
        <ListRow Layout="ListRowLayout.Headline" Text="@row.Label" Aside="@(row.Value ?? "—")" Detail="@(row.Value is null ? null : row.Date)" Divider="@(index < Rows.Count - 1)" />
    }
</Card>

@code {
    /// <summary>Range the records cover, e.g. last 3 months.</summary>
    [Parameter, EditorRequired]
    public string Range { get; set; } = "";

    /// <summary>Records, in order.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<RecordRow> Rows { get; set; } = [];

    /// <summary>Value of the data-testid attribute.</summary>
    [Parameter]
    public string? TestId { get; set; }
}
