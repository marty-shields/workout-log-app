@using WorkoutLog.UI.Models.Exercises
@if (Items.Count == 0)
{
    <div class="none">
        <Typography Variant="TextVariant.Muted" As="TextElement.P" TestId="@($"{TestId}-none")">No exercises match</Typography>
    </div>
}
else if (!Items.Grouped)
{
    @RenderRows(Items.Other)
}
else
{
    @RenderGroup("Recent Exercises", Items.Recent, "recent")
    @RenderGroup("Other Exercises", Items.Other, "other")
}

@code {
    /// <summary>
    /// Exercises to list, already searched and filtered, in order. A group with no rows is left out with its header;
    /// with <see cref="ExerciseListGroups.Grouped"/> false there are no headers.
    /// </summary>
    [Parameter, EditorRequired]
    public ExerciseListGroups Items { get; set; } = ExerciseListGroups.None;

    /// <summary>Raised when a row is tapped. Rows are not tappable when unset.</summary>
    [Parameter]
    public EventCallback<ExerciseListItem> OnPick { get; set; }

    /// <summary>Prefix of the data-testid attributes, e.g. add-exercise gives add-exercise-row-{id}, add-exercise-group-recent and add-exercise-none.</summary>
    [Parameter, EditorRequired]
    public string TestId { get; set; } = "";

    private RenderFragment RenderGroup(string title, IReadOnlyList<ExerciseListItem> rows, string key) =>
        rows.Count == 0
            ? @<text></text>
            : @<section class="group">
                  <SectionHeader Title="@title" Total="@rows.Count.ToString()" Sticky TestId="@($"{TestId}-group-{key}")" />
                  @RenderRows(rows)
              </section>;

    private RenderFragment RenderRows(IReadOnlyList<ExerciseListItem> rows) =>
        @<ul class="rows">
            @foreach (var item in rows)
            {
                @RenderItem(item)
            }
        </ul>;

    private RenderFragment RenderItem(ExerciseListItem item) =>
        @<li>
            <ListRow Text="@item.Name"
                     Detail="@(item.Last is null ? null : $"Last {item.Last}")"
                     Aside="@item.Kind.ToString()"
                     OnClick="@(OnPick.HasDelegate ? EventCallback.Factory.Create(this, () => OnPick.InvokeAsync(item)) : default)"
                     TestId="@($"{TestId}-row-{item.Id}")" />
        </li>;
}
