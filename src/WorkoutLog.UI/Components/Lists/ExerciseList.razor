@using WorkoutLog.UI.Models.Exercises
@if (Items.Count == 0)
{
    <p class="none" data-testid="@($"{TestId}-none")">No exercises match</p>
}
else
{
    <ul class="rows">
        @foreach (var item in Items)
        {
            @RenderItem(item)
        }
    </ul>
}

@code {
    /// <summary>Exercises to list, already searched and filtered, in order.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ExerciseListItem> Items { get; set; } = [];

    /// <summary>Raised when a row is tapped. Rows are not tappable when unset.</summary>
    [Parameter]
    public EventCallback<ExerciseListItem> OnPick { get; set; }

    /// <summary>Prefix of the data-testid attributes, e.g. exercises gives exercises-row-{id} and exercises-none.</summary>
    [Parameter, EditorRequired]
    public string TestId { get; set; } = "";

    private RenderFragment RenderItem(ExerciseListItem item) =>
        @<li>
            <ListRow Text="@item.Name"
                     Detail="@(item.Last is null ? null : $"Last {item.Last}")"
                     Aside="@item.Kind.ToString()"
                     OnClick="@(OnPick.HasDelegate ? EventCallback.Factory.Create(this, () => OnPick.InvokeAsync(item)) : default)"
                     TestId="@($"{TestId}-row-{item.Id}")" />
        </li>;
}
