<button @ref="button"
        type="button"
        class="btn @VariantClass @(FullWidth ? "full" : null) @(Busy ? "busy" : null)"
        disabled="@Disabled"
        aria-busy="@(Busy ? "true" : null)"
        data-testid="@TestId"
        @onclick="ClickAsync">
    @if (Busy)
    {
        <span class="ring" aria-hidden="true"></span>
    }
    @ChildContent
</button>

@code {
    /// <summary>Visual weight of the button.</summary>
    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;

    /// <summary>Stretches the button to fill its container.</summary>
    [Parameter]
    public bool FullWidth { get; set; }

    /// <summary>Disables the button.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Shows a spinner beside the text and ignores taps. The caller sets the text, e.g. Exporting…</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Value of the data-testid attribute.</summary>
    [Parameter]
    public string? TestId { get; set; }

    /// <summary>Raised when the button is tapped, unless it is busy.</summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>Button text.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private ElementReference button;

    /// <summary>Moves focus to the button.</summary>
    public ValueTask FocusAsync() => button.FocusAsync();

    private Task ClickAsync() => Busy ? Task.CompletedTask : OnClick.InvokeAsync();

    private string VariantClass => Variant switch
    {
        ButtonVariant.Secondary => "secondary",
        ButtonVariant.Danger => "danger",
        _ => "primary",
    };
}
