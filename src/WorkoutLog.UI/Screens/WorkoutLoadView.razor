@using WorkoutLog.UI.Components.Feedback
<AppScreen Title="Workout" OnBack="OnBack">
    @if (NotFound)
    {
        <EmptyState Message="This workout no longer exists" TestId="workout-not-found" />
    }
    else if (Failed)
    {
        <LoadFailed Message="Couldn't load the workout" OnRetry="OnRetry" TestId="workout-load" />
    }
    else
    {
        <div class="centre">
            <Spinner Label="Loading…" TestId="workout-loading" />
        </div>
    }
</AppScreen>

@code {
    /// <summary>Shows the load error and Try again instead of the spinner, and moves focus to Try again.</summary>
    [Parameter]
    public bool Failed { get; set; }

    /// <summary>Shows that the workout doesn't exist. Takes precedence over <see cref="Failed"/>.</summary>
    [Parameter]
    public bool NotFound { get; set; }

    /// <summary>Raised by Try again.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    /// <summary>Raised by the back arrow and the Android back button.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }
}
