@using Microsoft.Extensions.Logging
@using WorkoutLog.UI.Components.Feedback
@inject ILogger<WorkoutLoadView> Logger
<AppScreen Title="Workout" OnBack="OnBack">
    @if (NotFound)
    {
        <EmptyState Message="This workout no longer exists." TestId="workout-not-found" />
    }
    else if (Failed)
    {
        <div class="failed">
            <p class="error" role="alert" data-testid="workout-load-error">Couldn't load the workout.</p>
            <AppButton @ref="retry" Variant="ButtonVariant.Secondary" FullWidth TestId="workout-retry" OnClick="OnRetry">Try again</AppButton>
        </div>
    }
    else
    {
        <div class="centre">
            <Spinner Label="Loading…" TestId="workout-loading" />
        </div>
    }
</AppScreen>

@code {
    /// <summary>Shows the load error and Try again instead of the spinner, and moves focus to Try again.</summary>
    [Parameter]
    public bool Failed { get; set; }

    /// <summary>Shows that the workout doesn't exist. Takes precedence over <see cref="Failed"/>.</summary>
    [Parameter]
    public bool NotFound { get; set; }

    /// <summary>Raised by Try again.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    /// <summary>Raised by the back arrow and the Android back button.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    private AppButton? retry;
    private bool shownFailed;
    private bool focusRetry;

    protected override void OnParametersSet()
    {
        var showsFailed = Failed && !NotFound;
        focusRetry |= showsFailed && !shownFailed;
        shownFailed = showsFailed;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusRetry || retry is null)
        {
            return;
        }

        focusRetry = false;
        try
        {
            await retry.FocusAsync();
        }
        catch (Exception exception)
        {
            Log.RetryFocusFailed(Logger, exception);
        }
    }
}
