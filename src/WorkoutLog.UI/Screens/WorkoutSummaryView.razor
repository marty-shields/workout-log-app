@using Shields.UI.Components.Navigation
@using WorkoutLog.UI.Models.Summary
<BackHandler OnBack="OnDone" />
<AppScreen Title="Workout saved">
    <ChildContent>
        @if (Loading)
        {
            <div class="centre">
                <Spinner Label="Loading…" TestId="summary-loading" />
            </div>
        }
        else if (Failed)
        {
            <LoadFailed RetryVariant="ButtonVariant.Secondary" Message="Couldn't load the summary" OnRetry="OnRetry" TestId="summary" />
        }
        else if (Summary is { } summary)
        {
            <div class="sections">
                <div class="stats" data-testid="summary-stats">
                    <StatTile Compact Label="Duration" Value="@DisplayFormat.Duration(summary.Duration)" TestId="summary-duration" />
                    <StatTile Compact Label="Exercises" Value="@summary.Exercises.ToString()" TestId="summary-exercises" />
                    <StatTile Compact Label="Sets" Value="@summary.Sets.ToString()" TestId="summary-sets" />
                </div>
                @if (summary.IsFirstWorkout)
                {
                    <Card TestId="summary-first-workout">
                        <Typography Variant="TextVariant.Muted" As="TextElement.P" data-wrap-ok>Your first workout. Records and changes show from your next one.</Typography>
                    </Card>
                }
                else
                {
                    <Card Title="Records" Compact="@(summary.Records.Count > 0)" TestId="summary-records">
                        @if (summary.Records.Count == 0)
                        {
                            <Typography Variant="TextVariant.Muted" As="TextElement.P" TestId="summary-records-none">No records this time</Typography>
                        }
                        else
                        {
                            <ul class="rows">
                                @foreach (var (record, index) in summary.Records.Select((record, index) => (record, index)))
                                {
                                    <li>
                                        <ListRow Text="@($"{record.Exercise} · {record.Best}")" Divider="@(index < summary.Records.Count - 1)" TestId="@($"summary-record-{record.ExerciseId}")">
                                            <Leading><Icon Name="IconName.Record" Tone="IconTone.Success" /></Leading>
                                        </ListRow>
                                    </li>
                                }
                            </ul>
                        }
                    </Card>
                    @if (summary.Changes.Count > 0)
                    {
                        <Card Title="Since last time" Compact TestId="summary-changes">
                            <ul class="rows">
                                @foreach (var (change, index) in summary.Changes.Select((change, index) => (change, index)))
                                {
                                    <li>
                                        <ListRow Text="@change.Exercise" Detail="@change.Best" Aside="@(change.Since.Kind == ChangeKind.FirstTime ? "First time" : null)"
                                                 Change="Since(change.Since)" Divider="@(index < summary.Changes.Count - 1)" TestId="@($"summary-change-{change.ExerciseId}")" />
                                    </li>
                                }
                            </ul>
                        </Card>
                    }
                }
            </div>
        }
    </ChildContent>
    <BottomBar>
        <AppButton FullWidth TestId="done" OnClick="OnDone">Done</AppButton>
    </BottomBar>
</AppScreen>

@code {
    /// <summary>The saved workout's totals, records and changes. Not shown while <see cref="Loading"/> or <see cref="Failed"/>.</summary>
    [Parameter]
    public WorkoutSummary? Summary { get; set; }

    /// <summary>Shows a spinner instead of the summary while it loads.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Shows the load error and Try again instead of the summary, and moves focus to Try again.</summary>
    [Parameter]
    public bool Failed { get; set; }

    /// <summary>Raised by Try again.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    /// <summary>Raised by Done and the Android back button.</summary>
    [Parameter]
    public EventCallback OnDone { get; set; }

    private static StatChange? Since(SinceLastTime since) => since.Kind switch
    {
        ChangeKind.Up => new StatChange(ChangeDirection.Up, since.Difference!),
        ChangeKind.Down => new StatChange(ChangeDirection.Down, since.Difference!),
        ChangeKind.Equal => new StatChange(ChangeDirection.None, ""),
        _ => null,
    };
}
