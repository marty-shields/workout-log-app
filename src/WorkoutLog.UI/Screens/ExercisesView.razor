@using WorkoutLog.UI.Components.Feedback
@using WorkoutLog.UI.Models.Exercises
<AppScreen Title="Exercises" OnBack="OnBack">
    @if (Loading)
    {
        <div class="centre">
            <Spinner Label="Loading…" TestId="exercises-loading" />
        </div>
    }
    else if (Failed)
    {
        <LoadFailed Message="Couldn't load your exercises" OnRetry="OnRetry" TestId="exercises" />
    }
    else if (NothingLogged)
    {
        <EmptyState Message="No exercises logged yet" TestId="exercises-empty" />
    }
    else
    {
        <ExerciseList Items="Items" Query="@Query" QueryChanged="QueryChanged" Filter="Filter" FilterChanged="FilterChanged" OnPick="OnOpen" TestId="exercises" />
    }
</AppScreen>

@code {
    /// <summary>Logged exercises to list, already searched and filtered, in order.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ExerciseListItem> Items { get; set; } = [];

    /// <summary>Search text.</summary>
    [Parameter]
    public string? Query { get; set; }

    /// <summary>Raised on each keystroke with the new search text.</summary>
    [Parameter]
    public EventCallback<string> QueryChanged { get; set; }

    /// <summary>Chosen chip.</summary>
    [Parameter]
    public ExerciseFilter Filter { get; set; }

    /// <summary>Raised with the chip tapped.</summary>
    [Parameter]
    public EventCallback<ExerciseFilter> FilterChanged { get; set; }

    /// <summary>Shows "No exercises logged yet" instead of the search, chips and rows.</summary>
    [Parameter]
    public bool NothingLogged { get; set; }

    /// <summary>Shows a spinner instead of the content while the exercises load.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Shows the load error and Try again instead of the content, and moves focus to Try again.</summary>
    [Parameter]
    public bool Failed { get; set; }

    /// <summary>Raised by Try again.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    /// <summary>Raised when a row is tapped, to open its Exercise page. Rows are not tappable when unset.</summary>
    [Parameter]
    public EventCallback<ExerciseListItem> OnOpen { get; set; }

    /// <summary>Raised by the back arrow and the Android back button.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }
}
