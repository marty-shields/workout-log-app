@using WorkoutLog.Core.Domain.Exercises
@using WorkoutLog.UI.Components.Feedback
@using WorkoutLog.UI.Components.Inputs
@using WorkoutLog.UI.Models.Exercises
<AppScreen Title="Exercises" OnBack="OnBack">
    @if (Loading)
    {
        <div class="centre">
            <Spinner Label="Loading…" TestId="exercises-loading" />
        </div>
    }
    else if (Failed)
    {
        <LoadFailed Message="Couldn't load your exercises" OnRetry="OnRetry" TestId="exercises" />
    }
    else if (NothingLogged)
    {
        <EmptyState Message="No exercises logged yet" TestId="exercises-empty" />
    }
    else
    {
        <div class="tools">
            <div class="search">
                <span class="search-icon"><Icon Name="IconName.Search" Muted /></span>
                <input type="search"
                       class="search-input"
                       placeholder="Search exercises"
                       aria-label="Search exercises"
                       autocomplete="off"
                       maxlength="@ExerciseCatalog.MaxQueryLength"
                       value="@Query"
                       data-testid="exercises-search"
                       @oninput="OnInput" />
            </div>
            <FilterChips TValue="ExerciseFilter" Label="Type" Options="Filters" Value="Filter" ValueChanged="FilterChanged" TestId="exercises-filter" />
        </div>
        @if (Items.Count == 0)
        {
            <p class="none" data-testid="exercises-none">No exercises match</p>
        }
        else
        {
            <ul class="rows">
                @foreach (var item in Items)
                {
                    <li>
                        <ListRow Text="@item.Name" Detail="@($"Last {item.Last}")" OnClick="() => OnOpen.InvokeAsync(item)" TestId="@($"exercises-row-{item.Id}")" />
                    </li>
                }
            </ul>
        }
    }
</AppScreen>

@code {
    private static readonly IReadOnlyList<RadioOption<ExerciseFilter>> Filters =
    [
        new(ExerciseFilter.All, "All", "exercises-filter-all"),
        new(ExerciseFilter.Strength, "Strength", "exercises-filter-strength"),
        new(ExerciseFilter.Cardio, "Cardio", "exercises-filter-cardio"),
    ];

    /// <summary>Logged exercises to list, already searched and filtered, in order.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ExerciseListItem> Items { get; set; } = [];

    /// <summary>Search text.</summary>
    [Parameter]
    public string? Query { get; set; }

    /// <summary>Raised on each keystroke with the new search text, at most <see cref="ExerciseCatalog.MaxQueryLength"/> characters.</summary>
    [Parameter]
    public EventCallback<string> QueryChanged { get; set; }

    /// <summary>Chosen chip.</summary>
    [Parameter]
    public ExerciseFilter Filter { get; set; }

    /// <summary>Raised with the chip tapped.</summary>
    [Parameter]
    public EventCallback<ExerciseFilter> FilterChanged { get; set; }

    /// <summary>Shows "No exercises logged yet" instead of the search, chips and rows.</summary>
    [Parameter]
    public bool NothingLogged { get; set; }

    /// <summary>Shows a spinner instead of the content while the exercises load.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Shows the load error and Try again instead of the content, and moves focus to Try again.</summary>
    [Parameter]
    public bool Failed { get; set; }

    /// <summary>Raised by Try again.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    /// <summary>Raised when a row is tapped.</summary>
    [Parameter, EditorRequired]
    public EventCallback<ExerciseListItem> OnOpen { get; set; }

    /// <summary>Raised by the back arrow and the Android back button.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    private Task OnInput(ChangeEventArgs e)
    {
        var text = e.Value as string ?? "";
        return QueryChanged.InvokeAsync(text.Length > ExerciseCatalog.MaxQueryLength ? text[..ExerciseCatalog.MaxQueryLength] : text);
    }
}
