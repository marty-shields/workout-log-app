@using WorkoutLog.UI.Components.Feedback
@using WorkoutLog.UI.Models.Exercises
@if (Picking)
{
    <div class="picker" role="dialog" aria-modal="true" aria-label="Add exercise" data-testid="exercises-overlay">
        @Screen
    </div>
}
else
{
    @Screen
}

@code {
    /// <summary>Exercises to list, already searched and filtered, in order.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ExerciseListItem> Items { get; set; } = [];

    /// <summary>Search text.</summary>
    [Parameter]
    public string? Query { get; set; }

    /// <summary>Raised on each keystroke with the new search text.</summary>
    [Parameter]
    public EventCallback<string> QueryChanged { get; set; }

    /// <summary>Chosen chip.</summary>
    [Parameter]
    public ExerciseFilter Filter { get; set; }

    /// <summary>Raised with the chip tapped.</summary>
    [Parameter]
    public EventCallback<ExerciseFilter> FilterChanged { get; set; }

    /// <summary>Shows "No exercises logged yet" instead of the search, chips and rows. No search or chips show while loading either.</summary>
    [Parameter]
    public bool NothingLogged { get; set; }

    /// <summary>Shows a spinner instead of the rows while the exercises load. The search and chips stay unless <see cref="NothingLogged"/>.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Shows the load error and Try again instead of the search, chips and rows, and moves focus to Try again.</summary>
    [Parameter]
    public bool Failed { get; set; }

    /// <summary>Raised by Try again.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    /// <summary>Raised by pulling the content down, to load it again. No pull without it.</summary>
    [Parameter]
    public EventCallback OnRefresh { get; set; }

    /// <summary>Raised with the row tapped. Rows are not tappable when unset.</summary>
    [Parameter]
    public EventCallback<ExerciseListItem> OnPick { get; set; }

    /// <summary>
    /// Raised by the back arrow and Android back. Setting it makes this the add-exercise list, an overlay on the workout with no
    /// navigation bar, whose search box takes focus when it opens.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Raised with the destination tapped in the bottom navigation bar, and with the Dashboard on Android back.</summary>
    [Parameter]
    public EventCallback<NavDestination> OnNavigate { get; set; }

    private bool Picking => OnClose.HasDelegate;

    private bool ShowsTools => !Failed && !NothingLogged;

    private RenderFragment Screen =>
        @<AppScreen Title="Exercises" Destination="@(Picking ? null : NavDestination.Exercises)" OnNavigate="OnNavigate" OnBack="OnClose" BackTestId="exercises-back"
                   OnRefresh="OnRefresh" Toolbar="@(ShowsTools ? Tools : null)">
            @if (Loading)
            {
                <div class="centre">
                    <Spinner Label="Loading…" TestId="exercises-loading" />
                </div>
            }
            else if (Failed)
            {
                <LoadFailed Message="Couldn't load your exercises" OnRetry="OnRetry" TestId="exercises" />
            }
            else if (NothingLogged)
            {
                <EmptyState Message="No exercises logged yet" Hint="Exercises show here once you log them in a workout" TestId="exercises-empty" />
            }
            else
            {
                <ExerciseList Items="Items" OnPick="OnPick" TestId="exercises" />
            }
        </AppScreen>;

    private RenderFragment Tools =>
        @<div class="tools">
            <ExerciseSearch Query="@Query" QueryChanged="QueryChanged" Filter="Filter" FilterChanged="FilterChanged" FocusSearch="Picking" TestId="exercises" />
        </div>;
}
