@using System.Globalization
@using Microsoft.Extensions.Logging
@using WorkoutLog.Core.Domain.Exercises
@using WorkoutLog.Core.Domain.Workouts.Consistency
@using WorkoutLog.Core.Domain.Workouts.Periods
@using WorkoutLog.Core.Services
@using WorkoutLog.UI.Components.ThisWeek
@using WorkoutLog.UI.Components.Trends
@using WorkoutLog.UI.Lifecycle
@using WorkoutLog.UI.Models.Muscles
@using WorkoutLog.UI.Models.ThisWeek
@using WorkoutLog.UI.Models.Workouts
@using WorkoutLog.UI.Navigation
@implements IDisposable
@inject IPeriodTotalsService Periods
@inject IPeriodTrainingService Training
@inject IExerciseCatalog Catalog
@inject TimeProvider Clock
@inject IAppStart AppStart
@inject ILogger<TrendsPage> Logger

<TrendsView Kind="period.Kind" Label="@Label" Past="Past" CanGoPrevious="CanGoPrevious" CanGoNext="CanGoNext"
            Totals="totals" Earlier="earlier" Against="@Against" Days="days" Muscles="muscles" Records="records" RecentWeeks="recentWeeks" Streak="streak"
            Start="period.Start" Today="today" Trained="trained" Weeks="weeks" MostTrained="mostTrained"
            Months="months" PerWeek="perWeek" LongestStreak="longestStreak" StreakRunning="streakRunning" RecordsByMonth="recordsByMonth"
            Loading="loading" Failed="failed" OnRetry="() => LoadAsync()" OnRefresh="() => LoadAsync(PullRefresh.MinimumSpinner)"
            OnKindChanged="SwitchAsync" OnPrevious="() => StepAsync(period.Previous())" OnNext="() => StepAsync(period.Next())"
            OnSettings="() => OnSettings.InvokeAsync(period)" OnNew="() => OnNew.InvokeAsync(period)" OnNavigate="OnNavigate"
            OnOpenWorkouts="OpenWorkoutsAsync" OnOpenRecord="OpenExerciseAsync" />

@code {
    private static readonly TrendTotals NoTotals = new(0, TimeSpan.Zero, 0, 0);
    private static readonly string[] DayNames = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

    private DateOnly today;
    private Period period = Period.Containing(PeriodKind.Week, default);
    private Period? earliest;
    private (string? Kind, string? Date) requested;
    private WeekStreaks? streaks;
    private int streaksYear;
    private PeriodLimits? limits;
    private TrendTotals totals = NoTotals;
    private TrendTotals earlier = NoTotals;
    private IReadOnlyList<TrendBar> days = [];
    private IReadOnlyList<MuscleGroupSets> muscles = [];
    private IReadOnlyList<WeekRecord> records = [];
    private IReadOnlyList<int> recentWeeks = [];
    private IReadOnlyCollection<DateOnly> trained = [];
    private IReadOnlyList<MonthWeek> weeks = [];
    private IReadOnlyList<MeterRow> mostTrained = [];
    private IReadOnlyList<TrendBar> months = [];
    private IReadOnlyList<MeterRow> recordsByMonth = [];
    private double perWeek;
    private int longestStreak;
    private bool streakRunning;
    private int streak;
    private bool loading;
    private bool failed;
    private int generation;
    private IDisposable? registration;
    private bool disposed;

    /// <summary>The <c>period</c> query value: <c>week</c>, <c>month</c> or <c>year</c>. Missing or anything else, it shows the week.</summary>
    [Parameter]
    public string? KindQuery { get; set; }

    /// <summary>The <c>date</c> query value, a day inside the period as 2026-11-09. Missing, invalid or after the period holding today, it shows that period.</summary>
    [Parameter]
    public string? DateQuery { get; set; }

    /// <summary>Raised with the period shown when the stepper or the kind control moves to it, so the host can put it in the URL.</summary>
    [Parameter]
    public EventCallback<Period> OnPeriodChanged { get; set; }

    /// <summary>Raised by the Settings gear with the period shown, so back can return to it.</summary>
    [Parameter]
    public EventCallback<Period> OnSettings { get; set; }

    /// <summary>Raised by the New button in the tab bar with the period shown, so discarding can return to it.</summary>
    [Parameter]
    public EventCallback<Period> OnNew { get; set; }

    /// <summary>Raised with the tab tapped in the tab bar.</summary>
    [Parameter]
    public EventCallback<MainTab> OnNavigate { get; set; }

    /// <summary>Raised when a day, week row or bar is tapped, with its days and the period shown, so back from Workouts can return to that period.</summary>
    [Parameter]
    public EventCallback<WorkoutsOpened> OnOpenWorkouts { get; set; }

    /// <summary>Raised when a record or a Most trained row is tapped, with its exercise and the period shown, so back can return to that period.</summary>
    [Parameter]
    public EventCallback<RecordOpened> OnOpenExercise { get; set; }

    private string Label => period.Kind switch
    {
        PeriodKind.Week => DisplayFormat.WeekDates(period.Start),
        PeriodKind.Month => DisplayFormat.Month(period.Start.Year, period.Start.Month),
        _ => DisplayFormat.Year(period.Start.Year),
    };

    private bool Past => !period.Contains(today);

    private string Against => period.Kind switch
    {
        PeriodKind.Week => Past ? "Against the week before" : DisplayFormat.AgainstLastWeek(today.DayOfWeek),
        PeriodKind.Month => Past ? DisplayFormat.AgainstMonthBefore(period.Previous().Start, period.Start.Year) : DisplayFormat.AgainstLastMonth(period.SamePointBefore(today), period.Start.Year),
        _ => Past ? $"Against {period.Previous().Start.Year}" : DisplayFormat.AgainstLastYear(period.SamePointBefore(today)),
    };

    private bool CanGoPrevious => earliest is { } first && first.Kind == period.Kind && period.Start > first.Start;

    private bool CanGoNext => period.Start < Period.Containing(period.Kind, today).Start;

    protected override Task OnInitializedAsync()
    {
        SetToday();
        period = Requested();
        requested = (KindQuery, DateQuery);
        registration = AppStart.Register(() => InvokeAsync(ReloadAsync));
        return LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (generation == 0 || requested == (KindQuery, DateQuery))
        {
            return;
        }

        requested = (KindQuery, DateQuery);
        SetToday();
        var asked = Requested();
        if (asked != period)
        {
            period = asked;
            await LoadAsync(force: true, readReach: false);
        }
    }

    public void Dispose()
    {
        disposed = true;
        registration?.Dispose();
    }

    private Period Requested()
    {
        var kind = TrendsRoute.ParseKind(KindQuery) ?? PeriodKind.Week;
        var current = Period.Containing(kind, today);
        var asked = TrendsRoute.ParseDate(DateQuery) is { } day ? Period.Containing(kind, day) : current;
        return asked.Start > current.Start ? current : asked;
    }

    private async Task StepAsync(Period step)
    {
        if ((step.Start < period.Start && !CanGoPrevious) || (step.Start > period.Start && !CanGoNext))
        {
            return;
        }

        period = step;
        await OnPeriodChanged.InvokeAsync(step);
        await LoadAsync(force: true, readReach: false);
    }

    /// <summary>Moves to the period of <paramref name="kind"/> that holds the day being looked at: today when the period shown holds it, otherwise the period's first day.</summary>
    private async Task SwitchAsync(PeriodKind kind)
    {
        if (kind == period.Kind)
        {
            return;
        }

        var wasCurrent = period.Contains(today);
        SetToday();
        var next = Period.Containing(kind, wasCurrent ? today : period.Start);
        var current = Period.Containing(kind, today);
        period = next.Start > current.Start ? current : next;
        await OnPeriodChanged.InvokeAsync(period);
        await LoadAsync(force: true, readReach: false);
    }

    private Task OpenWorkoutsAsync(DateSpan dates) => OnOpenWorkouts.InvokeAsync(new WorkoutsOpened(dates, period));

    private Task OpenExerciseAsync(int exerciseId) => OnOpenExercise.InvokeAsync(new RecordOpened(exerciseId, period));

    /// <summary>
    /// Takes today afresh and reads the period, the one before, its volume, its series, the records and the stepper's limits together, with what its
    /// kind adds: the muscle groups and the streak for a week, the most trained exercises for a month, the streak for a year. When it began on the
    /// current period and a new one has begun since, it shows the new one. Records that fail to load leave their card empty; any other read that fails shows the error.
    /// Does nothing while a load runs, unless <paramref name="force"/> (the stepper or the kind moved on, so the load running is for a period no longer shown
    /// and its result is dropped), and nothing more once the page is disposed. The limits and the streak do not depend on the period, so with
    /// <paramref name="readReach"/> false a load keeps the last ones it read, if they are for this kind and year. A period before the first workout moves to the first period and loads that.
    /// </summary>
    private async Task LoadAsync(TimeSpan minimum = default, bool force = false, bool readReach = true)
    {
        if (loading && !force)
        {
            return;
        }

        var mine = ++generation;
        loading = true;
        StateHasChanged();
        var wasCurrent = !CanGoNext;
        SetToday();
        var moved = wasCurrent && CanGoNext;
        if (moved)
        {
            period = Period.Containing(period.Kind, today);
            await OnPeriodChanged.InvokeAsync(period);
        }

        var shown = period;
        var kind = shown.Kind;
        var streakYear = kind == PeriodKind.Year ? shown.Start.Year : today.Year;
        var minimumElapsed = Task.Delay(minimum, Clock);
        var comparisonLoad = Periods.GetComparisonAsync(shown);
        var volumeLoad = Periods.GetVolumeAsync(shown);
        var seriesLoad = Periods.GetSeriesAsync(shown);
        var recordsLoad = Training.GetRecordsAsync(shown);
        var keepLimits = !readReach && limits is { } kept && kept.Earliest.Kind == kind;
        var limitsLoad = keepLimits ? Task.FromResult<ReadResult<PeriodLimits>>(limits!) : Periods.GetLimitsAsync(kind);
        var keepStreaks = !readReach && streaks is not null && streaksYear == streakYear;
        var streaksLoad = kind == PeriodKind.Month ? Skipped<WeekStreaks>()
            : keepStreaks ? Task.FromResult<ReadResult<WeekStreaks>>(streaks!)
            : Periods.GetStreaksAsync(streakYear);
        var musclesLoad = kind == PeriodKind.Week ? Training.GetMuscleSetsAsync(shown) : Skipped<IReadOnlyList<MuscleGroupCount>>();
        var mostLoad = kind == PeriodKind.Month ? Training.GetMostTrainedAsync(shown) : Skipped<IReadOnlyList<TrainedExercise>>();
        await Task.WhenAll(comparisonLoad, volumeLoad, seriesLoad, recordsLoad, limitsLoad, streaksLoad, musclesLoad, mostLoad);
        var comparison = await comparisonLoad;
        var volume = await volumeLoad;
        var series = await seriesLoad;
        var recent = await recordsLoad;
        var readLimits = await limitsLoad;
        var readStreaks = await streaksLoad;
        var counts = await musclesLoad;
        var most = await mostLoad;
        if (disposed || mine != generation)
        {
            return;
        }

        if (kind != PeriodKind.Month)
        {
            streaks = readStreaks is WeekStreaks weekly ? weekly : null;
            streaksYear = streakYear;
        }

        limits = readLimits is PeriodLimits known ? known : null;
        earliest = limits?.Earliest ?? (earliest?.Kind == kind ? earliest : null);
        if (limits is { } reach && shown.Start < reach.Earliest.Start)
        {
            period = reach.Earliest;
            await OnPeriodChanged.InvokeAsync(period);
            await LoadAsync(minimum, force: true, readReach: false);
            return;
        }

        failed = comparison is not PeriodComparison || volume is not PeriodVolume || series is not PeriodSeries || limits is null
            || kind switch
            {
                PeriodKind.Week => streaks is null || counts is not IReadOnlyList<MuscleGroupCount>,
                PeriodKind.Month => most is not IReadOnlyList<TrainedExercise>,
                _ => streaks is null,
            };
        if (comparison is PeriodComparison read && volume is PeriodVolume lifted)
        {
            totals = ToTotals(read.Totals, lifted.Volume);
            earlier = ToTotals(read.Earlier, lifted.Earlier);
        }

        var daily = series is PeriodSeries built ? built : null;
        switch (kind)
        {
            case PeriodKind.Week:
                days = daily is not null ? Days(shown, daily) : [];
                recentWeeks = streaks?.WeekCounts ?? [];
                streak = streaks?.Current ?? 0;
                muscles = counts is IReadOnlyList<MuscleGroupCount> groups ? groups.Select(g => new MuscleGroupSets(g.Group.ToString(), g.Sets)).ToList() : [];
                break;
            case PeriodKind.Month:
                trained = daily is not null ? daily.Buckets.Where(b => b.Workouts > 0).Select(b => b.Start).ToList() : [];
                weeks = daily is not null ? Weeks(shown, daily) : [];
                mostTrained = most is IReadOnlyList<TrainedExercise> top ? MostTrainedRows(top) : [];
                break;
            default:
                months = daily is not null ? Months(daily) : [];
                perWeek = daily?.WorkoutsPerWeek ?? 0;
                longestStreak = streaks?.Longest.Weeks ?? 0;
                streakRunning = streaks?.Longest.Running ?? false;
                recordsByMonth = recent is PeriodRecords yearly ? RecordsByMonth(shown, yearly.PerMonth) : [];
                break;
        }

        records = recent is PeriodRecords found && kind != PeriodKind.Year
            ? WeekRecordItems.Items(found.Records, Catalog, Clock.LocalTimeZone, withDates: kind == PeriodKind.Month)
            : [];
        if (failed)
        {
            Log.LoadFailed(Logger);
        }
        else if (recent is ReadFailed)
        {
            Log.RecordsFailed(Logger);
        }

        await minimumElapsed;
        if (!disposed && mine == generation)
        {
            loading = false;
        }
    }

    private static Task<ReadResult<T>> Skipped<T>() => Task.FromResult<ReadResult<T>>(new ReadFailed());

    private void SetToday() =>
        today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), Clock.LocalTimeZone).DateTime);

    private static TrendTotals ToTotals(WeekTally tally, decimal volume) => new(tally.Workouts, tally.Time, tally.Sets, volume);

    /// <summary>Monday to Sunday: minutes trained on each day beside the same day the week before.</summary>
    private List<TrendBar> Days(Period week, PeriodSeries series) =>
        [.. DayNames.Select((name, i) =>
        {
            var day = week.Start.AddDays(i);
            var minutes = Minutes(series.Buckets, day);
            var before = Minutes(series.Earlier, day.AddDays(-7));
            return new TrendBar(
                name[..3],
                name,
                minutes,
                minutes > 0 ? DisplayFormat.Minutes(minutes) : day > today ? "still to come" : "rest day",
                before,
                before > 0 ? DisplayFormat.Minutes(before) : "rest day",
                Current: day == today,
                Span: new DateSpan(day, day));
        })];

    private static int Minutes(IReadOnlyList<PeriodBucket> buckets, DateOnly day) =>
        buckets.FirstOrDefault(b => b.Start == day) is { } bucket ? (int)bucket.Time.TotalMinutes : 0;

    /// <summary>One row per week of the month cut to the month, e.g. 2 – 8 Nov; in the month holding today, the weeks that have not begun are left out and the last ends today.</summary>
    private List<MonthWeek> Weeks(Period month, PeriodSeries series) =>
        [.. series.Weeks
            .Where(w => !month.Contains(today) || w.Start <= today)
            .Select(w =>
            {
                var last = month.Contains(today) && w.End > today ? today : w.End;
                return new MonthWeek(DisplayFormat.MonthWeekDates(w.Start, last), w.Workouts, w.Time, new DateSpan(w.Start, last));
            })];

    private List<MeterRow> MostTrainedRows(IReadOnlyList<TrainedExercise> top)
    {
        var definitions = Catalog.All.ToDictionary(e => e.Id);
        return [.. top.Where(t => definitions.ContainsKey(t.ExerciseId)).Select(t => new MeterRow(definitions[t.ExerciseId].Name, t.Sessions, t.ExerciseId))];
    }

    /// <summary>Workouts in each month, January to December, with the busiest and the current month's value printed.</summary>
    private List<TrendBar> Months(PeriodSeries series)
    {
        var highest = series.Buckets.Max(b => b.Workouts);
        return [.. series.Buckets.Select(b =>
        {
            var name = b.Start.ToString("MMMM", CultureInfo.InvariantCulture);
            var current = b.Start <= today && today <= b.End;
            return new TrendBar(
                name[..1],
                name,
                b.Workouts,
                b.Workouts == 0 ? "no workouts" : DisplayFormat.Workouts(b.Workouts),
                Current: current,
                Labelled: current || (b.Workouts == highest && highest > 0),
                Span: new DateSpan(b.Start, b.End > today ? today : b.End));
        })];
    }

    /// <summary>Records in each month that has begun, January first.</summary>
    private List<MeterRow> RecordsByMonth(Period year, IReadOnlyList<int> perMonth) =>
        [.. perMonth.Select((count, i) => (Month: new DateOnly(year.Start.Year, i + 1, 1), Count: count))
            .Where(m => m.Month <= today)
            .Select(m => new MeterRow(m.Month.ToString("MMM", CultureInfo.InvariantCulture), m.Count))];

    /// <summary>Loads again when the app comes back on screen. Does nothing once the page is disposed, before or during the load.</summary>
    private async Task ReloadAsync()
    {
        if (disposed)
        {
            return;
        }

        await LoadAsync();
        if (!disposed)
        {
            StateHasChanged();
        }
    }
}
