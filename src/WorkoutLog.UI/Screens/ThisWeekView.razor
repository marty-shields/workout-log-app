@using WorkoutLog.UI.Components.Weekly
@using WorkoutLog.UI.Components.ThisWeek
@using Shields.UI.Components.Overlays
@using WorkoutLog.UI.Models.Muscles
@using WorkoutLog.UI.Models.ThisWeek
<AppScreen Title="Workout Log" NavItems="MainTabs.Items" Current="MainTabs.Item(MainTab.ThisWeek)" OnNavigate="item => OnNavigate.InvokeAsync(MainTabs.Tab(item))"
           AddLabel="@MainTabs.AddLabel" AddIcon="MainTabs.AddIcon" OnAdd="OnNew" OnRefresh="OnRefresh">
    <Actions>
        <IconButton Icon="IconName.Settings" AriaLabel="Settings" TestId="settings" OnClick="OnSettings" />
    </Actions>
    <ChildContent>
        @if (Unfinished is not null && !Loading)
        {
            <div class="unfinished">
                <Banner TestId="unfinished">
                    <ChildContent>
                        <Typography Variant="TextVariant.Strong" As="TextElement.P" TestId="unfinished-title">Workout in progress</Typography>
                        <Typography Variant="TextVariant.Body" As="TextElement.P" TestId="unfinished-details">@Unfinished.Started · @DisplayFormat.Exercises(Unfinished.Exercises)</Typography>
                    </ChildContent>
                    <Actions>
                        <AppButton TestId="unfinished-resume" OnClick="OnResume">Resume</AppButton>
                        <AppButton Variant="ButtonVariant.Secondary" TestId="unfinished-discard" OnClick="OnDiscardUnfinished">Discard</AppButton>
                    </Actions>
                </Banner>
            </div>
        }
        @if (Loading)
        {
            <div class="centre">
                <Spinner Label="Loading…" TestId="this-week-loading" />
            </div>
        }
        else if (Failed)
        {
            <LoadFailed RetryVariant="ButtonVariant.Secondary" Message="Couldn't load This week" OnRetry="OnRetry" TestId="this-week" />
        }
        else
        {
            <div class="cards">
                <div class="dates">
                    <Typography Variant="TextVariant.Heading" As="TextElement.H2" TestId="this-week-dates">@DisplayFormat.WeekDates(Monday)</Typography>
                    @if (Streak > 0)
                    {
                        <Typography Variant="TextVariant.MutedSmall" TestId="this-week-streak">@Streak-week streak</Typography>
                    }
                </div>
                <DayStrip Days="Week" Done="Trained" Today="Today" Label="Days this week" DoneText="trained" EmptyText="no workout" FutureText="coming up" TodayText="today" TestId="day-strip" />
                <WeekTiles ThisWeek="ThisWeek" LastWeekToDate="LastWeekToDate" Today="Today.DayOfWeek" TestId="week-tiles" />
                <WeekWorkoutsCard Workouts="Workouts" OnOpen="OnOpenWorkout" TestId="week-workouts" />
                @if (Workouts.Count > 0)
                {
                    @if (Records is not null)
                    {
                        <WeekRecordsCard Records="Records" OnOpen="OnOpenRecord" TestId="week-records" />
                    }
                    <MuscleSetsCard Groups="Muscles" TestId="week-muscles" />
                }
                else if (LastWeek is not null)
                {
                    <LastWeekCard Totals="LastWeek" OnOpen="OnOpenLastWeek" TestId="last-week" />
                }
            </div>
        }
    </ChildContent>
</AppScreen>
@if (Unfinished is not null && ConfirmingDiscard)
{
    <ConfirmDialog Title="Discard this workout?" Message="@Unfinished.Lost" ConfirmText="Discard" Danger
                   OnConfirm="OnConfirmDiscard" OnCancel="OnCancelDiscard" TestId="confirm-dialog" />
}
<Sheet Open="Unfinished is not null && ChoosingNew" Title="Workout in progress" OnClose="OnCloseChoice" TestId="new-unfinished">
    @if (Unfinished is not null)
    {
        <div class="choice">
            <Typography Variant="TextVariant.Body" As="TextElement.P" TestId="new-unfinished-message">
                You haven't finished the workout you started. Resume it, or discard it to start a new one: @Unfinished.Lost.
            </Typography>
            <AppButton FullWidth TestId="new-unfinished-resume" OnClick="OnResume">Resume</AppButton>
            <AppButton Variant="ButtonVariant.Danger" FullWidth TestId="new-unfinished-discard" OnClick="OnDiscardAndStart">Discard and start new</AppButton>
        </div>
    }
</Sheet>

@code {
    /// <summary>The week's Monday. The title row shows the week's dates and the strip starts here.</summary>
    [Parameter, EditorRequired]
    public DateOnly Monday { get; set; }

    /// <summary>Today, in the phone's time zone.</summary>
    [Parameter, EditorRequired]
    public DateOnly Today { get; set; }

    /// <summary>Days of this week with a workout.</summary>
    [Parameter]
    public IReadOnlyCollection<DateOnly> Trained { get; set; } = [];

    private DateOnly[] Week => [.. Enumerable.Range(0, 7).Select(Monday.AddDays)];

    /// <summary>Consecutive weeks with a workout; hidden at 0.</summary>
    [Parameter]
    public int Streak { get; set; }

    /// <summary>This week so far.</summary>
    [Parameter]
    public WeekTotals ThisWeek { get; set; } = new(0, TimeSpan.Zero, 0);

    /// <summary>Last week from Monday to the end of the same weekday as today.</summary>
    [Parameter]
    public WeekTotals LastWeekToDate { get; set; } = new(0, TimeSpan.Zero, 0);

    /// <summary>This week's workouts. With none, the card says so and the records and muscle group cards are left out.</summary>
    [Parameter]
    public IReadOnlyList<WeekWorkout> Workouts { get; set; } = [];

    /// <summary>Records set this week. Null leaves the card out, for records that could not be read.</summary>
    [Parameter]
    public IReadOnlyList<WeekRecord>? Records { get; set; } = [];

    /// <summary>Sets per muscle group from Monday to today.</summary>
    [Parameter]
    public IReadOnlyList<MuscleGroupSets> Muscles { get; set; } = [];

    /// <summary>Last week's whole-week totals, shown as a row while nothing is logged this week. Null when there was no last week to show.</summary>
    [Parameter]
    public WeekTotals? LastWeek { get; set; }

    /// <summary>The workout left unfinished by a crash or kill, shown as a banner at the top with Resume and Discard. Null shows none.</summary>
    [Parameter]
    public UnfinishedItem? Unfinished { get; set; }

    /// <summary>Shows the dialog that asks to confirm discarding <see cref="Unfinished"/>, naming what is lost.</summary>
    [Parameter]
    public bool ConfirmingDiscard { get; set; }

    /// <summary>Shows the sheet that offers Resume or Discard and start new, for + tapped while there is an <see cref="Unfinished"/> workout.</summary>
    [Parameter]
    public bool ChoosingNew { get; set; }

    /// <summary>Raised by Resume, on the banner and in the sheet.</summary>
    [Parameter]
    public EventCallback OnResume { get; set; }

    /// <summary>Raised by the banner's Discard.</summary>
    [Parameter]
    public EventCallback OnDiscardUnfinished { get; set; }

    /// <summary>Raised by Discard in the confirm dialog.</summary>
    [Parameter]
    public EventCallback OnConfirmDiscard { get; set; }

    /// <summary>Raised by Cancel in the confirm dialog and the Android back button.</summary>
    [Parameter]
    public EventCallback OnCancelDiscard { get; set; }

    /// <summary>Raised by Discard and start new in the sheet.</summary>
    [Parameter]
    public EventCallback OnDiscardAndStart { get; set; }

    /// <summary>Raised when the sheet is closed by its scrim or the Android back button; the unfinished workout stays.</summary>
    [Parameter]
    public EventCallback OnCloseChoice { get; set; }

    /// <summary>Shows a spinner instead of the week while it loads.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Shows the load error and Try again instead of the week, and moves focus to Try again.</summary>
    [Parameter]
    public bool Failed { get; set; }

    /// <summary>Raised by Try again.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    /// <summary>Raised by pulling the content down, to load it again. No pull without it.</summary>
    [Parameter]
    public EventCallback OnRefresh { get; set; }

    /// <summary>Raised by the Settings gear.</summary>
    [Parameter]
    public EventCallback OnSettings { get; set; }

    /// <summary>Raised by the New button in the bottom navigation bar.</summary>
    [Parameter]
    public EventCallback OnNew { get; set; }

    /// <summary>Raised with the tab tapped in the bottom navigation bar.</summary>
    [Parameter]
    public EventCallback<MainTab> OnNavigate { get; set; }

    /// <summary>Raised with the workout id when a workout row is tapped. Rows are not tappable when unset.</summary>
    [Parameter]
    public EventCallback<int> OnOpenWorkout { get; set; }

    /// <summary>Raised with the exercise id when a record row is tapped. Rows are not tappable when unset.</summary>
    [Parameter]
    public EventCallback<int> OnOpenRecord { get; set; }

    /// <summary>Raised by the Last week row. The row is not tappable when unset.</summary>
    [Parameter]
    public EventCallback OnOpenLastWeek { get; set; }
}
