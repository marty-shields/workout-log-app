@using Microsoft.Extensions.Logging
@using WorkoutLog.Core.Domain.Exercises
@using WorkoutLog.Core.Services
@using WorkoutLog.UI.Components.Overlays
@using WorkoutLog.UI.Components.Workout
@inject IWorkoutService Workouts
@inject IExerciseCatalog Catalog
@inject TimeProvider Clock
@inject ISetChecker Checker
@inject WorkoutEditor Editor
@inject ILogger<EditWorkoutPage> Logger

@if (!loaded)
{
    <WorkoutLoadView Failed="failed" NotFound="notFound" OnRetry="LoadAsync" OnBack="OnBack" />
}
else
{
    <WorkoutView Mode="WorkoutMode.Edit"
                 StartedAt="startedAt"
                 Time="total"
                 Exercises="Editor.Exercises"
                 Error="@Editor.Error"
                 Focus="Editor.Focus"
                 ErrorFocus="Editor.ErrorFocus"
                 ValidateSet="Checker.Check"
                 OnChanged="Editor.MarkChanged"
                 OnSave="SaveAsync"
                 OnAddExercise="Editor.OpenPicker"
                 OnRemoveExercise="Editor.Remove"
                 OnBack="BackAsync"
                 OnDelete="OpenDelete">
        <Overlay>
            @if (Editor.PickerOpen)
            {
                <ExercisePicker Query="@Editor.Query" QueryChanged="Editor.Search" Items="Editor.PickerItems" OnPick="Editor.Pick" OnClose="Editor.ClosePicker" />
            }
            @if (discardOpen)
            {
                <ConfirmDialog Title="Discard changes?" ConfirmText="Discard" Danger OnConfirm="DiscardAsync" OnCancel="CloseDiscard" />
            }
            @if (deleteOpen)
            {
                <ConfirmDialog Title="Delete this workout?" ConfirmText="Delete" Danger OnConfirm="DeleteAsync" OnCancel="CloseDelete" />
            }
        </Overlay>
    </WorkoutView>
}

@code {
    private bool loaded;
    private int loadedId;
    private DateTime startedAt;
    private TimeSpan total;
    private bool loading;
    private bool failed;
    private bool notFound;
    private bool discardOpen;
    private bool discarded;
    private bool deleteOpen;
    private bool deleting;

    /// <summary>Id of the saved workout.</summary>
    [Parameter, EditorRequired]
    public int WorkoutId { get; set; }

    /// <summary>Raised after the workout is saved.</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    /// <summary>Raised after the workout is deleted (FR-24).</summary>
    [Parameter]
    public EventCallback OnDeleted { get; set; }

    /// <summary>
    /// Raised by back while the workout is loading, failed to load or doesn't exist; on a loaded workout with no changes; and after
    /// Discard is confirmed. Nothing is saved (D189).
    /// </summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>
    /// Loads the workout, with the start in the phone's time zone. An exercise missing from the catalog or saved as the
    /// wrong type is logged and shows the load failure. A second call while one runs is ignored.
    /// </summary>
    private async Task LoadAsync()
    {
        if (loading)
        {
            return;
        }

        loading = true;
        failed = false;
        StateHasChanged();
        var workoutId = WorkoutId;
        var result = await Workouts.GetAsync(workoutId);
        loading = false;
        notFound = result.Status == WorkoutLoad.NotFound;
        failed = result.Status == WorkoutLoad.Failed;
        if (result.Status != WorkoutLoad.Loaded)
        {
            return;
        }

        var workout = result.Workout!;
        var exercises = new List<ExerciseState>();
        foreach (var exercise in workout.Exercises)
        {
            if (Catalog.All.FirstOrDefault(e => e.Id == exercise.ExerciseId) is not { } definition
                || ExerciseFields.Saved(definition, exercise) is not { } state)
            {
                Log.OpenFailed(Logger, workoutId, exercise.ExerciseId);
                failed = true;
                return;
            }

            exercises.Add(state);
        }

        startedAt = TimeZoneInfo.ConvertTime(workout.StartedAt, Clock.LocalTimeZone).DateTime;
        total = workout.FinishedAt - workout.StartedAt;
        loadedId = workoutId;
        Editor.Start(exercises);
        loaded = true;
    }

    /// <summary>
    /// With changes, asks Discard / Cancel (FR-23); without, raises <see cref="OnBack"/>. Ignored while a save runs, after one
    /// succeeds and after a discard (D189), and while a delete runs and after one succeeds (D191). The picker takes back first
    /// while it is open.
    /// </summary>
    private async Task BackAsync()
    {
        if (Editor.Saving || discarded || deleting)
        {
            return;
        }

        if (Editor.Changed)
        {
            discardOpen = true;
            return;
        }

        await OnBack.InvokeAsync();
    }

    private void CloseDiscard() => discardOpen = false;

    /// <summary>
    /// Logs the workout id only (D142) and raises <see cref="OnBack"/>, once. While a save or delete runs or after one succeeds,
    /// closes the prompt and does nothing else (D189, D191).
    /// </summary>
    private async Task DiscardAsync()
    {
        if (Editor.Saving || deleting)
        {
            discardOpen = false;
            return;
        }

        if (discarded)
        {
            return;
        }

        discarded = true;
        Log.EditsDiscarded(Logger, loadedId);
        await OnBack.InvokeAsync();
    }

    /// <summary>Asks Delete / Cancel (FR-24). Ignored while a save or delete runs, after one succeeds and after a discard (D191).</summary>
    private void OpenDelete()
    {
        if (Editor.Saving || deleting || discarded)
        {
            return;
        }

        deleteOpen = true;
    }

    /// <summary>Closes the prompt. Ignored while a delete runs and after one succeeds (D191).</summary>
    private void CloseDelete()
    {
        if (!deleting)
        {
            deleteOpen = false;
        }
    }

    /// <summary>
    /// Deletes the workout under the id it was loaded with and raises <see cref="OnDeleted"/>, once. If nothing was deleted,
    /// closes the prompt, shows DeleteFailed and focuses Delete. While a save runs or after one succeeds, closes the prompt and
    /// does nothing else; after a discard, does nothing (D191).
    /// </summary>
    private async Task DeleteAsync()
    {
        if (Editor.Saving)
        {
            deleteOpen = false;
            return;
        }

        if (deleting || discarded)
        {
            return;
        }

        deleting = true;
        if (await Workouts.DeleteAsync(loadedId) == WorkoutDelete.Failed)
        {
            deleting = false;
            deleteOpen = false;
            Editor.ShowDeleteFailed();
            return;
        }

        await OnDeleted.InvokeAsync();
    }

    /// <summary>
    /// Saves under the id it was loaded with through <see cref="WorkoutEditor.SaveAsync"/> and raises <see cref="OnSaved"/>.
    /// Ignored while a delete runs and after one succeeds (D191).
    /// </summary>
    private async Task SaveAsync()
    {
        if (deleting)
        {
            return;
        }

        if (await Editor.SaveAsync(async records => (await Workouts.SaveAsync(loadedId, records)).WorkoutId is not null))
        {
            await OnSaved.InvokeAsync();
        }
    }
}
