@using Microsoft.Extensions.Logging
@using WorkoutLog.Core.Domain.Exercises
@using WorkoutLog.Core.Services
@using WorkoutLog.UI.Components.Overlays
@using WorkoutLog.UI.Components.Workout
@inject IWorkoutService Workouts
@inject IExerciseCatalog Catalog
@inject TimeProvider Clock
@inject ISetChecker Checker
@inject IWorkoutChecker WorkoutChecker
@inject ILogger<EditWorkoutPage> Logger

@if (exercises is null)
{
    <WorkoutLoadView Failed="failed" NotFound="notFound" OnRetry="LoadAsync" OnBack="OnBack" />
}
else
{
    <WorkoutView Mode="WorkoutMode.Edit"
                 StartedAt="startedAt"
                 Time="total"
                 Exercises="exercises"
                 Error="@error"
                 Focus="focus"
                 ErrorFocus="errorFocus"
                 ValidateSet="Checker.Check"
                 OnChanged="() => changed = true"
                 OnSave="SaveAsync"
                 OnAddExercise="OpenPicker"
                 OnRemoveExercise="RemoveExercise"
                 OnBack="BackAsync"
                 OnDelete="() => { }">
        <Overlay>
            @if (pickerOpen)
            {
                <ExercisePicker Query="@query" QueryChanged="Search" Items="pickerItems" OnPick="Pick" OnClose="ClosePicker" />
            }
            @if (discardOpen)
            {
                <ConfirmDialog Title="Discard changes?" ConfirmText="Discard" Danger OnConfirm="DiscardAsync" OnCancel="CloseDiscard" />
            }
        </Overlay>
    </WorkoutView>
}

@code {
    private List<ExerciseState>? exercises;
    private int loadedId;
    private DateTime startedAt;
    private TimeSpan total;
    private bool loading;
    private bool failed;
    private bool notFound;
    private bool pickerOpen;
    private string query = "";
    private IReadOnlyList<PickerItem> pickerItems = [];
    private ExerciseFocus? focus;
    private ErrorFocus? errorFocus;
    private string? error;
    private bool saving;
    private bool changed;
    private bool discardOpen;
    private bool discarded;

    /// <summary>Id of the saved workout.</summary>
    [Parameter, EditorRequired]
    public int WorkoutId { get; set; }

    /// <summary>Raised after the workout is saved.</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    /// <summary>
    /// Raised by back while the workout is loading, failed to load or doesn't exist; on a loaded workout with no changes; and after
    /// Discard is confirmed. Nothing is saved (D189).
    /// </summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>
    /// Loads the workout, with the start in the phone's time zone. An exercise missing from the catalog or saved as the
    /// wrong type is logged and shows the load failure. A second call while one runs is ignored.
    /// </summary>
    private async Task LoadAsync()
    {
        if (loading)
        {
            return;
        }

        loading = true;
        failed = false;
        StateHasChanged();
        var workoutId = WorkoutId;
        var result = await Workouts.GetAsync(workoutId);
        loading = false;
        notFound = result.Status == WorkoutLoad.NotFound;
        failed = result.Status == WorkoutLoad.Failed;
        if (result.Status != WorkoutLoad.Loaded)
        {
            return;
        }

        var workout = result.Workout!;
        var loaded = new List<ExerciseState>();
        foreach (var exercise in workout.Exercises)
        {
            if (Catalog.All.FirstOrDefault(e => e.Id == exercise.ExerciseId) is not { } definition
                || ExerciseFields.Saved(definition, exercise) is not { } state)
            {
                Log.OpenFailed(Logger, workoutId, exercise.ExerciseId);
                failed = true;
                return;
            }

            loaded.Add(state);
        }

        startedAt = TimeZoneInfo.ConvertTime(workout.StartedAt, Clock.LocalTimeZone).DateTime;
        total = workout.FinishedAt - workout.StartedAt;
        loadedId = workoutId;
        exercises = loaded;
    }

    /// <summary>
    /// With changes, asks Discard / Cancel (FR-23); without, raises <see cref="OnBack"/>. Ignored while a save runs, after one
    /// succeeds and after a discard (D189). The picker takes back first while it is open.
    /// </summary>
    private async Task BackAsync()
    {
        if (saving || discarded)
        {
            return;
        }

        if (changed)
        {
            discardOpen = true;
            return;
        }

        await OnBack.InvokeAsync();
    }

    private void CloseDiscard() => discardOpen = false;

    /// <summary>
    /// Logs the workout id only (D142) and raises <see cref="OnBack"/>, once. While a save runs or after one succeeds, closes
    /// the prompt and does nothing else (D189).
    /// </summary>
    private async Task DiscardAsync()
    {
        if (saving)
        {
            discardOpen = false;
            return;
        }

        if (discarded)
        {
            return;
        }

        discarded = true;
        Log.EditsDiscarded(Logger, loadedId);
        await OnBack.InvokeAsync();
    }

    private void OpenPicker()
    {
        Search("");
        pickerOpen = true;
    }

    /// <summary>Sets the search text and its results.</summary>
    private void Search(string text)
    {
        query = text;
        pickerItems = Catalog.Search(text).Select(ExerciseFields.PickerItem).ToList();
    }

    private void ClosePicker() => pickerOpen = false;

    private void Pick(PickerItem item)
    {
        focus = Show(item.Id);
        error = null;
        pickerOpen = false;
    }

    /// <summary>
    /// Checks the workout (FR-09) and moves focus to the first error. A valid workout is saved under the id it was loaded with and raises <see cref="OnSaved"/>;
    /// if nothing was saved, shows SaveFailed and focuses Save (D176). Ignored while a save runs and after one succeeds (D177).
    /// </summary>
    private async Task SaveAsync()
    {
        if (saving)
        {
            return;
        }

        var check = WorkoutChecker.Check(exercises!);
        error = check.Error;
        if (!check.IsValid)
        {
            errorFocus = new ErrorFocus();
            return;
        }

        saving = true;
        var result = await Workouts.SaveAsync(loadedId, exercises!.Select(Checker.Read).ToList());
        saving = result.WorkoutId is not null;
        if (result.WorkoutId is null)
        {
            error = WorkoutChecker.SaveFailed;
            errorFocus = new ErrorFocus(focusSave: true);
            return;
        }

        await OnSaved.InvokeAsync();
    }

    /// <summary>Focuses the exercise already in the workout, adding a set to a strength one; otherwise adds it at the bottom.</summary>
    private ExerciseFocus Show(int exerciseId)
    {
        if (exercises!.Find(e => e.ExerciseId == exerciseId) is { } existing)
        {
            return new ExerciseFocus(existing, addSet: existing.Kind == ExerciseKind.Strength);
        }

        var added = ExerciseFields.New(Catalog.All.Single(e => e.Id == exerciseId));
        exercises.Add(added);
        changed = true;
        return new ExerciseFocus(added);
    }

    private void RemoveExercise(ExerciseState exercise)
    {
        exercises!.Remove(exercise);
        changed = true;
    }
}
