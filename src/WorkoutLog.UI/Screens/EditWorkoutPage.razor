@using Microsoft.Extensions.Logging
@using WorkoutLog.Core.Domain.Exercises
@using WorkoutLog.Core.Services
@using WorkoutLog.UI.Components.Overlays
@using WorkoutLog.UI.Components.Workout
@inject IWorkoutService Workouts
@inject IExerciseCatalog Catalog
@inject TimeProvider Clock
@inject ISetChecker Checker
@inject IWorkoutChecker WorkoutChecker
@inject WorkoutEditor Editor
@inject ILogger<EditWorkoutPage> Logger

@if (phase is EditPhase.Loading or EditPhase.LoadFailed or EditPhase.NotFound)
{
    <WorkoutLoadView Failed="phase == EditPhase.LoadFailed" NotFound="phase == EditPhase.NotFound" OnRetry="LoadAsync" OnBack="OnBack" />
}
else
{
    <WorkoutView Mode="WorkoutMode.Edit"
                 StartedAt="startedAt"
                 Time="total"
                 Exercises="Editor.Exercises"
                 Error="@Editor.Error"
                 Focus="Editor.Focus"
                 ErrorFocus="Editor.ErrorFocus"
                 ValidateSet="Checker.Check"
                 ValidateDone="WorkoutChecker.CheckExercise"
                 OnChanged="Editor.MarkChanged"
                 OnSave="SaveAsync"
                 OnAddExercise="Editor.OpenListAsync"
                 OnRemoveExercise="Editor.AskRemove"
                 OnBack="BackAsync"
                 OnDelete="OpenDelete">
        <Overlay>
            @if (Editor.ListOpen)
            {
                <AddExerciseView Items="Editor.ListItems" Query="@Editor.Query" QueryChanged="Editor.Search" Filter="Editor.Filter" FilterChanged="Editor.FilterBy"
                                 Loading="Editor.ListLoading" OnPick="Editor.Pick" OnClose="Editor.CloseList" />
            }
            @if (Editor.Removing is { } removing)
            {
                <ConfirmDialog Title="@($"Delete {removing.Name}?")" ConfirmText="Delete" Danger OnConfirm="Editor.ConfirmRemove" OnCancel="Editor.CancelRemove" />
            }
            @if (Editor.DiscardOpen)
            {
                <ConfirmDialog Title="Discard changes?" ConfirmText="Discard" Danger OnConfirm="DiscardAsync" OnCancel="Editor.CloseDiscard" />
            }
            @if (phase is EditPhase.ConfirmingDelete or EditPhase.Deleting)
            {
                <ConfirmDialog Title="Delete this workout?" ConfirmText="Delete" Danger OnConfirm="DeleteAsync" OnCancel="CloseDelete" />
            }
        </Overlay>
    </WorkoutView>
}

@code {
    private enum EditPhase
    {
        Loading,
        LoadFailed,
        NotFound,
        Editing,
        ConfirmingDelete,
        Deleting,
    }

    private EditPhase phase = EditPhase.Loading;
    private int loadedId;
    private DateTime startedAt;
    private TimeSpan total;

    /// <summary>Id of the saved workout.</summary>
    [Parameter, EditorRequired]
    public int WorkoutId { get; set; }

    /// <summary>Raised after the workout is saved.</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    /// <summary>Raised after the workout is deleted.</summary>
    [Parameter]
    public EventCallback OnDeleted { get; set; }

    /// <summary>
    /// Raised by back while the workout is loading, failed to load or doesn't exist; on a loaded workout with no changes; and after
    /// Discard is confirmed. Nothing is saved.
    /// </summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    protected override Task OnInitializedAsync() => FetchAsync();

    /// <summary>
    /// Loads the workout, with the start in the phone's time zone. An exercise missing from the catalog or saved as the
    /// wrong type is logged and shows the load failure. A second call while one runs is ignored.
    /// </summary>
    private async Task LoadAsync()
    {
        if (phase is EditPhase.Loading)
        {
            return;
        }

        phase = EditPhase.Loading;
        StateHasChanged();
        await FetchAsync();
    }

    private async Task FetchAsync()
    {
        var workoutId = WorkoutId;
        var result = await Workouts.GetAsync(workoutId);
        if (result.Status != WorkoutLoad.Loaded)
        {
            phase = result.Status == WorkoutLoad.NotFound ? EditPhase.NotFound : EditPhase.LoadFailed;
            return;
        }

        var workout = result.Workout!;
        var exercises = new List<ExerciseState>();
        foreach (var exercise in workout.Exercises)
        {
            if (Catalog.All.FirstOrDefault(e => e.Id == exercise.ExerciseId) is not { } definition
                || ExerciseFields.Saved(definition, exercise) is not { } state)
            {
                Log.OpenFailed(Logger, workoutId, exercise.ExerciseId);
                phase = EditPhase.LoadFailed;
                return;
            }

            state.IsDone = true;
            exercises.Add(state);
        }

        startedAt = TimeZoneInfo.ConvertTime(workout.StartedAt, Clock.LocalTimeZone).DateTime;
        total = workout.FinishedAt - workout.StartedAt;
        loadedId = workoutId;
        Editor.Start(exercises);
        phase = EditPhase.Editing;
    }

    /// <summary>
    /// With changes, asks Discard / Cancel; without, raises <see cref="OnBack"/>. Ignored while a save runs, after one
    /// succeeds and after a discard, and while a delete runs and after one succeeds. The add-exercise list takes back first
    /// while it is open.
    /// </summary>
    private async Task BackAsync()
    {
        if (Editor.SaveState != SavePhase.Idle || Editor.Discarded || phase == EditPhase.Deleting)
        {
            return;
        }

        if (Editor.Changed)
        {
            Editor.AskDiscard();
            return;
        }

        await OnBack.InvokeAsync();
    }

    /// <summary>
    /// Logs the workout id only and raises <see cref="OnBack"/>, once. While a save or delete runs or after one succeeds,
    /// closes the prompt and does nothing else.
    /// </summary>
    private async Task DiscardAsync()
    {
        if (phase == EditPhase.Deleting)
        {
            Editor.CloseDiscard();
            return;
        }

        if (!Editor.ConfirmDiscard())
        {
            return;
        }

        Log.EditsDiscarded(Logger, loadedId);
        await OnBack.InvokeAsync();
    }

    /// <summary>Asks Delete / Cancel. Ignored while a save or delete runs, after one succeeds and after a discard.</summary>
    private void OpenDelete()
    {
        if (Editor.SaveState != SavePhase.Idle || phase == EditPhase.Deleting || Editor.Discarded)
        {
            return;
        }

        phase = EditPhase.ConfirmingDelete;
    }

    /// <summary>Closes the prompt. Ignored while a delete runs and after one succeeds.</summary>
    private void CloseDelete()
    {
        if (phase == EditPhase.ConfirmingDelete)
        {
            phase = EditPhase.Editing;
        }
    }

    /// <summary>
    /// Deletes the workout under the id it was loaded with and raises <see cref="OnDeleted"/>, once. If nothing was deleted,
    /// closes the prompt, shows DeleteFailed and focuses Delete. While a save runs or after one succeeds, closes the prompt and
    /// does nothing else; after a discard, does nothing.
    /// </summary>
    private async Task DeleteAsync()
    {
        if (Editor.SaveState != SavePhase.Idle)
        {
            phase = EditPhase.Editing;
            return;
        }

        if (phase == EditPhase.Deleting || Editor.Discarded)
        {
            return;
        }

        phase = EditPhase.Deleting;
        if (await Workouts.DeleteAsync(loadedId) == WorkoutDelete.Failed)
        {
            phase = EditPhase.Editing;
            Editor.ShowDeleteFailed();
            return;
        }

        await OnDeleted.InvokeAsync();
    }

    /// <summary>
    /// Saves under the id it was loaded with through <see cref="WorkoutEditor.SaveAsync"/> and raises <see cref="OnSaved"/>.
    /// Ignored while a delete runs and after one succeeds.
    /// </summary>
    private async Task SaveAsync()
    {
        if (phase == EditPhase.Deleting)
        {
            return;
        }

        if (await Editor.SaveAsync(async records => (await Workouts.SaveAsync(loadedId, null, records)).WorkoutId is not null))
        {
            await OnSaved.InvokeAsync();
        }
    }
}
