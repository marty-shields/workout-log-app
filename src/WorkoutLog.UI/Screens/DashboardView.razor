@using WorkoutLog.UI.Components.Feedback
<AppScreen Title="Workout Log">
    <Actions>
        <IconButton Icon="IconName.Settings" AriaLabel="Settings" TestId="settings" OnClick="OnSettings" />
    </Actions>
    <ChildContent>
        @if (Loading)
        {
            <div class="centre">
                <Spinner Label="Loading…" TestId="dashboard-loading" />
            </div>
        }
        else if (Failed)
        {
            <div class="load-failed">
                <LoadFailed Message="Couldn't load the Dashboard" OnRetry="OnRetry" TestId="dashboard" />
            </div>
        }
        else
        {
            <div class="cards">
                @LastWorkout
                @Consistency
                @RecentRecords
            </div>
        }
        <ListRow Text="Workouts" OnClick="OnWorkouts" TestId="workouts-link" />
        <ListRow Text="Exercises" OnClick="OnExercises" TestId="exercises-link" />
    </ChildContent>
    <BottomBar>
        <AppButton FullWidth TestId="new-workout" OnClick="OnNewWorkout">New Workout</AppButton>
    </BottomBar>
</AppScreen>

@code {
    /// <summary>Last workout card.</summary>
    [Parameter]
    public RenderFragment? LastWorkout { get; set; }

    /// <summary>Consistency card, under the last workout.</summary>
    [Parameter]
    public RenderFragment? Consistency { get; set; }

    /// <summary>Recent records card, under consistency.</summary>
    [Parameter]
    public RenderFragment? RecentRecords { get; set; }

    /// <summary>Shows a spinner instead of the cards while they load.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Shows the load error and Try again instead of the cards, and moves focus to Try again.</summary>
    [Parameter]
    public bool Failed { get; set; }

    /// <summary>Raised by Try again.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    /// <summary>Raised by New Workout.</summary>
    [Parameter]
    public EventCallback OnNewWorkout { get; set; }

    /// <summary>Raised by the Workouts link.</summary>
    [Parameter]
    public EventCallback OnWorkouts { get; set; }

    /// <summary>Raised by the Exercises link.</summary>
    [Parameter]
    public EventCallback OnExercises { get; set; }

    /// <summary>Raised by the Settings gear.</summary>
    [Parameter]
    public EventCallback OnSettings { get; set; }
}
