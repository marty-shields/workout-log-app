@using Microsoft.Extensions.Logging
@using WorkoutLog.Core.Domain.Exercises
@using WorkoutLog.Core.Services
@using WorkoutLog.UI.Components.Overlays
@using WorkoutLog.UI.Components.Workout
@implements IDisposable
@inject IWorkoutService Workouts
@inject IExerciseCatalog Catalog
@inject TimeProvider Clock
@inject ISetChecker Checker
@inject IWorkoutChecker WorkoutChecker
@inject ILogger<NewWorkoutPage> Logger

<WorkoutView Mode="WorkoutMode.New"
             StartedAt="startedAt"
             Time="Elapsed"
             Exercises="exercises"
             Error="@error"
             Focus="focus"
             ErrorFocus="errorFocus"
             ValidateSet="Checker.Check"
             OnSave="SaveAsync"
             OnAddExercise="OpenPicker"
             OnRemoveExercise="RemoveExercise"
             OnBack="Back">
    <Overlay>
        @if (pickerOpen)
        {
            <ExercisePicker Query="@query" QueryChanged="Search" Items="pickerItems" OnPick="Pick" OnClose="ClosePicker" />
        }
        @if (discardOpen)
        {
            <ConfirmDialog Title="Discard this workout?" ConfirmText="Discard" Danger OnConfirm="DiscardAsync" OnCancel="CloseDiscard" />
        }
    </Overlay>
</WorkoutView>

@code {
    private readonly List<ExerciseState> exercises = [];
    private WorkoutDraft draft = null!;
    private DateTime startedAt;
    private PeriodicTimer? timer;
    private bool pickerOpen;
    private string query = "";
    private IReadOnlyList<PickerItem> pickerItems = [];
    private ExerciseFocus? focus;
    private ErrorFocus? errorFocus;
    private string? error;
    private bool saving;
    private bool discardOpen;
    private bool discarded;

    /// <summary>Raised after Discard is confirmed. Nothing is saved.</summary>
    [Parameter]
    public EventCallback OnDiscarded { get; set; }

    /// <summary>Raised after the workout is saved.</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    /// <summary>Time since the start; zero while the clock is before the start.</summary>
    private TimeSpan Elapsed => TimeSpan.FromTicks(Math.Max(0, (Clock.GetUtcNow() - draft.StartedAt).Ticks));

    protected override void OnInitialized()
    {
        draft = Workouts.StartNew();
        startedAt = TimeZoneInfo.ConvertTime(draft.StartedAt, Clock.LocalTimeZone).DateTime;
        timer = new PeriodicTimer(TimeSpan.FromSeconds(1), Clock);
        _ = TickAsync(timer);
    }

    public void Dispose() => timer?.Dispose();

    private void OpenPicker()
    {
        Search("");
        pickerOpen = true;
    }

    /// <summary>Sets the search text and its results.</summary>
    private void Search(string text)
    {
        query = text;
        pickerItems = Catalog.Search(text).Select(ExerciseFields.PickerItem).ToList();
    }

    private void ClosePicker() => pickerOpen = false;

    /// <summary>Asks Discard / Cancel (FR-12). Ignored while a save runs, after one succeeds and after a discard (D179).</summary>
    private void Back()
    {
        if (!saving && !discarded)
        {
            discardOpen = true;
        }
    }

    private void CloseDiscard() => discardOpen = false;

    /// <summary>
    /// Logs the exercise count only (D142) and raises <see cref="OnDiscarded"/>, once. While a save runs or after one
    /// succeeds, closes the prompt and does nothing else (D179).
    /// </summary>
    private async Task DiscardAsync()
    {
        if (saving)
        {
            discardOpen = false;
            return;
        }

        if (discarded)
        {
            return;
        }

        discarded = true;
        Log.Discarded(Logger, exercises.Count);
        await OnDiscarded.InvokeAsync();
    }

    private void Pick(PickerItem item)
    {
        focus = Show(item.Id);
        error = null;
        pickerOpen = false;
    }

    /// <summary>
    /// Checks the workout (FR-09) and moves focus to the first error. A valid workout is saved and raises <see cref="OnSaved"/>;
    /// if nothing was saved, shows SaveFailed and focuses Save (D176). Ignored while a save runs and after one succeeds (D177).
    /// </summary>
    private async Task SaveAsync()
    {
        if (saving)
        {
            return;
        }

        var check = WorkoutChecker.Check(exercises);
        error = check.Error;
        if (!check.IsValid)
        {
            errorFocus = new ErrorFocus();
            return;
        }

        saving = true;
        var result = await Workouts.SaveNewAsync(draft, exercises.Select(Checker.Read).ToList());
        saving = result.WorkoutId is not null;
        if (result.WorkoutId is null)
        {
            error = WorkoutChecker.SaveFailed;
            errorFocus = new ErrorFocus(focusSave: true);
            return;
        }

        await OnSaved.InvokeAsync();
    }

    /// <summary>Focuses the exercise already in the workout, adding a set to a strength one; otherwise adds it at the bottom.</summary>
    private ExerciseFocus Show(int exerciseId)
    {
        if (exercises.Find(e => e.ExerciseId == exerciseId) is { } existing)
        {
            return new ExerciseFocus(existing, addSet: existing.Kind == ExerciseKind.Strength);
        }

        var added = ExerciseFields.New(Catalog.All.Single(e => e.Id == exerciseId));
        exercises.Add(added);
        return new ExerciseFocus(added);
    }

    private void RemoveExercise(ExerciseState exercise) => exercises.Remove(exercise);

    /// <summary>Re-renders every tick until the timer is disposed. A render error goes to the error boundary.</summary>
    private async Task TickAsync(PeriodicTimer ticks)
    {
        while (await ticks.WaitForNextTickAsync())
        {
            await InvokeAsync(StateHasChanged);
        }
    }
}
