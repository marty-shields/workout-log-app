@using Microsoft.Extensions.Logging
@using WorkoutLog.Core.Domain.Exercises
@using WorkoutLog.Core.Services
@using WorkoutLog.UI.Components.Overlays
@using WorkoutLog.UI.Components.Workout
@using WorkoutLog.UI.Models.Exercises
@using WorkoutLog.UI.Models.Fields
@implements IDisposable
@inject IWorkoutService Workouts
@inject IWeightHistoryService WeightHistory
@inject TimeProvider Clock
@inject ISetChecker Checker
@inject IWorkoutChecker WorkoutChecker
@inject WorkoutEditor Editor
@inject ILogger<NewWorkoutPage> Logger

<WorkoutView Mode="WorkoutMode.New"
             StartedAt="startedAt"
             Time="Elapsed"
             Exercises="Editor.Exercises"
             Error="@Editor.Error"
             Focus="Editor.Focus"
             ErrorFocus="Editor.ErrorFocus"
             ValidateSet="Checker.Check"
             ValidateDone="WorkoutChecker.CheckExercise"
             OnSave="SaveAsync"
             OnAddExercise="Editor.OpenListAsync"
             OnRemoveExercise="Editor.AskRemove"
             OnBack="Editor.AskDiscard">
    <Overlay>
        @if (Editor.ListOpen)
        {
            <AddExerciseView Items="Editor.ListItems" Query="@Editor.Query" QueryChanged="Editor.Search" Filter="Editor.Filter" FilterChanged="Editor.FilterBy"
                             Loading="Editor.ListLoading" OnPick="PickAsync" OnClose="Editor.CloseList" />
        }
        @if (Editor.Removing is { } removing)
        {
            <ConfirmDialog Title="@($"Delete {removing.Name}?")" ConfirmText="Delete" Danger OnConfirm="Editor.ConfirmRemove" OnCancel="Editor.CancelRemove" />
        }
        @if (Editor.DiscardOpen)
        {
            <ConfirmDialog Title="Discard this workout?" ConfirmText="Discard" Danger OnConfirm="DiscardAsync" OnCancel="Editor.CloseDiscard" />
        }
    </Overlay>
</WorkoutView>

@code {
    private WorkoutDraft draft = null!;
    private DateTime startedAt;
    private PeriodicTimer? timer;

    /// <summary>Raised after Discard is confirmed. Nothing is saved.</summary>
    [Parameter]
    public EventCallback OnDiscarded { get; set; }

    /// <summary>Raised with the new workout's id after the workout is saved.</summary>
    [Parameter]
    public EventCallback<int> OnSaved { get; set; }

    /// <summary>Time since the start, by <see cref="IWorkoutService.Elapsed"/>.</summary>
    private TimeSpan Elapsed => Workouts.Elapsed(draft);

    protected override void OnInitialized()
    {
        draft = Workouts.StartNew();
        startedAt = TimeZoneInfo.ConvertTime(draft.StartedAt, Clock.LocalTimeZone).DateTime;
        timer = new PeriodicTimer(TimeSpan.FromSeconds(1), Clock);
        _ = TickAsync(timer);
    }

    public void Dispose() => timer?.Dispose();

    /// <summary>
    /// Picks the exercise (<see cref="WorkoutEditor.Pick"/>). A strength exercise just added then loads its last and best weights
    /// through <see cref="IWeightHistoryService.GetAsync"/>; a failed load shows none. Where 0 kg shows as no weight
    /// (<see cref="FieldSpec.HideZero"/>), a weight of 0 is none.
    /// </summary>
    private async Task PickAsync(ExerciseListItem item)
    {
        var added = Editor.Exercises.All(e => e.ExerciseId != item.Id);
        Editor.Pick(item);
        if (!added || item.Kind != ExerciseKind.Strength || Editor.Exercises.FirstOrDefault(e => e.ExerciseId == item.Id) is not { } exercise)
        {
            return;
        }

        var weights = await WeightHistory.GetAsync(item.Id, null);
        var hideZero = exercise.Fields.Any(f => f.Metric == Metric.WeightKg && f.HideZero);
        exercise.LastKg = hideZero && weights.LastKg == 0m ? null : weights.LastKg;
        exercise.BestKg = hideZero && weights.BestKg == 0m ? null : weights.BestKg;
    }

    /// <summary>
    /// Logs the exercise count only and raises <see cref="OnDiscarded"/>, once. While a save runs or after one
    /// succeeds, closes the prompt and does nothing else.
    /// </summary>
    private async Task DiscardAsync()
    {
        if (!Editor.ConfirmDiscard())
        {
            return;
        }

        Log.Discarded(Logger, Editor.Exercises.Count);
        await OnDiscarded.InvokeAsync();
    }

    /// <summary>Saves through <see cref="IWorkoutService.SaveNewAsync"/> (<see cref="WorkoutEditor.SaveAsync"/>) and raises <see cref="OnSaved"/> with the new id.</summary>
    private async Task SaveAsync()
    {
        int? savedId = null;
        if (await Editor.SaveAsync(async records =>
            {
                savedId = (await Workouts.SaveNewAsync(draft, null, records)).WorkoutId;
                return savedId is not null;
            }))
        {
            await OnSaved.InvokeAsync(savedId!.Value);
        }
    }

    /// <summary>Re-renders every tick until the timer is disposed. A render error goes to the error boundary.</summary>
    private async Task TickAsync(PeriodicTimer ticks)
    {
        while (await ticks.WaitForNextTickAsync())
        {
            await InvokeAsync(StateHasChanged);
        }
    }
}
