@using Microsoft.Extensions.Logging
@using WorkoutLog.Core.Domain.Exercises
@using WorkoutLog.Core.Services
@using WorkoutLog.UI.Components.Overlays
@using WorkoutLog.UI.Components.Workout
@using WorkoutLog.UI.Models.Exercises
@using WorkoutLog.UI.Models.Fields
@implements IDisposable
@inject IWorkoutService Workouts
@inject IWeightHistoryService WeightHistory
@inject IRecordBaselineService RecordBaselines
@inject TimeProvider Clock
@inject ISetChecker Checker
@inject IWorkoutChecker WorkoutChecker
@inject WorkoutEditor Editor
@inject ILogger<NewWorkoutPage> Logger

<WorkoutView Mode="WorkoutMode.New"
             StartedAt="startedAt"
             Time="Elapsed"
             Exercises="Editor.Exercises"
             Error="@Editor.Error"
             Focus="Editor.Focus"
             ErrorFocus="Editor.ErrorFocus"
             ValidateSet="Checker.Check"
             ValidateDone="WorkoutChecker.CheckExercise"
             OnChanged="UpdateRecords"
             OnSave="SaveAsync"
             OnAddExercise="Editor.OpenListAsync"
             OnRemoveExercise="Editor.AskRemove"
             OnBack="Back">
    <Overlay>
        @if (Editor.ListOpen)
        {
            <AddExerciseView Items="Editor.ListItems" Query="@Editor.Query" QueryChanged="Editor.Search" Filter="Editor.Filter" FilterChanged="Editor.FilterBy"
                             Loading="Editor.ListLoading" OnPick="PickAsync" OnClose="Editor.CloseList" />
        }
        @if (Editor.Removing is { } removing)
        {
            <ConfirmDialog Title="@($"Delete {removing.Name}?")" ConfirmText="Delete" Danger OnConfirm="Editor.ConfirmRemove" OnCancel="Editor.CancelRemove" />
        }
        @if (discardOpen)
        {
            <ConfirmDialog Title="Discard this workout?" ConfirmText="Discard" Danger OnConfirm="DiscardAsync" OnCancel="CloseDiscard" />
        }
    </Overlay>
</WorkoutView>

@code {
    private WorkoutDraft draft = null!;
    private DateTime startedAt;
    private PeriodicTimer? timer;
    private bool discardOpen;
    private bool discarded;

    /// <summary>Raised after Discard is confirmed. Nothing is saved.</summary>
    [Parameter]
    public EventCallback OnDiscarded { get; set; }

    /// <summary>Raised after the workout is saved.</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    /// <summary>Time since the start, by <see cref="IWorkoutService.Elapsed"/>.</summary>
    private TimeSpan Elapsed => Workouts.Elapsed(draft);

    protected override void OnInitialized()
    {
        draft = Workouts.StartNew();
        startedAt = TimeZoneInfo.ConvertTime(draft.StartedAt, Clock.LocalTimeZone).DateTime;
        timer = new PeriodicTimer(TimeSpan.FromSeconds(1), Clock);
        _ = TickAsync(timer);
    }

    public void Dispose() => timer?.Dispose();

    /// <summary>Asks Discard / Cancel. Ignored while a save runs, after one succeeds and after a discard.</summary>
    private void Back()
    {
        if (!Editor.Saving && !discarded)
        {
            discardOpen = true;
        }
    }

    private void CloseDiscard() => discardOpen = false;

    /// <summary>
    /// Picks the exercise (<see cref="WorkoutEditor.Pick"/>). An exercise just added then loads its record baseline through
    /// <see cref="IRecordBaselineService.LoadAsync"/>, and a strength one its last and best weights through <see cref="IWeightHistoryService.GetAsync"/>.
    /// A failed load shows no weights and no badge. Where 0 kg shows as no weight (<see cref="FieldSpec.HideZero"/>), a weight of 0 is none.
    /// </summary>
    private async Task PickAsync(ExerciseListItem item)
    {
        var added = Editor.Exercises.All(e => e.ExerciseId != item.Id);
        Editor.Pick(item);
        if (!added || Editor.Exercises.FirstOrDefault(e => e.ExerciseId == item.Id) is not { } exercise)
        {
            return;
        }

        var baselineLoad = RecordBaselines.LoadAsync(item.Id);
        if (item.Kind == ExerciseKind.Strength)
        {
            var weights = await WeightHistory.GetAsync(item.Id);
            var hideZero = exercise.Fields.Any(f => f.Metric == Metric.WeightKg && f.HideZero);
            exercise.LastKg = hideZero && weights.LastKg == 0m ? null : weights.LastKg;
            exercise.BestKg = hideZero && weights.BestKg == 0m ? null : weights.BestKg;
        }

        exercise.RecordBaseline = (await baselineLoad).Baseline;
        UpdateRecords();
    }

    /// <summary>Sets each exercise's <see cref="ExerciseState.RecordEntry"/> from its valid sets or entry, without touching their errors.</summary>
    private void UpdateRecords()
    {
        foreach (var exercise in Editor.Exercises)
        {
            if (exercise.RecordBaseline is not { } baseline)
            {
                continue;
            }

            var (current, valid) = Checker.ReadValid(exercise);
            exercise.RecordEntry = valid.Count > 0 && baseline.RecordEntryIndex(current) is { } index ? valid[index] : null;
        }
    }

    /// <summary>
    /// Logs the exercise count only and raises <see cref="OnDiscarded"/>, once. While a save runs or after one
    /// succeeds, closes the prompt and does nothing else.
    /// </summary>
    private async Task DiscardAsync()
    {
        if (Editor.Saving)
        {
            discardOpen = false;
            return;
        }

        if (discarded)
        {
            return;
        }

        discarded = true;
        Log.Discarded(Logger, Editor.Exercises.Count);
        await OnDiscarded.InvokeAsync();
    }

    /// <summary>Saves through <see cref="IWorkoutService.SaveNewAsync"/> (<see cref="WorkoutEditor.SaveAsync"/>) and raises <see cref="OnSaved"/>.</summary>
    private async Task SaveAsync()
    {
        if (await Editor.SaveAsync(async records => (await Workouts.SaveNewAsync(draft, records)).WorkoutId is not null))
        {
            await OnSaved.InvokeAsync();
        }
    }

    /// <summary>Re-renders every tick until the timer is disposed. A render error goes to the error boundary.</summary>
    private async Task TickAsync(PeriodicTimer ticks)
    {
        while (await ticks.WaitForNextTickAsync())
        {
            await InvokeAsync(StateHasChanged);
        }
    }
}
