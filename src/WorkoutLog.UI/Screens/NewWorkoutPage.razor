@using Microsoft.Extensions.Logging
@using WorkoutLog.Core.Domain.Exercises
@using WorkoutLog.Core.Domain.Workouts
@using WorkoutLog.Core.Services
@using Shields.UI.Components.Overlays
@using WorkoutLog.UI.Components.Workout
@using WorkoutLog.UI.Models.Exercises
@using WorkoutLog.UI.Models.Fields
@implements IDisposable
@inject IWorkoutService Workouts
@inject IUnfinishedWorkoutService Unfinished
@inject UnfinishedAutosaver Autosaver
@inject IExerciseCatalog Catalog
@inject IWeightHistoryService WeightHistory
@inject LastTimeLoader LastTimes
@inject TimeProvider Clock
@inject ISetChecker Checker
@inject IWorkoutChecker WorkoutChecker
@inject WorkoutEditor Editor
@inject ILogger<NewWorkoutPage> Logger

@if (draft is not null)
{
    <WorkoutView Mode="WorkoutMode.New"
                 StartedAt="startedAt"
                 Time="Elapsed"
                 Exercises="Editor.Exercises"
                 Error="@Editor.Error"
                 Note="@Editor.Note"
                 NoteChanged="Editor.SetNote"
                 NoteError="@Editor.NoteError"
                 Focus="Editor.Focus"
                 ErrorFocus="Editor.ErrorFocus"
                 ValidateSet="Checker.Check"
                 ValidateDone="WorkoutChecker.CheckExercise"
                 OnChanged="Editor.MarkChanged"
                 OnSave="SaveAsync"
                 OnAddExercise="Editor.OpenListAsync"
                 OnRemoveExercise="Editor.Remove"
                 OnRemoveSet="Editor.RemoveSet"
                 Undo="Editor.PendingUndo"
                 OnUndo="Editor.Undo"
                 OnUndoTimeout="Editor.DismissUndo"
                 OnBack="Editor.AskDiscard">
        <Overlay>
            @if (Editor.ListOpen)
            {
                <AddExerciseView Items="Editor.ListItems" Query="@Editor.Query" QueryChanged="Editor.Search" Filter="Editor.Filter" FilterChanged="Editor.FilterBy"
                               Loading="Editor.ListLoading" OnPick="PickAsync" OnClose="Editor.CloseList" />
            }
            @if (Editor.DiscardOpen)
            {
                <ConfirmDialog Title="Discard this workout?" ConfirmText="Discard" Danger OnConfirm="DiscardAsync" OnCancel="Editor.CloseDiscard" />
            }
        </Overlay>
    </WorkoutView>
}

@code {
    private WorkoutDraft? draft;
    private DateTime startedAt;
    private PeriodicTimer? timer;

    /// <summary>Starts from the unfinished workout the phone kept, with its start time, notes, exercises and sets as they were, if there is one; otherwise as a new workout.</summary>
    [Parameter]
    public bool Resume { get; set; }

    /// <summary>Raised after Discard is confirmed. Nothing is saved.</summary>
    [Parameter]
    public EventCallback OnDiscarded { get; set; }

    /// <summary>Raised with the new workout's id after the workout is saved.</summary>
    [Parameter]
    public EventCallback<int> OnSaved { get; set; }

    private TimeSpan Elapsed => Workouts.Elapsed(draft!);

    protected override async Task OnInitializedAsync()
    {
        Editor.Edited += Queue;
        if (Resume && await Unfinished.GetAsync() is UnfinishedWorkout unfinished)
        {
            var exercises = UnfinishedWorkouts.ToExercises(unfinished, Catalog);
            draft = Workouts.Resume(unfinished.StartedAt);
            Editor.Start(exercises, unfinished.Note);
            foreach (var exercise in exercises)
            {
                await LoadContextAsync(exercise);
            }
        }
        else
        {
            draft = Workouts.StartNew();
        }

        Autosaver.Begin();
        startedAt = TimeZoneInfo.ConvertTime(draft.StartedAt, Clock.LocalTimeZone).DateTime;
        timer = new PeriodicTimer(TimeSpan.FromSeconds(1), Clock);
        _ = TickAsync(timer);
    }

    public void Dispose()
    {
        Editor.Edited -= Queue;
        timer?.Dispose();
    }

    /// <summary>Queues the workout as it is for the autosave.</summary>
    private void Queue() => Autosaver.Queue(UnfinishedWorkouts.From(draft!.StartedAt, Editor.Note, Editor.Exercises));

    private async Task PickAsync(ExerciseListItem item)
    {
        var added = Editor.Exercises.All(e => e.ExerciseId != item.Id);
        Editor.Pick(item);
        if (added && Editor.Exercises.FirstOrDefault(e => e.ExerciseId == item.Id) is { } exercise)
        {
            await LoadContextAsync(exercise);
        }
    }

    /// <summary>Loads what the exercise shows from earlier workouts: the last time, the last note and, for strength, the last and best weight.</summary>
    private async Task LoadContextAsync(ExerciseState exercise)
    {
        await LastTimes.LoadAsync(exercise);
        if (await WeightHistory.GetAsync(exercise.ExerciseId, null) is not ExerciseHistory history)
        {
            return;
        }

        exercise.LastNote = history.LastNote;
        if (exercise.Kind != ExerciseKind.Strength)
        {
            return;
        }

        var hideZero = exercise.Fields.Any(f => f.Metric == Metric.WeightKg && f.HideZero);
        exercise.LastKg = hideZero && history.LastKg == 0m ? null : history.LastKg;
        exercise.BestKg = hideZero && history.BestKg == 0m ? null : history.BestKg;
    }

    private async Task DiscardAsync()
    {
        if (!Editor.ConfirmDiscard())
        {
            return;
        }

        await Autosaver.StopAsync();
        await Unfinished.DiscardAsync();
        Log.Discarded(Logger, Editor.Exercises.Count);
        await OnDiscarded.InvokeAsync();
    }

    private async Task SaveAsync()
    {
        int? savedId = null;
        if (await Editor.SaveAsync(async (note, records) =>
            {
                await Autosaver.StopAsync();
                savedId = await Workouts.SaveNewAsync(draft!, note, records) is Saved saved ? saved.WorkoutId : null;
                if (savedId is null)
                {
                    Autosaver.Begin();
                    Queue();
                }

                return savedId is not null;
            }))
        {
            await OnSaved.InvokeAsync(savedId!.Value);
        }
    }

    /// <summary>A render error goes to the error boundary.</summary>
    private async Task TickAsync(PeriodicTimer ticks)
    {
        while (await ticks.WaitForNextTickAsync())
        {
            await InvokeAsync(StateHasChanged);
        }
    }
}
