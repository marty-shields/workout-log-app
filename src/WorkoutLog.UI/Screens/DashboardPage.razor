@using WorkoutLog.Core.Domain.Exercises
@using WorkoutLog.Core.Domain.Workouts
@using WorkoutLog.Core.Services
@using WorkoutLog.UI.Components.Dashboard
@using WorkoutLog.UI.Lifecycle
@using WorkoutLog.UI.Models.Dashboard
@implements IDisposable
@inject IDashboardService Dashboard
@inject ILastWorkoutService LastWorkoutService
@inject IRecentRecordsService RecentRecordsService
@inject IExerciseCatalog Catalog
@inject TimeProvider Clock
@inject IAppStart AppStart

<DashboardView Loading="loading" Failed="failed" OnRetry="LoadAsync" OnNewWorkout="OnNewWorkout" OnWorkouts="OnWorkouts" OnExercises="OnExercises" OnSettings="OnSettings">
    <LastWorkout>
        <LastWorkoutCard Workout="last?.Card" OnOpen="OpenLastWorkoutAsync" TestId="last-workout" />
    </LastWorkout>
    <Consistency>
        <div class="stats">
            <StatTile Label="This week" Value="summary.ThisWeek" TestId="count-week" />
            <StatTile Label="This month" Value="summary.ThisMonth" TestId="count-month" />
        </div>
    </Consistency>
    <RecentRecords>
        @if (records is not null)
        {
            <RecentRecordsCard Records="records" OnOpen="OnOpenExercise" TestId="recent-records" />
        }
    </RecentRecords>
</DashboardView>

@code {
    private DashboardSummary summary = new(0, 0);
    private (int Id, LastWorkout Card)? last;
    private IReadOnlyList<RecentRecord>? records;
    private bool loading;
    private bool failed;
    private IDisposable? registration;
    private bool disposed;

    /// <summary>Raised by New Workout.</summary>
    [Parameter]
    public EventCallback OnNewWorkout { get; set; }

    /// <summary>Raised by the Workouts link.</summary>
    [Parameter]
    public EventCallback OnWorkouts { get; set; }

    /// <summary>Raised by the Exercises link.</summary>
    [Parameter]
    public EventCallback OnExercises { get; set; }

    /// <summary>Raised with the exercise id when a recent record is tapped.</summary>
    [Parameter]
    public EventCallback<int> OnOpenExercise { get; set; }

    /// <summary>Raised by the Settings gear.</summary>
    [Parameter]
    public EventCallback OnSettings { get; set; }

    /// <summary>Raised with the workout id when the last workout is tapped.</summary>
    [Parameter]
    public EventCallback<int> OnOpenWorkout { get; set; }

    protected override Task OnInitializedAsync()
    {
        registration = AppStart.Register(() => InvokeAsync(ReloadAsync));
        return LoadAsync();
    }

    public void Dispose()
    {
        disposed = true;
        registration?.Dispose();
    }

    /// <summary>Loads the last workout, counts and recent records. Shows the spinner until all finish, and the error if the last workout or counts fail. Records that fail to load leave their slot empty. Does nothing more once the page is disposed.</summary>
    private async Task LoadAsync()
    {
        if (loading)
        {
            return;
        }

        loading = true;
        StateHasChanged();
        var summaryLoad = Dashboard.GetAsync();
        var lastLoad = LastWorkoutService.GetAsync();
        var recordsLoad = RecentRecordsService.GetAsync();
        var result = await summaryLoad;
        var lastResult = await lastLoad;
        var recent = await recordsLoad;
        if (disposed)
        {
            return;
        }

        summary = new DashboardSummary(result.ThisWeek, result.ThisMonth);
        last = lastResult.Workout is { } workout ? (workout.Id, Card(workout)) : null;
        records = recent.Failed ? null : RecentRecordItems.Items(recent.Records, Catalog, Clock.LocalTimeZone, recent.Now);
        failed = result.Failed || lastResult.Failed;
        loading = false;
    }

    /// <summary>The card's values in the phone's time zone.</summary>
    private LastWorkout Card(WorkoutOutline workout)
    {
        var zone = Clock.LocalTimeZone;
        var startedAt = TimeZoneInfo.ConvertTime(workout.StartedAt, zone).DateTime;
        var today = TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), zone).Date;
        var names = Catalog.All.ToDictionary(e => e.Id, e => e.Name);
        return new LastWorkout(
            startedAt,
            CalendarDaysSinceOrZeroIfLater(startedAt, today),
            workout.FinishedAt - workout.StartedAt,
            workout.ExerciseIds.Select(id => names[id]).ToList());
    }

    private static int CalendarDaysSinceOrZeroIfLater(DateTime startedAt, DateTime today) => Math.Max(0, (today - startedAt.Date).Days);

    private Task OpenLastWorkoutAsync() => last is { } shown ? OnOpenWorkout.InvokeAsync(shown.Id) : Task.CompletedTask;

    /// <summary>Loads again when the app comes back on screen. Does nothing once the page is disposed, before or during the load.</summary>
    private async Task ReloadAsync()
    {
        if (disposed)
        {
            return;
        }

        await LoadAsync();
        if (!disposed)
        {
            StateHasChanged();
        }
    }
}
