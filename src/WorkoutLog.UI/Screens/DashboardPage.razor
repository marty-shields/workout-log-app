@using WorkoutLog.Core.Services
@using WorkoutLog.UI.Lifecycle
@using WorkoutLog.UI.Models.Dashboard
@implements IDisposable
@inject IDashboardService Dashboard
@inject TimeProvider Clock
@inject IAppStart AppStart

<DashboardView Loading="loading" Failed="failed" OnRetry="LoadAsync" OnNewWorkout="OnNewWorkout" OnWorkouts="OnWorkouts" OnExercises="OnExercises" OnSettings="OnSettings">
    <LastWorkout>
        <section class="section">
            <h2 class="heading">Last workout</h2>
            @if (summary.LastWorkoutStartedAt is { } lastWorkout)
            {
                <p class="last" data-testid="last-workout">@DisplayFormat.Date(lastWorkout)</p>
            }
            else
            {
                <EmptyState Message="No workouts yet" TestId="last-workout-empty" />
            }
        </section>
    </LastWorkout>
    <Consistency>
        <div class="stats">
            <StatTile Label="This week" Value="summary.ThisWeek" TestId="count-week" />
            <StatTile Label="This month" Value="summary.ThisMonth" TestId="count-month" />
        </div>
    </Consistency>
</DashboardView>

@code {
    private DashboardSummary summary = new(null, 0, 0);
    private bool loading;
    private bool failed;
    private IDisposable? registration;
    private bool disposed;

    /// <summary>Raised by New Workout.</summary>
    [Parameter]
    public EventCallback OnNewWorkout { get; set; }

    /// <summary>Raised by the Workouts link.</summary>
    [Parameter]
    public EventCallback OnWorkouts { get; set; }

    /// <summary>Raised by the Exercises link.</summary>
    [Parameter]
    public EventCallback OnExercises { get; set; }

    /// <summary>Raised by the Settings gear.</summary>
    [Parameter]
    public EventCallback OnSettings { get; set; }

    protected override Task OnInitializedAsync()
    {
        registration = AppStart.Register(() => InvokeAsync(ReloadAsync));
        return LoadAsync();
    }

    public void Dispose()
    {
        disposed = true;
        registration?.Dispose();
    }

    /// <summary>Loads the last workout and counts, with the start in the phone's time zone. Shows the spinner until it finishes. Does nothing more once the page is disposed.</summary>
    private async Task LoadAsync()
    {
        if (loading)
        {
            return;
        }

        loading = true;
        StateHasChanged();
        var result = await Dashboard.GetAsync();
        if (disposed)
        {
            return;
        }

        var last = result.LastStartedAt is { } startedAt ? TimeZoneInfo.ConvertTime(startedAt, Clock.LocalTimeZone).DateTime : (DateTime?)null;
        summary = new DashboardSummary(last, result.ThisWeek, result.ThisMonth);
        failed = result.Failed;
        loading = false;
    }

    /// <summary>Loads again when the app comes back on screen. Does nothing once the page is disposed, before or during the load.</summary>
    private async Task ReloadAsync()
    {
        if (disposed)
        {
            return;
        }

        await LoadAsync();
        if (!disposed)
        {
            StateHasChanged();
        }
    }
}
