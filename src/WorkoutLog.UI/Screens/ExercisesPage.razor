@using WorkoutLog.Core.Domain.Exercises
@using WorkoutLog.Core.Services
@using WorkoutLog.UI.Lifecycle
@using WorkoutLog.UI.Models.Exercises
@implements IDisposable
@inject ILoggedExercisesService LoggedExercises
@inject IExerciseCatalog Catalog
@inject TimeProvider Clock
@inject IAppStart AppStart

<ExercisesView Items="items"
               Query="@query"
               QueryChanged="Search"
               Filter="filter"
               FilterChanged="FilterBy"
               NothingLogged="logged.Count == 0"
               Loading="loading"
               Failed="failed"
               OnRetry="() => LoadAsync()"
               OnRefresh="() => LoadAsync(PullRefresh.MinimumSpinner)"
               OnPick="item => OnOpen.InvokeAsync(item.Id)"
               OnNavigate="OnNavigate" />

@code {
    private IReadOnlyList<ExerciseListItem> logged = [];
    private IReadOnlyList<ExerciseListItem> items = [];
    private string query = "";
    private ExerciseFilter filter;
    private bool loading;
    private bool failed;
    private IDisposable? registration;
    private bool disposed;

    /// <summary>Raised with the exercise id when a row is tapped.</summary>
    [Parameter]
    public EventCallback<int> OnOpen { get; set; }

    /// <summary>Raised with the destination tapped in the bottom navigation bar, and with the Dashboard on Android back.</summary>
    [Parameter]
    public EventCallback<NavDestination> OnNavigate { get; set; }

    protected override Task OnInitializedAsync()
    {
        registration = AppStart.Register(() => InvokeAsync(ReloadAsync));
        return LoadAsync();
    }

    public void Dispose()
    {
        disposed = true;
        registration?.Dispose();
    }

    /// <summary>Ids not in the catalog are already left out by Core. Does nothing more once the page is disposed.</summary>
    private async Task LoadAsync(TimeSpan minimum = default)
    {
        if (loading)
        {
            return;
        }

        loading = true;
        StateHasChanged();
        var minimumElapsed = Task.Delay(minimum, Clock);
        var result = await LoggedExercises.GetAsync();
        if (disposed)
        {
            return;
        }

        var definitions = Catalog.All.ToDictionary(e => e.Id);
        var now = Clock.GetUtcNow();
        IReadOnlyList<LoggedExercise> exercises = result switch
        {
            IReadOnlyList<LoggedExercise> read => read,
            ReadFailed => [],
        };
        logged = exercises
            .Select(e => ExerciseListItems.Item(definitions[e.ExerciseId], e, Clock.LocalTimeZone, now))
            .ToList();
        failed = result is ReadFailed;
        Find();
        await minimumElapsed;
        if (!disposed)
        {
            loading = false;
        }
    }

    private void Search(string text)
    {
        query = text;
        Find();
    }

    private void FilterBy(ExerciseFilter value)
    {
        filter = value;
        Find();
    }

    /// <summary>Loads again when the app comes back on screen, keeping the search and chip. Does nothing once the page is disposed, before or during the load.</summary>
    private async Task ReloadAsync()
    {
        if (disposed)
        {
            return;
        }

        await LoadAsync();
        if (!disposed)
        {
            StateHasChanged();
        }
    }

    private void Find() => items = ExerciseListItems.Find(logged, Catalog, query, filter);
}
