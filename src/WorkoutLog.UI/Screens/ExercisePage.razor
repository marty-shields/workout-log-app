@using WorkoutLog.Core.Domain.Exercises
@using WorkoutLog.Core.Domain.Exercises.Progress
@using WorkoutLog.Core.Services
@using WorkoutLog.UI.Components.Charts
@using WorkoutLog.UI.Components.Inputs
@using WorkoutLog.UI.Models.Exercises
@inject IExerciseProgressService Progress
@inject ICardioProgressService CardioProgress
@inject IExerciseCatalog Catalog
@inject TimeProvider Clock

<ExerciseView Name="@(definition?.Name ?? "")"
              Subtitle="@(definition is null ? null : IsCardio ? CardioProgressItems.Subtitle : ExerciseProgressItems.Subtitle(definition))"
              Tabs="tabs"
              Tab="@(tabs.Count > 0 ? tab : null)"
              TabChanged="ChooseTab"
              ChartTitle="@chartTitle"
              Points="points"
              Flipped="flipped"
              Format="@format"
              TimeScale="timeScale"
              Caption="@caption"
              NoDataMessage="@noDataMessage"
              Range="range"
              RangeChanged="ChooseRange"
              Records="records"
              Sessions="sessions"
              Loading="loading"
              Failed="failed"
              OnRetry="LoadAsync"
              OnBack="OnBack" />

@code {
    private ExerciseDefinition? definition;
    private IReadOnlyList<StrengthSession> loaded = [];
    private IReadOnlyList<CardioSession> loadedCardio = [];
    private IReadOnlyList<RadioOption<string>> tabs = ExerciseProgressItems.Tabs;
    private string tab = ExerciseProgressItems.TopSetTab;
    private ChartRange range = ChartRange.ThreeMonths;
    private string? chartTitle;
    private bool flipped;
    private Func<decimal, string> format = ExerciseProgressItems.Weight;
    private bool timeScale;
    private string? caption;
    private IReadOnlyList<ChartPoint> points = [];
    private string? noDataMessage;
    private IReadOnlyList<RecordRow> records = [];
    private IReadOnlyList<ExerciseSession> sessions = [];
    private bool loading;
    private bool failed;

    /// <summary>Id of the strength or cardio exercise to show.</summary>
    [Parameter, EditorRequired]
    public int ExerciseId { get; set; }

    /// <summary>Raised by the back arrow and the Android back button.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    private bool IsCardio => definition?.Category == ExerciseCategory.Cardio;

    protected override Task OnInitializedAsync()
    {
        definition = Catalog.All.FirstOrDefault(e => e.Id == ExerciseId);
        (tabs, tab) = definition?.Category switch
        {
            ExerciseCategory.Bodyweight => (BodyweightProgressItems.Tabs(definition.Loaded), BodyweightProgressItems.BestSetTab),
            ExerciseCategory.Assisted => ([], tab),
            ExerciseCategory.Hold => (HoldProgressItems.Tabs, HoldProgressItems.DurationTab),
            ExerciseCategory.Carry => (CarryProgressItems.Tabs, CarryProgressItems.WeightTab),
            ExerciseCategory.Cardio => OnFirstTab(CardioProgressItems.Tabs(definition)),
            _ => (tabs, tab),
        };
        return LoadAsync();
    }

    /// <summary>The tabs, with the first chosen.</summary>
    private static (IReadOnlyList<RadioOption<string>> Tabs, string Tab) OnFirstTab(IReadOnlyList<RadioOption<string>> cardioTabs) =>
        (cardioTabs, cardioTabs[0].Value);

    /// <summary>
    /// Loads the exercise's sessions through <see cref="ICardioProgressService.LoadAsync"/> for cardio, otherwise
    /// <see cref="IExerciseProgressService.LoadAsync"/>, and summarises them. Shows the spinner until it finishes.
    /// </summary>
    private async Task LoadAsync()
    {
        if (loading)
        {
            return;
        }

        loading = true;
        StateHasChanged();
        if (IsCardio)
        {
            var result = await CardioProgress.LoadAsync(ExerciseId);
            loadedCardio = result.Sessions;
            failed = result.Failed;
        }
        else
        {
            var result = await Progress.LoadAsync(ExerciseId);
            loaded = result.Sessions;
            failed = result.Failed;
        }

        loading = false;
        Summarise();
    }

    private void ChooseTab(string value)
    {
        tab = value;
        Summarise();
    }

    private void ChooseRange(ChartRange value)
    {
        range = value;
        Summarise();
    }

    /// <summary>
    /// Works out the chart, records and sessions for the exercise's category, tab and range from the loaded sessions, in the phone's time zone.
    /// </summary>
    private void Summarise()
    {
        var zone = Clock.LocalTimeZone;
        var now = Clock.GetUtcNow();
        switch (definition?.Category)
        {
            case ExerciseCategory.Bodyweight:
                SummariseBodyweight(definition, zone, now);
                break;
            case ExerciseCategory.Assisted:
                SummariseAssisted(zone, now);
                break;
            case ExerciseCategory.Hold:
                SummariseHold(zone, now);
                break;
            case ExerciseCategory.Carry:
                SummariseCarry(definition, zone, now);
                break;
            case ExerciseCategory.Cardio:
                SummariseCardio(definition, zone, now);
                break;
            default:
                SummariseLift(zone, now);
                break;
        }
    }

    private void SummariseLift(TimeZoneInfo zone, DateTimeOffset now)
    {
        var progress = Progress.SummariseLift(loaded, range);
        format = tab == ExerciseProgressItems.E1rmTab ? ExerciseProgressItems.E1rm : ExerciseProgressItems.Weight;
        caption = ExerciseProgressItems.Caption(tab);
        points = ExerciseProgressItems.Points(progress, tab, zone, now);
        noDataMessage = ExerciseProgressItems.NoSets(range);
        records = ExerciseProgressItems.Records(progress, zone, now);
        sessions = ExerciseProgressItems.Sessions(progress, zone, now);
    }

    private void SummariseBodyweight(ExerciseDefinition move, TimeZoneInfo zone, DateTimeOffset now)
    {
        var progress = Progress.SummariseBodyweight(loaded, range);
        format = BodyweightProgressItems.Format(tab);
        caption = ExerciseProgressItems.Caption(tab);
        points = BodyweightProgressItems.Points(progress, tab, zone, now);
        noDataMessage = ExerciseProgressItems.NoSets(range);
        records = BodyweightProgressItems.Records(progress, move.Loaded, zone, now);
        sessions = BodyweightProgressItems.Sessions(progress, zone, now);
    }

    private void SummariseAssisted(TimeZoneInfo zone, DateTimeOffset now)
    {
        var progress = Progress.SummariseAssisted(loaded, range);
        chartTitle = AssistedProgressItems.ChartTitle;
        flipped = true;
        caption = AssistedProgressItems.Caption;
        points = AssistedProgressItems.Points(progress, zone, now);
        noDataMessage = ExerciseProgressItems.NoSets(range);
        records = AssistedProgressItems.Records(progress, zone, now);
        sessions = AssistedProgressItems.Sessions(progress, zone, now);
    }

    private void SummariseHold(TimeZoneInfo zone, DateTimeOffset now)
    {
        var progress = Progress.SummariseHold(loaded, range);
        timeScale = tab == HoldProgressItems.DurationTab;
        format = timeScale ? HoldProgressItems.Duration : ExerciseProgressItems.Weight;
        points = HoldProgressItems.Points(progress, tab, zone, now);
        noDataMessage = ExerciseProgressItems.NoSets(range);
        records = HoldProgressItems.Records(progress, zone, now);
        sessions = HoldProgressItems.Sessions(progress, zone, now);
    }

    private void SummariseCarry(ExerciseDefinition carry, TimeZoneInfo zone, DateTimeOffset now)
    {
        var progress = Progress.SummariseCarry(loaded, range);
        format = tab == CarryProgressItems.DistanceTab ? CarryProgressItems.Distance(carry) : ExerciseProgressItems.Weight;
        points = CarryProgressItems.Points(progress, tab, carry, zone, now);
        noDataMessage = ExerciseProgressItems.NoSets(range);
        records = CarryProgressItems.Records(progress, carry, zone, now);
        sessions = CarryProgressItems.Sessions(progress, carry, zone, now);
    }

    private void SummariseCardio(ExerciseDefinition cardio, TimeZoneInfo zone, DateTimeOffset now)
    {
        var progress = CardioProgress.Summarise(loadedCardio, range);
        flipped = CardioProgressItems.Flipped(tab);
        timeScale = CardioProgressItems.TimeScale(tab);
        format = CardioProgressItems.Format(cardio, tab);
        caption = CardioProgressItems.Caption(tab);
        points = CardioProgressItems.Points(progress, tab, zone, now);
        noDataMessage = CardioProgressItems.NoValues(tab, range);
        records = CardioProgressItems.Records(cardio, progress, zone, now);
        sessions = CardioProgressItems.Sessions(cardio, progress, zone, now);
    }
}
