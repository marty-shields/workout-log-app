@using Microsoft.Extensions.Logging
@using WorkoutLog.Core.Domain.Workouts
@using WorkoutLog.UI.Components.Inputs
@using WorkoutLog.UI.Components.Workout
@inject ILogger<WorkoutView> Logger
@using WorkoutLog.UI.Components.Feedback
<AppScreen Title="@DisplayFormat.Date(StartedAt)" Subtitle="@TimeText" OnBack="OnBack">
    <Actions>
        <IconButton Icon="IconName.Note" AriaLabel="@(HasNote ? "Edit note" : "Add note")" TestId="workout-note-add" OnClick="OpenNote" />
        @if (Mode == WorkoutMode.Edit)
        {
            <IconButton @ref="delete" Icon="IconName.Delete" AriaLabel="Delete" TestId="delete-workout" OnClick="OnDelete" />
        }
    </Actions>
    <ChildContent>
        <div class="exercises">
            @if (Error is not null)
            {
                <p class="error" role="alert" data-testid="workout-error">@Error</p>
            }
            <NoteField @ref="noteField" Label="Workout note" Value="@Note" ValueChanged="NoteChanged" @bind-Editing="editingNote" Error="@NoteError" TestId="workout-note" />
            @if (Exercises.Count == 0)
            {
                <EmptyState Message="No exercises yet" Hint="Tap Add exercise to start logging" TestId="no-exercises" />
            }
            @for (var i = 0; i < Exercises.Count; i++)
            {
                var exercise = Exercises[i];
                var number = i + 1;
                <ExerciseCard @key="exercise"
                              @ref="cards[exercise]"
                              Exercise="exercise"
                              OpenLastSet="@(Mode == WorkoutMode.New)"
                              ValidateSet="ValidateSet"
                              ValidateDone="ValidateDone"
                              OnChanged="OnChanged"
                              OnRemove="() => OnRemoveExercise.InvokeAsync(exercise)"
                              OnRemoveClosedSet="entry => OnRemoveSet.InvokeAsync(new SetRef(exercise, entry))"
                              TestId="@($"exercise-{number}")" />
            }
            @if (ExercisesFull)
            {
                <p class="note" data-testid="exercises-full">At most @WorkoutLimits.MaxExercises exercises</p>
            }
        </div>
    </ChildContent>
    <BottomBar>
        <AppButton @ref="addExercise" Variant="ButtonVariant.Secondary" FullWidth Disabled="ExercisesFull" TestId="add-exercise" OnClick="OnAddExercise">Add exercise</AppButton>
        <AppButton @ref="save" FullWidth TestId="save-workout" OnClick="OnSave">Save</AppButton>
    </BottomBar>
    <Status>
        @if (Undo is { } undo)
        {
            <Snackbar @key="undo" Message="@undo.Message" TakeFocus OnUndo="OnUndo" OnTimeout="() => OnUndoTimeout.InvokeAsync(undo)" />
        }
    </Status>
</AppScreen>
@Overlay

@code {
    /// <summary>New workout or edit of a saved one.</summary>
    [Parameter]
    public WorkoutMode Mode { get; set; }

    /// <summary>Start time in the phone's time zone.</summary>
    [Parameter, EditorRequired]
    public DateTime StartedAt { get; set; }

    /// <summary>Elapsed time (new) or total time (edit).</summary>
    [Parameter]
    public TimeSpan Time { get; set; }

    /// <summary>Exercises in screen order, newest first.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ExerciseState> Exercises { get; set; } = [];

    /// <summary>Workout-level validation message, e.g. when there are no exercises.</summary>
    [Parameter]
    public string? Error { get; set; }

    /// <summary>Note on the workout. Null when there is none.</summary>
    [Parameter]
    public string? Note { get; set; }

    /// <summary>Raised when the workout note changes, with the new note or null when blank.</summary>
    [Parameter]
    public EventCallback<string?> NoteChanged { get; set; }

    /// <summary>Validation message for <see cref="Note"/>, shown in the note field.</summary>
    [Parameter]
    public string? NoteError { get; set; }

    /// <summary>Raised after a value, set or entry changes.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>Checks a set or entry before moving on, and re-checks one showing errors; see <see cref="Components.Workout.ExerciseCard.ValidateSet"/>.</summary>
    [Parameter]
    public Func<ExerciseState, EntryState, bool>? ValidateSet { get; set; }

    /// <summary>Checks an exercise before it is marked done; see <see cref="Components.Workout.ExerciseCard.ValidateDone"/>.</summary>
    [Parameter]
    public Func<ExerciseState, bool>? ValidateDone { get; set; }

    /// <summary>Raised by Add exercise.</summary>
    [Parameter]
    public EventCallback OnAddExercise { get; set; }

    /// <summary>Raised by an exercise's trash; the host removes it at once and offers Undo.</summary>
    [Parameter]
    public EventCallback<ExerciseState> OnRemoveExercise { get; set; }

    /// <summary>Raised by the trash on a closed set; the host removes it at once and offers Undo.</summary>
    [Parameter]
    public EventCallback<SetRef> OnRemoveSet { get; set; }

    /// <summary>The latest deletion, shown in a snackbar with Undo above the bottom bar. Null shows none.</summary>
    [Parameter]
    public PendingUndo? Undo { get; set; }

    /// <summary>Raised by the snackbar's Undo.</summary>
    [Parameter]
    public EventCallback OnUndo { get; set; }

    /// <summary>Raised with the shown deletion when its snackbar times out.</summary>
    [Parameter]
    public EventCallback<PendingUndo> OnUndoTimeout { get; set; }

    /// <summary>Raised by Save.</summary>
    [Parameter]
    public EventCallback OnSave { get; set; }

    /// <summary>Raised by the back arrow and the Android back button.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    /// <summary>Raised by Delete. Edit mode only.</summary>
    [Parameter]
    public EventCallback OnDelete { get; set; }

    /// <summary>Moves focus to an exercise once it is shown, e.g. one just added, picked again or put back by Undo. Each request is handled once.</summary>
    [Parameter]
    public ExerciseFocus? Focus { get; set; }

    /// <summary>
    /// Moves focus once shown, after a failed Save or Delete: to the first error, or to Save or Delete when
    /// the request asks. Each request is handled once.
    /// </summary>
    [Parameter]
    public ErrorFocus? ErrorFocus { get; set; }

    /// <summary>Overlays shown above the screen: the add-exercise list or a confirm dialog.</summary>
    [Parameter]
    public RenderFragment? Overlay { get; set; }

    private readonly Dictionary<ExerciseState, ExerciseCard> cards = new();

    /// <summary>The workout has <see cref="WorkoutLimits.MaxExercises"/> exercises, so Add exercise is off.</summary>
    private bool ExercisesFull => Exercises.Count >= WorkoutLimits.MaxExercises;
    private ExerciseFocus? handled;
    private ErrorFocus? handledError;
    private NoteField? noteField;
    private bool editingNote;
    private AppButton? addExercise;
    private AppButton? save;
    private IconButton? delete;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        foreach (var removed in cards.Keys.Where(e => !Exercises.Contains(e)).ToList())
        {
            cards.Remove(removed);
        }

        await FocusFirstErrorAsync();
        if (Focus is null || ReferenceEquals(Focus, handled) || !cards.TryGetValue(Focus.Exercise, out var card))
        {
            return;
        }

        handled = Focus;
        try
        {
            switch (Focus.Target)
            {
                case ExerciseFocusTarget.AddedSet:
                    await card.AddSetAndFocusAsync();
                    break;
                case ExerciseFocusTarget.Restored:
                    await card.FocusRestoredAsync(Focus.Set);
                    break;
                default:
                    await card.FocusAsync();
                    break;
            }
        }
        catch (OperationCanceledException)
        {
            // The card was removed before focus moved.
        }
        catch (Exception exception)
        {
            Log.FocusFailed(Logger, exception);
        }
    }

    /// <summary>Handles <see cref="ErrorFocus"/>: Save or Delete when asked, Add exercise for a workout error, the workout note for a note error, otherwise the first card with an error.</summary>
    private async Task FocusFirstErrorAsync()
    {
        if (ErrorFocus is null || ReferenceEquals(ErrorFocus, handledError))
        {
            return;
        }

        handledError = ErrorFocus;
        try
        {
            if (ErrorFocus.Target == ErrorFocusTarget.Save && save is not null)
            {
                await save.FocusAsync();
            }
            else if (ErrorFocus.Target == ErrorFocusTarget.Delete && delete is not null)
            {
                await delete.FocusAsync();
            }
            else if (Error is not null && addExercise is not null)
            {
                await addExercise.FocusAsync();
            }
            else if (NoteError is not null && noteField is not null)
            {
                await noteField.FocusAsync();
            }
            else if (Exercises.FirstOrDefault(e => e.HasError) is { } exercise && cards.TryGetValue(exercise, out var card))
            {
                await card.FocusFirstErrorAsync();
            }
        }
        catch (Exception exception)
        {
            Log.ErrorFocusFailed(Logger, exception);
        }
    }

    private bool HasNote => !string.IsNullOrWhiteSpace(Note);

    private void OpenNote() => editingNote = true;

    private string TimeText => Mode == WorkoutMode.New
        ? $"Elapsed {DisplayFormat.Duration(Time)}"
        : $"Total {DisplayFormat.Duration(Time)}";
}
