@using WorkoutLog.Core.Services
@using WorkoutLog.UI.Models.Workouts
@inject IWorkoutsService Workouts
@inject TimeProvider Clock

<WorkoutsView Rows="rows" Loading="loading" Failed="failed" OnRetry="LoadAsync" OnOpen="row => OnOpen.InvokeAsync(row.Id)" OnNavigate="OnNavigate" />

@code {
    private IReadOnlyList<WorkoutsRow> rows = [];
    private bool loading;
    private bool failed;

    /// <summary>Raised with the workout id when a row is tapped.</summary>
    [Parameter]
    public EventCallback<int> OnOpen { get; set; }

    /// <summary>Raised with the destination tapped in the bottom navigation bar, and with the Dashboard on Android back.</summary>
    [Parameter]
    public EventCallback<NavDestination> OnNavigate { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (loading)
        {
            return;
        }

        loading = true;
        StateHasChanged();
        var result = await Workouts.GetAllAsync();
        rows = result.Workouts
            .Select(w => new WorkoutsRow(w.Id, TimeZoneInfo.ConvertTime(w.StartedAt, Clock.LocalTimeZone).DateTime))
            .ToList();
        failed = result.Failed;
        loading = false;
    }
}
