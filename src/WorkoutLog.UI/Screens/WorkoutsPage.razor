@using WorkoutLog.Core.Domain
@using WorkoutLog.Core.Services
@using WorkoutLog.UI.Lifecycle
@using WorkoutLog.UI.Models.Workouts
@implements IDisposable
@inject IWorkoutsService Workouts
@inject TimeProvider Clock
@inject IAppStart AppStart

<WorkoutsView History="History" Rows="rows" Dates="dates" DatesChanged="ShowAsync" @bind-Expanded="expanded" Loading="loading" Failed="failed"
              OnRetry="RetryAsync" OnOpen="row => OnOpen.InvokeAsync(row.Id)" OnNavigate="OnNavigate" />

@code {
    private WorkoutHistory? loaded;
    private IReadOnlyList<WorkoutsRow> rows = [];
    private DateSpan dates;
    private bool expanded;
    private bool loading;
    private bool failed;
    private int query;
    private IDisposable? registration;
    private bool disposed;

    /// <summary>Raised with the workout id when a row is tapped.</summary>
    [Parameter]
    public EventCallback<int> OnOpen { get; set; }

    /// <summary>Raised with the destination tapped in the bottom navigation bar, and with the Dashboard on Android back.</summary>
    [Parameter]
    public EventCallback<NavDestination> OnNavigate { get; set; }

    private WorkoutHistory History => loaded ?? WorkoutHistory.None;

    protected override Task OnInitializedAsync()
    {
        registration = AppStart.Register(() => InvokeAsync(ReloadAsync));
        return LoadAsync();
    }

    public void Dispose()
    {
        disposed = true;
        registration?.Dispose();
    }

    // Try again after a failed range read reads only that range again.
    private Task RetryAsync() => loaded is null ? LoadAsync() : ShowAsync(dates);

    private async Task LoadAsync()
    {
        if (loading)
        {
            return;
        }

        (loading, failed) = (true, false);
        StateHasChanged();
        await FetchAsync();
    }

    /// <summary>
    /// Reads the per-day counts with today taken afresh, then the rows. Dates that match a quick range move with today; dates
    /// picked in the calendar stay. Does nothing more once the page is disposed or other dates are chosen.
    /// </summary>
    private async Task FetchAsync()
    {
        var current = ++query;
        var days = await Workouts.GetDaysAsync();
        if (disposed || current != query)
        {
            return;
        }

        if (days.Failed)
        {
            (loading, failed, expanded) = (false, true, false);
            return;
        }

        var range = loaded is null ? HistoryRange.ThreeMonths : loaded.RangeOf(dates);
        loaded = new WorkoutHistory(days.PerDay, DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), Clock.LocalTimeZone).DateTime));
        var shown = range is { } quick ? loaded.Span(quick) : dates;
        if (loaded.IsEmpty)
        {
            (dates, rows, loading, failed) = (shown, [], false, false);
            return;
        }

        await ShowAsync(shown);
    }

    private async Task ShowAsync(DateSpan shown)
    {
        var current = ++query;
        (dates, loading, failed) = (shown, true, false);
        StateHasChanged();
        var result = await Workouts.GetBetweenAsync(shown.From, shown.To);
        if (disposed || current != query)
        {
            return;
        }

        rows = [.. result.Workouts.Select(w => new WorkoutsRow(w.Id, TimeZoneInfo.ConvertTime(w.StartedAt, Clock.LocalTimeZone).DateTime))];
        (loading, failed) = (false, result.Failed);
        expanded &= !failed;
    }

    /// <summary>Loads again when the app comes back on screen. Does nothing once the page is disposed, before or during the load.</summary>
    private async Task ReloadAsync()
    {
        if (disposed)
        {
            return;
        }

        await LoadAsync();
        if (!disposed)
        {
            StateHasChanged();
        }
    }
}
