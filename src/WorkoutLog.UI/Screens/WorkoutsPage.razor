@using WorkoutLog.Core.Domain
@using WorkoutLog.Core.Domain.Workouts
@using WorkoutLog.Core.Services
@using WorkoutLog.UI.Lifecycle
@using WorkoutLog.UI.Models.Workouts
@implements IDisposable
@inject IWorkoutsService Workouts
@inject IWorkoutTotalsService Totals
@inject TimeProvider Clock
@inject IAppStart AppStart

<WorkoutsView History="History" Rows="rows" Totals="totals" Dates="dates" DatesChanged="ShowAsync" @bind-Expanded="expanded" Loading="loading" Failed="failure is not Failure.None"
              OnRetry="RetryAsync" OnRefresh="() => LoadAsync(PullRefresh.MinimumSpinner)" OnOpen="row => OnOpen.InvokeAsync(row.Id)" OnNavigate="OnNavigate" />

@code {
    private enum Failure { None, Counts, Range }

    private WorkoutHistory? loaded;
    private IReadOnlyList<WorkoutsRow> rows = [];
    private WorkoutTotals? totals;
    private DateSpan dates;
    private bool expanded;
    private bool loading;
    private Failure failure;
    private int query;
    private IDisposable? registration;
    private bool disposed;

    /// <summary>Raised with the workout id when a row is tapped.</summary>
    [Parameter]
    public EventCallback<int> OnOpen { get; set; }

    /// <summary>Raised with the destination tapped in the bottom navigation bar, and with the Dashboard on Android back.</summary>
    [Parameter]
    public EventCallback<NavDestination> OnNavigate { get; set; }

    private WorkoutHistory History => loaded ?? WorkoutHistory.None;

    protected override Task OnInitializedAsync()
    {
        registration = AppStart.Register(() => InvokeAsync(ReloadAsync));
        return LoadAsync();
    }

    public void Dispose()
    {
        disposed = true;
        registration?.Dispose();
    }

    private Task RetryAsync() => failure is Failure.Counts ? LoadAsync() : ShowAsync(dates);

    /// <summary>
    /// Shows the spinner and reads the per-day counts with today taken afresh, then the rows. Dates that match a quick range move
    /// with today; dates picked in the calendar stay. Does nothing while a load runs, and nothing more once the page is disposed
    /// or other dates are chosen.
    /// </summary>
    private async Task LoadAsync(TimeSpan minimum = default)
    {
        if (loading)
        {
            return;
        }

        (loading, failure) = (true, Failure.None);
        StateHasChanged();
        var minimumElapsed = Task.Delay(minimum, Clock);
        var current = ++query;
        var days = await Workouts.GetDaysAsync();
        if (disposed || current != query)
        {
            return;
        }

        if (days is not IReadOnlyDictionary<DateOnly, int> perDay)
        {
            (failure, expanded) = (Failure.Counts, false);
            await HideSpinnerIfLatestAsync(current, minimumElapsed);
            return;
        }

        var range = loaded is null ? HistoryRange.ThreeMonths : loaded.RangeOf(dates);
        loaded = new WorkoutHistory(perDay, DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), Clock.LocalTimeZone).DateTime));
        var shown = range is { } quick ? loaded.Span(quick) : dates;
        if (loaded.IsEmpty)
        {
            (dates, rows, totals) = (shown, [], null);
            await HideSpinnerIfLatestAsync(current, minimumElapsed);
            return;
        }

        await ReadAsync(shown, minimumElapsed);
    }

    private Task ShowAsync(DateSpan shown)
    {
        (loading, failure) = (true, Failure.None);
        return ReadAsync(shown, Task.CompletedTask);
    }

    /// <summary>Does nothing more once the page is disposed or other dates are chosen.</summary>
    private async Task ReadAsync(DateSpan shown, Task minimumElapsed)
    {
        var current = ++query;
        dates = shown;
        StateHasChanged();
        var rangeRead = Workouts.GetBetweenAsync(shown.From, shown.To);
        var totalsRead = Totals.GetAsync(shown.From, shown.To);
        var result = await rangeRead;
        var totalsResult = await totalsRead;
        if (disposed || current != query)
        {
            return;
        }

        IReadOnlyList<WorkoutSummary> workouts = result switch
        {
            IReadOnlyList<WorkoutSummary> read => read,
            ReadFailed => [],
        };
        rows = [.. workouts.Select(w => new WorkoutsRow(w.Id, TimeZoneInfo.ConvertTime(w.StartedAt, Clock.LocalTimeZone).DateTime))];
        totals = totalsResult is WorkoutTotals loadedTotals ? loadedTotals : null;
        failure = result is ReadFailed ? Failure.Range : Failure.None;
        expanded &= failure is Failure.None;
        await HideSpinnerIfLatestAsync(current, minimumElapsed);
    }

    private async Task HideSpinnerIfLatestAsync(int current, Task minimumElapsed)
    {
        await minimumElapsed;
        if (!disposed && current == query)
        {
            loading = false;
        }
    }

    /// <summary>Loads again when the app comes back on screen. Does nothing once the page is disposed, before or during the load.</summary>
    private async Task ReloadAsync()
    {
        if (disposed)
        {
            return;
        }

        await LoadAsync();
        if (!disposed)
        {
            StateHasChanged();
        }
    }
}
