@using Microsoft.Extensions.Logging
@using WorkoutLog.Core.Services
@using WorkoutLog.UI.Import
@using WorkoutLog.UI.Lifecycle
@using WorkoutLog.UI.Models.Settings
@using WorkoutLog.UI.Sharing
@using WorkoutLog.UI.Theme
@using WorkoutLog.UI.Versioning
@implements IDisposable
@inject IExportService Export
@inject IFileShare FileShare
@inject IAppVersion AppVersion
@inject IImportFileOpener Opener
@inject ImportSession Session
@inject IAppStart AppStart
@inject ThemeService Themes
@inject ILogger<SettingsPage> Logger

<SettingsView Loading="phase == SettingsPhase.Loading" Failed="phase == SettingsPhase.LoadFailed" Count="count"
              Exporting="phase == SettingsPhase.Exporting" ExportMessage="message"
              Reading="phase == SettingsPhase.Reading" ImportFailed="phase == SettingsPhase.ImportFailed" Imported="imported"
              Theme="theme" Version="@AppVersion.Current" OnThemeChanged="SetThemeAsync"
              OnRetry="LoadAsync" OnExport="ExportAsync" OnImport="ImportAsync" OnBack="OnBack" />

@code {
    private enum SettingsPhase
    {
        Idle,
        Loading,
        LoadFailed,
        Exporting,
        Reading,
        ImportFailed,
    }

    private SettingsPhase phase;
    private int count;
    private ThemePreference theme;
    private ExportMessage message;
    private Imported? imported;
    private bool Busy => phase is SettingsPhase.Loading or SettingsPhase.Exporting or SettingsPhase.Reading;

    private IDisposable? registration;
    private bool disposed;

    /// <summary>Raised by the back arrow and the Android back button.</summary>
    [Parameter]
    public EventCallback OnBack { get; set; }

    /// <summary>Raised when a picked file is read and <see cref="ImportSession.Review"/> holds it.</summary>
    [Parameter]
    public EventCallback OnImportReview { get; set; }

    /// <summary>Loads the count, then shows the finished import from <see cref="ImportSession"/>, once.</summary>
    protected override async Task OnInitializedAsync()
    {
        registration = AppStart.Register(() => InvokeAsync(ReloadAsync));
        var done = Session.TakeDone();
        var loading = LoadAsync();
        theme = await LoadThemeAsync();
        await loading;
        imported = done;
    }

    public void Dispose()
    {
        disposed = true;
        registration?.Dispose();
    }

    /// <summary>
    /// Loads the workout count and clears the messages. Shows the spinner until it finishes.
    /// Ignored while a load, an export or a read runs. Does nothing more once the page is disposed.
    /// </summary>
    private async Task LoadAsync()
    {
        if (Busy)
        {
            return;
        }

        phase = SettingsPhase.Loading;
        ClearMessages();
        var result = await Export.CountAsync();
        if (disposed)
        {
            return;
        }

        (count, phase) = result switch
        {
            int saved => (saved, SettingsPhase.Idle),
            ReadFailed => (0, SettingsPhase.LoadFailed),
        };
    }

    /// <summary>
    /// Loads again when the app comes back on screen. Does nothing once the page is disposed, before or during the load.
    /// Not an event handler, so it renders the spinner and the result itself.
    /// </summary>
    private async Task ReloadAsync()
    {
        if (disposed)
        {
            return;
        }

        var loading = LoadAsync();
        StateHasChanged();
        await loading;
        if (!disposed)
        {
            StateHasChanged();
        }
    }

    /// <summary>
    /// Writes the file and opens the share sheet. Shows Export busy until both finish; taps meanwhile are ignored.
    /// A failed export or share shows the failed message; a file too large shows Too many workouts.
    /// Once the page is disposed, the share sheet doesn't open.
    /// </summary>
    private async Task ExportAsync()
    {
        if (Busy)
        {
            return;
        }

        phase = SettingsPhase.Exporting;
        ClearMessages();
        var result = await Export.ExportAsync();
        if (disposed)
        {
            return;
        }

        if (result is ExportedFile file)
        {
            try
            {
                await FileShare.ShareAsync(file.FilePath, "Export workouts");
            }
            catch (Exception exception)
            {
                Log.ShareFailed(Logger, exception);
                message = ExportMessage.Failed;
            }
        }
        else
        {
            message = result is ExportTooLarge ? ExportMessage.TooLarge : ExportMessage.Failed;
        }

        phase = SettingsPhase.Idle;
    }

    /// <summary>
    /// Picks and reads a file, showing Import busy until it finishes; taps meanwhile are ignored. Cancelling the picker changes nothing.
    /// A failed pick or read shows the failed message; any other result opens Import Review.
    /// Does nothing more once the page is disposed.
    /// </summary>
    private async Task ImportAsync()
    {
        if (Busy)
        {
            return;
        }

        phase = SettingsPhase.Reading;
        ClearMessages();
        ImportReview? review = null;
        var pickFailed = false;
        try
        {
            review = await Opener.OpenAsync();
        }
        catch (Exception exception)
        {
            Log.PickFailed(Logger, exception);
            pickFailed = true;
        }

        if (disposed)
        {
            return;
        }

        if (review is null || review.Error == ImportError.Failed)
        {
            phase = pickFailed || review is not null ? SettingsPhase.ImportFailed : SettingsPhase.Idle;
            return;
        }

        phase = SettingsPhase.Idle;

        Session.Review = review;
        await OnImportReview.InvokeAsync();
    }

    /// <summary>The saved theme, or System when it can't be read.</summary>
    private async Task<ThemePreference> LoadThemeAsync()
    {
        try
        {
            return await Themes.GetAsync();
        }
        catch (Exception exception)
        {
            Log.ThemeLoadFailed(Logger, exception);
            return ThemePreference.System;
        }
    }

    /// <summary>Applies and saves the choice. A failed interop call keeps the previous choice selected; a refused save keeps the new one, which applies until the app closes.</summary>
    private async Task SetThemeAsync(ThemePreference preference)
    {
        try
        {
            var saved = await Themes.SetAsync(preference);
            theme = preference;
            if (!saved)
            {
                Log.ThemeNotSaved(Logger);
            }
        }
        catch (Exception exception)
        {
            Log.ThemeSaveFailed(Logger, exception);
        }
    }

    private void ClearMessages()
    {
        message = ExportMessage.None;
        imported = null;
    }
}
