@using WorkoutLog.Core.Domain.Exercises
@using WorkoutLog.UI.Models.Exercises
<div class="picker" role="dialog" aria-modal="true" aria-label="Add exercise" data-testid="add-exercise-overlay">
    <AppScreen Title="Exercises" OnBack="OnClose" BackTestId="add-exercise-back" Toolbar="Tools" ToolbarDivider>
        @if (Loading)
        {
            <div class="centre">
                <Spinner Label="Loading…" TestId="add-exercise-loading" />
            </div>
        }
        else
        {
            <ExerciseList Items="Items" OnPick="OnPick" TestId="add-exercise" />
        }
    </AppScreen>
</div>

@code {
    /// <summary>Exercises to list, already searched and filtered, in order, in their groups.</summary>
    [Parameter, EditorRequired]
    public ExerciseListGroups Items { get; set; } = ExerciseListGroups.None;

    /// <summary>Search text.</summary>
    [Parameter]
    public string? Query { get; set; }

    /// <summary>Raised on each keystroke with the new search text.</summary>
    [Parameter]
    public EventCallback<string> QueryChanged { get; set; }

    /// <summary>Chosen chip.</summary>
    [Parameter]
    public AddExerciseFilter Filter { get; set; }

    /// <summary>Raised with the chip tapped.</summary>
    [Parameter]
    public EventCallback<AddExerciseFilter> FilterChanged { get; set; }

    /// <summary>Shows a spinner instead of the rows while the exercises load. The search and chips stay.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Raised with the row tapped. Rows are not tappable when unset.</summary>
    [Parameter]
    public EventCallback<ExerciseListItem> OnPick { get; set; }

    /// <summary>Raised by the back arrow and Android back.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private Task OnQuery(string text) =>
        QueryChanged.InvokeAsync(text.Length > ExerciseCatalog.MaxQueryLength ? text[..ExerciseCatalog.MaxQueryLength] : text);

    private static readonly IReadOnlyList<RadioOption<AddExerciseFilter>> Filters =
    [
        new(AddExerciseFilter.All, "All", "add-exercise-filter-all"),
        new(AddExerciseFilter.Strength, "Strength", "add-exercise-filter-strength"),
        new(AddExerciseFilter.Cardio, "Cardio", "add-exercise-filter-cardio"),
    ];

    /// <summary>How many exercises the list shows, announced politely as the search or chip changes it; empty while it loads.</summary>
    private string ResultText => Loading ? "" : Items.Count == 1 ? "1 exercise" : $"{Items.Count} exercises";

    private RenderFragment Tools =>
        @<div class="tools">
            <SearchField Value="@Query" ValueChanged="OnQuery" Placeholder="Search exercises" AriaLabel="Search exercises"
                         MaxLength="ExerciseCatalog.MaxQueryLength" FocusOnShow ResultText="@ResultText" TestId="add-exercise-search" />
            <FilterChips TValue="AddExerciseFilter" Label="Type" Options="Filters" Value="Filter" ValueChanged="FilterChanged" TestId="add-exercise-filter" />
        </div>;
}
