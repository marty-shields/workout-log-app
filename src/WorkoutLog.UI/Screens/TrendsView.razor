@using System.Globalization
@using WorkoutLog.Core.Domain.Workouts.Periods
@using WorkoutLog.UI.Components.Weekly
@using WorkoutLog.UI.Components.Inputs
@using WorkoutLog.UI.Components.ThisWeek
@using WorkoutLog.UI.Components.Trends
@using WorkoutLog.UI.Models.Muscles
@using WorkoutLog.UI.Models.Workouts
<AppScreen Title="Trends" NavItems="MainTabs.Items" Current="MainTabs.Item(MainTab.Trends)" OnNavigate="item => OnNavigate.InvokeAsync(MainTabs.Tab(item))"
           AddLabel="@MainTabs.AddLabel" AddIcon="MainTabs.AddIcon" OnAdd="OnNew" OnRefresh="OnRefresh">
    <Actions>
        <IconButton Icon="IconName.Settings" AriaLabel="Settings" TestId="settings" OnClick="OnSettings" />
    </Actions>
    <ChildContent>
        <div class="cards">
            @if (Kinds.Count > 1)
            {
                <SegmentedControl TValue="PeriodKind" Label="Period" Options="KindOptions" Value="Kind" ValueChanged="OnKindChanged" TestId="trends-kind" />
            }
            <Shields.UI.Components.Navigation.PeriodStepper Kind="StepperKind" Label="@Label" CanGoPrevious="CanGoPrevious" CanGoNext="CanGoNext"
                                                           OnPrevious="OnPrevious" OnNext="OnNext" TestId="trends-stepper" />
            @if (Loading)
            {
                <div class="centre">
                    <Spinner Label="Loading…" TestId="trends-loading" />
                </div>
            }
            else if (Failed)
            {
                <LoadFailed RetryVariant="ButtonVariant.Secondary" Message="Couldn't load Trends" OnRetry="OnRetry" TestId="trends" />
            }
            else
            {
                <TrendTiles Kind="Kind" Totals="Totals" Earlier="Earlier" Against="@Against" TestId="trends-tiles" />
                @if (Kind == PeriodKind.Week)
                {
                    <Card Title="Time trained by day" TestId="trends-days">
                        @if (Days.Any(day => day.Value > 0 || day.Earlier > 0))
                        {
                            <ChartLegend Items="DaysLegend" TestId="trends-days-chart-legend" />
                        }
                        <TrendBarChart Bars="Points(Days)" Style="TrendBarStyle.PastAndCurrent" Max="Top(Days)" Unit="min" EarlierLabel="@EarlierLabel"
                                       Label="@($"Time trained each day {Name} beside the same day {EarlierLabel}")"
                                       EmptyText="@($"No workouts {Name}")" OnSelect="Open(Days)" TestId="trends-days-chart" />
                    </Card>
                    <MuscleSetsCard Groups="Muscles" Period="@Name" TestId="trends-muscles" />
                    <Card Title="Records" Aside="@($"{Records.Count} {Name}")" TestId="trends-records">
                        <RecordRows Records="Records" EmptyText="@($"No new records {Name}")" OnOpen="OnOpenRecord" TestId="trends-records" />
                    </Card>
                    <Card Title="Last 12 weeks" Aside="@(Streak > 0 ? $"{Streak}-week streak" : null)" TestId="trends-recent-weeks">
                        <WeekBars Counts="RecentWeeks" TestId="trends-recent-weeks-chart" />
                    </Card>
                }
                else if (Kind == PeriodKind.Month)
                {
                    <Card Title="Each day" TestId="trends-calendar">
                        <MonthCalendar Month="Start" Today="Today" Days="TrainedDays" DayNames="DayInitials" Style="CalendarStyle.Marks" OnSelect="OpenDay" TestId="trends-calendar-days" />
                        <ChartLegend Items="CalendarLegend" TestId="trends-calendar-days-legend" />
                    </Card>
                    <Card Title="Weeks" TestId="trends-weeks">
                        <MonthWeeks Weeks="Weeks" OnOpen="OnOpenWorkouts" TestId="trends-weeks-rows" />
                    </Card>
                    <Card Title="Records" Aside="@($"{Records.Count} {Name}")" TestId="trends-records">
                        <RecordRows Records="Records" EmptyText="@($"No new records {Name}")" OnOpen="OnOpenRecord" TestId="trends-records" />
                    </Card>
                    <Card Title="Most trained" Aside="sessions" TestId="trends-most-trained">
                        <BarList Items="Items(MostTrained)" Inline LabelWidth="BarListLabelWidth.Wide" ValueWidth="BarListValueWidth.Narrow" Unit="sessions"
                                 Label="@($"Sessions of the most trained exercises {Name}")" EmptyText="@($"No exercises {Name}")" AllZeroText="@($"No exercises {Name}")"
                                 OnSelect="OpenExercise" TestIdBy="BarListTestIdBy.Slug" TestId="trends-most-trained-rows" />
                    </Card>
                }
                else
                {
                    <Card Title="Workouts by month" Aside="@(PerWeek > 0 ? $"{PerWeek.ToString("0.#", CultureInfo.InvariantCulture)} a week" : null)" TestId="trends-months">
                        <TrendBarChart Bars="Points(Months)" Style="TrendBarStyle.PastAndCurrent" Max="Top(Months)" Unit="workouts" DateFormat="MMMM yyyy"
                                       Label="@($"Workouts in each month of {Label}")" EmptyText="@($"No workouts {Name}")" OnSelect="Open(Months)" TestId="trends-months-chart" />
                    </Card>
                    <LongestStreakCard Weeks="LongestStreak" Running="StreakRunning" TestId="trends-streak" />
                    <Card Title="Records by month" Aside="@($"{RecordsByMonth.Sum(m => m.Value)} {Name}")" TestId="trends-records-by-month">
                        <BarList Items="Items(RecordsByMonth)" Inline LabelWidth="BarListLabelWidth.Narrow" ValueWidth="BarListValueWidth.Narrow" Unit="records"
                                 Label="@($"Records set in each month of {Label}")" EmptyText="@($"No records {Name}")" AllZeroText="@($"No records {Name}")"
                                 TestIdBy="BarListTestIdBy.Slug" TestId="trends-records-by-month-rows" />
                    </Card>
                }
            }
        </div>
    </ChildContent>
</AppScreen>

@code {
    private static readonly IReadOnlyList<RadioOption<PeriodKind>> AllKindOptions =
    [
        new(PeriodKind.Week, "Week", "trends-week"),
        new(PeriodKind.Month, "Month", "trends-month"),
        new(PeriodKind.Year, "Year", "trends-year"),
    ];

    /// <summary>The kinds offered, in the order of the control. The control is left out when there is only one.</summary>
    [Parameter]
    public IReadOnlyList<PeriodKind> Kinds { get; set; } = [PeriodKind.Week, PeriodKind.Month, PeriodKind.Year];

    private Shields.UI.Components.Navigation.PeriodKind StepperKind => Kind switch
    {
        PeriodKind.Week => Shields.UI.Components.Navigation.PeriodKind.Week,
        PeriodKind.Month => Shields.UI.Components.Navigation.PeriodKind.Month,
        PeriodKind.Year => Shields.UI.Components.Navigation.PeriodKind.Year,
        _ => throw new ArgumentOutOfRangeException(nameof(Kind), Kind, null),
    };

    private IReadOnlyList<RadioOption<PeriodKind>> KindOptions => [.. AllKindOptions.Where(o => Kinds.Contains(o.Value))];

    /// <summary>The period shown: the week, month or year.</summary>
    [Parameter, EditorRequired]
    public PeriodKind Kind { get; set; }

    /// <summary>The period's name in the stepper: 16 – 22 Nov, November 2026 or 2026.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>The period is over, so the cards say "that week" and the paired bars "the week before" in place of "this week" and "last week".</summary>
    [Parameter]
    public bool Past { get; set; }

    /// <summary>False disables the previous arrow.</summary>
    [Parameter]
    public bool CanGoPrevious { get; set; }

    /// <summary>False disables the next arrow.</summary>
    [Parameter]
    public bool CanGoNext { get; set; }

    /// <summary>The period's totals, so far when it holds today.</summary>
    [Parameter]
    public TrendTotals Totals { get; set; } = new(0, TimeSpan.Zero, 0, 0);

    /// <summary>The period before, up to the same point in it when this one holds today.</summary>
    [Parameter]
    public TrendTotals Earlier { get; set; } = new(0, TimeSpan.Zero, 0, 0);

    /// <summary>What the tiles compare with, e.g. Against Monday to Wednesday last week.</summary>
    [Parameter]
    public string Against { get; set; } = "";

    /// <summary>Week: time trained on each day, Monday to Sunday, with the same day the week before.</summary>
    [Parameter]
    public IReadOnlyList<TrendBar> Days { get; set; } = [];

    /// <summary>Week: sets per muscle group.</summary>
    [Parameter]
    public IReadOnlyList<MuscleGroupSets> Muscles { get; set; } = [];

    /// <summary>Week and month: records set in the period, newest first.</summary>
    [Parameter]
    public IReadOnlyList<WeekRecord> Records { get; set; } = [];

    /// <summary>Week: workouts in each of the last 12 weeks, oldest first.</summary>
    [Parameter]
    public IReadOnlyList<int> RecentWeeks { get; set; } = [];

    /// <summary>Week: consecutive weeks with a workout; hidden at 0.</summary>
    [Parameter]
    public int Streak { get; set; }

    /// <summary>Month: any day of the month, for the calendar.</summary>
    [Parameter]
    public DateOnly Start { get; set; }

    /// <summary>Month: today, in the phone's time zone.</summary>
    [Parameter]
    public DateOnly Today { get; set; }

    /// <summary>Month: days with a workout.</summary>
    [Parameter]
    public IReadOnlyCollection<DateOnly> Trained { get; set; } = [];

    /// <summary>Month: a row per week.</summary>
    [Parameter]
    public IReadOnlyList<MonthWeek> Weeks { get; set; } = [];

    /// <summary>Month: the exercises done in most sessions, most first.</summary>
    [Parameter]
    public IReadOnlyList<MeterRow> MostTrained { get; set; } = [];

    /// <summary>Year: workouts in each month, January to December.</summary>
    [Parameter]
    public IReadOnlyList<TrendBar> Months { get; set; } = [];

    /// <summary>Year: workouts a week on average; hidden at 0.</summary>
    [Parameter]
    public double PerWeek { get; set; }

    /// <summary>Year: the longest run of consecutive weeks with a workout.</summary>
    [Parameter]
    public int LongestStreak { get; set; }

    /// <summary>Year: the longest run is still going.</summary>
    [Parameter]
    public bool StreakRunning { get; set; }

    /// <summary>Year: records set in each month, January to December.</summary>
    [Parameter]
    public IReadOnlyList<MeterRow> RecordsByMonth { get; set; } = [];

    /// <summary>Shows a spinner instead of the period's cards while it loads. The controls above stay.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>Shows the load error and Try again instead of the period's cards, and moves focus to Try again.</summary>
    [Parameter]
    public bool Failed { get; set; }

    /// <summary>Raised with the kind picked in the Week, Month, Year control.</summary>
    [Parameter]
    public EventCallback<PeriodKind> OnKindChanged { get; set; }

    /// <summary>Raised by the previous arrow.</summary>
    [Parameter]
    public EventCallback OnPrevious { get; set; }

    /// <summary>Raised by the next arrow.</summary>
    [Parameter]
    public EventCallback OnNext { get; set; }

    /// <summary>Raised by Try again.</summary>
    [Parameter]
    public EventCallback OnRetry { get; set; }

    /// <summary>Raised by pulling the content down, to load it again. No pull without it.</summary>
    [Parameter]
    public EventCallback OnRefresh { get; set; }

    /// <summary>Raised by the Settings gear.</summary>
    [Parameter]
    public EventCallback OnSettings { get; set; }

    /// <summary>Raised by the New button in the bottom navigation bar.</summary>
    [Parameter]
    public EventCallback OnNew { get; set; }

    /// <summary>Raised with the tab tapped in the bottom navigation bar.</summary>
    [Parameter]
    public EventCallback<MainTab> OnNavigate { get; set; }

    /// <summary>
    /// Raised with the days when a day with a workout in the month calendar, a week row, a day's column in the week view or a month's column in the year view is tapped.
    /// Not tappable when unset.
    /// </summary>
    [Parameter]
    public EventCallback<DateSpan> OnOpenWorkouts { get; set; }

    /// <summary>Raised with the exercise id when a record row, or in the month a Most trained row, is tapped. Rows are not tappable when unset.</summary>
    [Parameter]
    public EventCallback<int> OnOpenRecord { get; set; }

    private static readonly IReadOnlyList<LegendItem> CalendarLegend =
    [
        new(LegendSwatch.Primary, "Trained"),
        new(LegendSwatch.Outline, "No workout"),
        new(LegendSwatch.Today, "Today"),
    ];

    /// <summary>Sunday first, as the kit's <c>DayNames</c> expects; the calendar starts on Monday.</summary>
    private static readonly IReadOnlyList<string> DayInitials = ["S", "M", "T", "W", "T", "F", "S"];

    private IReadOnlyList<CalendarDay> TrainedDays => Trained.Select(day => new CalendarDay(day, 1)).ToList();

    private EventCallback<DateOnly> OpenDay =>
        OnOpenWorkouts.HasDelegate ? EventCallback.Factory.Create<DateOnly>(this, day => OnOpenWorkouts.InvokeAsync(new DateSpan(day, day))) : default;

    private IReadOnlyList<LegendItem> DaysLegend =>
    [
        new(LegendSwatch.Accent, Past ? "That week" : "This week"),
        new(LegendSwatch.Past, Past ? "The week before" : "Last week"),
    ];

    private string EarlierLabel => Past ? "the week before" : "last week";

    private static IReadOnlyList<TrendBarPoint> Points(IReadOnlyList<TrendBar> bars) =>
        [.. bars.Select(bar => new TrendBarPoint(bar.Date, bar.Label, bar.Value, Current: bar.Current, Labelled: bar.Labelled, Earlier: bar.Earlier, Selectable: bar.Span is not null))];

    /// <summary>The top of the chart's scale: the biggest value drawn, at least 1, so a period's bars fill the chart as before.</summary>
    private static double Top(IReadOnlyList<TrendBar> bars) =>
        Math.Max(1, bars.Select(bar => Math.Max(bar.Value, bar.Earlier)).DefaultIfEmpty(0).Max());

    private EventCallback<DateOnly> Open(IReadOnlyList<TrendBar> bars) =>
        OnOpenWorkouts.HasDelegate
            ? EventCallback.Factory.Create<DateOnly>(this, async date =>
            {
                if (bars.First(bar => bar.Date == date).Span is { } span)
                {
                    await OnOpenWorkouts.InvokeAsync(span);
                }
            })
            : default;

    private static IReadOnlyList<BarListItem> Items(IReadOnlyList<MeterRow> rows) =>
        [.. rows.Select(row => new BarListItem(row.Label, row.Value, Selectable: row.ExerciseId is not null))];

    private EventCallback<int> OpenExercise =>
        OnOpenRecord.HasDelegate
            ? EventCallback.Factory.Create<int>(this, index => OnOpenRecord.InvokeAsync(MostTrained[index].ExerciseId!.Value))
            : default;

    /// <summary>The period as it reads in the cards: this week, or that week once it is over.</summary>
    private string Name => $"{(Past ? "that" : "this")} {Kind.ToString().ToLowerInvariant()}";
}
