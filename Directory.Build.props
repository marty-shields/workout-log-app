<!-- Applies to every project in the repo. A project's own value overrides one set here. -->
<Project>

  <PropertyGroup>
    <NetVersion>net11.0</NetVersion>
    <TargetFramework>$(NetVersion)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Pinned so an SDK bump cannot switch on new rules; move it in a deliberate PR, such as the next .NET version bump. -->
    <AnalysisLevel>11.0-recommended</AnalysisLevel>
    <!-- IDE0005 (unused usings) only runs in the build when XML documentation is generated. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A public member needs no XML comment (CS1591), nor a param tag for each parameter (CS1573); a comment is written only where it says more than the name. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <!-- Compiler and NuGet warnings fail the build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- MSBuild task warnings (including the Android XA ones) fail the build. -->
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <!-- NuGet audit covers transitive packages too; NU1901-NU1904 are warnings, so a vulnerable package fails the build. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Each project commits a packages.lock.json; CI fails a restore that would change it. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' != ''">true</RestoreLockedMode>
  </PropertyGroup>

  <!-- Building against the kit's source (-p:UseKitSource=true, see AGENTS.md) changes the dependency graph, so the lock file moves to obj (ignored by git) and is not enforced, so the committed ones stay untouched; CI never sets it. -->
  <PropertyGroup>
    <KitPath Condition="'$(KitPath)' == ''">../app-ui-kit</KitPath>
    <!-- KitPath may be a command-line value, which props cannot change, so the resolved folder is a separate property: a relative KitPath is taken from this folder, an absolute one is kept. -->
    <KitSourcePath>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '$(KitPath)'))))</KitSourcePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseKitSource)' == 'true'">
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/obj/kit-source.packages.lock.json</NuGetLockFilePath>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

  <!-- The Shields UI kit is referenced directly by every project that uses it, however it reaches them (a project reference also brings it in). Dependabot rewrites a package's lock file only in projects that reference it directly, so a transitive entry left the App and Stories.Host lock files stale and locked restore failed. Versions are in Directory.Packages.props. -p:UseKitSource=true builds against the kit's source at KitPath instead of the packages. -->
  <PropertyGroup>
    <UsesKitUI Condition="'$(MSBuildProjectName)' == 'WorkoutLog.App' Or '$(MSBuildProjectName)' == 'WorkoutLog.UI' Or '$(MSBuildProjectName)' == 'WorkoutLog.UI.Stories' Or '$(MSBuildProjectName)' == 'WorkoutLog.UI.Stories.Host' Or '$(MSBuildProjectName)' == 'WorkoutLog.UI.Tests'">true</UsesKitUI>
    <UsesKitStories Condition="'$(MSBuildProjectName)' == 'WorkoutLog.UI.Stories' Or '$(MSBuildProjectName)' == 'WorkoutLog.UI.Stories.Host' Or '$(MSBuildProjectName)' == 'WorkoutLog.UI.Tests'">true</UsesKitStories>
    <UsesKitTesting Condition="'$(MSBuildProjectName)' == 'WorkoutLog.UI.Tests'">true</UsesKitTesting>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseKitSource)' != 'true'">
    <PackageReference Include="Shields.UI" Condition="'$(UsesKitUI)' == 'true'" />
    <PackageReference Include="Shields.UI.Stories" Condition="'$(UsesKitStories)' == 'true'" />
    <PackageReference Include="Shields.UI.Testing" Condition="'$(UsesKitTesting)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseKitSource)' == 'true'">
    <ProjectReference Include="$(KitSourcePath)/src/Shields.UI/Shields.UI.csproj" Condition="'$(UsesKitUI)' == 'true'" />
    <ProjectReference Include="$(KitSourcePath)/src/Shields.UI.Stories/Shields.UI.Stories.csproj" Condition="'$(UsesKitStories)' == 'true'" />
    <ProjectReference Include="$(KitSourcePath)/src/Shields.UI.Testing/Shields.UI.Testing.csproj" Condition="'$(UsesKitTesting)' == 'true'" />
  </ItemGroup>

  <!-- Test projects (*.Tests): NUnit. -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" />
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
