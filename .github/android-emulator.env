# The emulator and system image the CI emulator jobs run, and the cache that holds them (emulator-sdk.sh,
# docs/dev-setup-build.md, CI). Bump a version when the Emulator cache workflow says sdkmanager's stable channel
# moved; bump CACHE_VERSION to rebuild the cache with the same versions.
SYSTEM_IMAGE='system-images;android-36;default;x86_64'
SYSTEM_IMAGE_REVISION=2
EMULATOR_VERSION=37.2.13
CACHE_VERSION=1
